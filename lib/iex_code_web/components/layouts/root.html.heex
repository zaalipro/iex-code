<% appearance = appearance_preferences() %> <!DOCTYPE html>
<html
  lang="en"
  data-ui-theme={appearance.ui_theme}
  data-theme={IexCodeWeb.Appearance.color_scheme(appearance)}
  data-depth-shadows={to_string(appearance.shadows_3d)}
  data-depth-effects={to_string(appearance.effects_3d)}
  data-density={appearance.layout_density}
  style={"color-scheme: #{IexCodeWeb.Appearance.color_scheme(appearance)};"}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#0a0d12" />
    <meta
      name="description"
      content="IexCode is a durable, native-workspace asynchronous coding harness."
    />
    <.live_title default="IexCode" suffix=" · Async coding harness" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" href={~p"/favicon.ico"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
