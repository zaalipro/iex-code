<Layouts.app flash={@flash}>
  <main
    id="settings-page"
    class="orbital-settings settings-page min-h-dvh overflow-x-hidden bg-canvas text-content"
  >
    <.page_toolbar
      id="settings-navigation"
      title="Settings"
      heading_tag="h1"
      class="settings-masthead"
    >
      <:leading>
        <.link
          id="settings-return-workspace"
          navigate={@return_path}
          data-settings-navigation
          data-unsaved-confirm={
            @settings_status in [:dirty, :error] &&
              "Discard your unsaved settings and return to the workspace?"
          }
          class="header-control"
        >
          <.icon name="hero-arrow-left" class="h-4 w-4" />
          <span>Workspace</span>
        </.link>
      </:leading>
      <:actions>
        <details id="settings-scope-summary" class="settings-scope-details">
          <summary aria-labelledby="settings-scope-title" class="header-control">
            <.icon name="hero-computer-desktop" class="h-4 w-4" />
            <span id="settings-scope-title">Global defaults</span>
            <.icon name="hero-chevron-down" class="h-3 w-3" />
          </summary>
          <div class="settings-scope-popover">
            <p>Saved on this Mac and shared by every workspace.</p>
            <p>
              Global defaults seed newly launched work. Existing sessions retain only their
              session-level provider, model, and temperature overrides.
            </p>
            <div
              :if={@context_session}
              id="settings-session-context"
              class="settings-context-note"
            >
              <span>Returning to</span>
              <strong>{@context_session.title}</strong>
              <span>{@context_session.model_provider} · {@context_session.model_name}</span>
            </div>
          </div>
        </details>
      </:actions>
    </.page_toolbar>

    <div class="settings-shell">
      <aside class="settings-sidebar">
        <div class="settings-nav-identity">
          <span class="settings-nav-insignia" aria-hidden="true">
            <.icon name="hero-adjustments-horizontal" class="h-4 w-4" />
          </span>
          <div>
            <strong>Preferences</strong>
            <span>Your workspace, configured</span>
          </div>
        </div>
        <nav id="settings-studio-tabs" aria-label="Settings categories">
          <div id="settings-section-nav" class="settings-category-list">
            <div
              :for={{id, label, icon} <- @studio_tabs}
              class={["settings-category", to_string(@active_tab) == id && "is-active"]}
            >
              <.link
                id={"tab-link-#{id}"}
                patch={tab_path(@context_session, id)}
                aria-current={if(to_string(@active_tab) == id, do: "page", else: nil)}
                class="settings-category-link"
              >
                <.icon name={icon} class="h-4 w-4 shrink-0" />
                <span>{label}</span>
              </.link>
              <div class="settings-category-sections">
                <.link
                  :for={{section_id, section_label} <- settings_sections(id)}
                  id={"settings-nav-#{section_id}"}
                  patch={section_path(@context_session, section_id)}
                  class="settings-section-link"
                >
                  {section_label}
                </.link>
              </div>
            </div>
          </div>
        </nav>
        <div class="settings-sidebar-note">
          <.icon name="hero-computer-desktop" class="h-4 w-4" />
          <strong>Stored on this Mac</strong>
          <p>Changes apply to new work. Your sessions keep their overrides.</p>
        </div>
      </aside>

      <div class="settings-main">
        <.page_header
          id="settings-category-header"
          class="settings-category-header page-header--flush"
          icon={tab_icon(@active_tab)}
          title={tab_title(@active_tab)}
          description={tab_description(@active_tab)}
        />
        <.form
          for={@settings_form}
          id="settings-form"
          phx-change="validate_settings"
          phx-submit="save_settings"
          class="settings-preferences-form"
        >
          <div id="settings-scroll-region" class="settings-scroll-region">
            <div
              :if={@invalid_session_context?}
              id="settings-session-context-error"
              role="status"
              class="mb-6 flex items-start gap-3 border border-amber-400/30 bg-amber-400/[0.06] p-4 text-sm text-amber-100"
            >
              <.icon name="hero-information-circle" class="mt-0.5 h-5 w-5 shrink-0" />
              <span>The requested session is unavailable. Showing safe global settings instead.</span>
            </div>

            <div
              :if={@external_update?}
              id="settings-external-update"
              role="alert"
              class="mb-6 flex flex-col gap-3 border border-amber-400/30 bg-amber-400/[0.06] p-4 text-sm text-amber-100 sm:flex-row sm:items-center sm:justify-between"
            >
              <span>Settings changed elsewhere while you were editing. Discard to load the newer version.</span>
              <button
                type="button"
                phx-click="discard_settings"
                class="settings-text-action text-amber-200"
              >
                Load saved version
              </button>
            </div>

            <div
              :if={@settings_status == :error}
              id="settings-error-summary"
              role="alert"
              tabindex="-1"
              class="mb-6 border border-rose-400/35 bg-rose-400/[0.06] p-4"
            >
              <div class="flex items-start gap-3">
                <.icon
                  name="hero-exclamation-triangle"
                  class="mt-0.5 h-5 w-5 shrink-0 text-rose-300"
                />
                <div>
                  <h2 class="text-sm font-semibold text-rose-100">Settings were not saved</h2>
                  <p class="mt-1 text-sm leading-5 text-rose-200/80">{@settings_message}</p>
                  <p
                    :if={form_error_count(@settings_form) > 0}
                    class="mt-2 font-mono text-xs text-rose-300"
                  >
                    {form_error_count(@settings_form)} field {if form_error_count(@settings_form) ==
                                                                   1,
                                                                 do: "needs",
                                                                 else: "fields need"} attention.
                  </p>
                </div>
              </div>
            </div>

            <input
              id="settings-provider-order"
              type="hidden"
              name="settings[search_provider_order]"
              value={Enum.join(provider_order(@settings_form, @settings), ",")}
            />

            <div
              id="tab-panel-providers"
              class={[@active_tab != :providers && "hidden", "settings-tab-panel"]}
            >
              <section
                id="models"
                aria-labelledby="models-title"
                class="settings-section-card scroll-mt-24"
              >
                <.settings_section_header
                  id="models-title"
                  eyebrow="Models"
                  title="Model defaults"
                  description="New sessions use these defaults. The selected provider is authoritative; model identifiers are passed through unchanged. Blank secret fields preserve the saved value."
                />

                <div class="settings-fields">
                  <.input
                    field={@settings_form[:default_model_provider]}
                    id="settings-default-model-provider"
                    type="select"
                    label="Default API protocol"
                    options={[
                      "OpenAI or compatible": "openai",
                      Anthropic: "anthropic",
                      "Ollama (Local)": "ollama",
                      "LM Studio (Local)": "lm_studio",
                      "llama.cpp (Local)": "llama_cpp"
                    ]}
                    class="settings-control"
                    error_class="settings-control-error"
                  />
                  <.input
                    field={@settings_form[:default_model]}
                    id="settings-default-model"
                    type="text"
                    label="Default model identifier"
                    maxlength="240"
                    autocomplete="off"
                    class="settings-control font-mono"
                    error_class="settings-control-error"
                  />
                </div>

                <div class="settings-credentials-grid">
                  <article id="settings-openai-card" class="settings-credential-card">
                    <div class="flex items-start justify-between gap-4">
                      <div>
                        <h3 class="text-base font-semibold text-content">
                          OpenAI / compatible endpoint
                        </h3>
                        <p class="mt-1 text-sm text-muted">
                          Used whenever OpenAI or compatible is selected, including proxy-hosted models.
                        </p>
                      </div>
                      <.credential_badge configured={
                        credential_configured?(@settings.openai_api_key)
                      } />
                    </div>
                    <div class="mt-4 space-y-3">
                      <.input
                        name="settings[openai_api_key]"
                        id="settings-openai-api-key"
                        type="password"
                        value=""
                        label="API key"
                        autocomplete="new-password"
                        placeholder={credential_placeholder(@settings.openai_api_key)}
                        class="settings-control font-mono"
                      />
                      <.input
                        field={@settings_form[:openai_base_url]}
                        id="settings-openai-base-url"
                        type="url"
                        label="Base URL"
                        class="settings-control font-mono"
                        error_class="settings-control-error"
                      />
                    </div>
                    <button
                      :if={credential_configured?(@settings.openai_api_key)}
                      id="settings-clear-openai"
                      type="button"
                      phx-click="clear_credential"
                      phx-value-credential="openai"
                      data-confirm="Remove the saved OpenAI credential immediately? Other unsaved form edits will remain available to save."
                      class="settings-danger-action mt-2"
                    >
                      Remove credential
                    </button>
                  </article>

                  <article id="settings-anthropic-card" class="settings-credential-card">
                    <div class="flex items-start justify-between gap-4">
                      <div>
                        <h3 class="text-base font-semibold text-content">Anthropic</h3>
                        <p class="mt-1 text-sm text-muted">
                          Used whenever Anthropic is explicitly selected.
                        </p>
                      </div>
                      <.credential_badge configured={
                        credential_configured?(@settings.anthropic_api_key)
                      } />
                    </div>
                    <div class="mt-4 space-y-3">
                      <.input
                        name="settings[anthropic_api_key]"
                        id="settings-anthropic-api-key"
                        type="password"
                        value=""
                        label="API key"
                        autocomplete="new-password"
                        placeholder={credential_placeholder(@settings.anthropic_api_key)}
                        class="settings-control font-mono"
                      />
                      <.input
                        field={@settings_form[:anthropic_base_url]}
                        id="settings-anthropic-base-url"
                        type="url"
                        label="Base URL"
                        class="settings-control font-mono"
                        error_class="settings-control-error"
                      />
                    </div>
                    <button
                      :if={credential_configured?(@settings.anthropic_api_key)}
                      id="settings-clear-anthropic"
                      type="button"
                      phx-click="clear_credential"
                      phx-value-credential="anthropic"
                      data-confirm="Remove the saved Anthropic credential immediately? Other unsaved form edits will remain available to save."
                      class="settings-danger-action mt-2"
                    >
                      Remove credential
                    </button>
                  </article>
                </div>

                <div class="settings-fields mt-5">
                  <.input
                    field={@settings_form[:temperature]}
                    id="settings-temperature"
                    type="number"
                    label="Default temperature"
                    min="0"
                    max="2"
                    step="0.05"
                    class="settings-control"
                    error_class="settings-control-error"
                  />
                  <.input
                    field={@settings_form[:max_tokens]}
                    id="settings-max-tokens"
                    type="number"
                    label="Maximum output tokens"
                    min="1"
                    max="128000"
                    class="settings-control"
                    error_class="settings-control-error"
                  />
                </div>

                <%!-- Local models Section --%>
                <div id="settings-local-llm-section" class="mt-6 border-t border-line pt-5">
                  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
                    <div>
                      <h3 class="text-base font-semibold text-content flex items-center gap-2">
                        <.icon name="hero-cpu-chip" class="w-5 h-5 text-emerald-400" />
                        <span>Local models</span>
                      </h3>
                      <p class="mt-0.5 text-xs text-muted">
                        Discover models running on this machine. No API key required.
                      </p>
                    </div>
                    <button
                      type="button"
                      id="settings-rescan-local-models-btn"
                      phx-click="rescan_local_models"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium bg-raised hover:bg-raised text-content border border-line transition-smooth cursor-pointer"
                    >
                      <.icon
                        name="hero-arrow-path"
                        class={["w-3.5 h-3.5", @scanning_local_models? && "animate-spin"]}
                      />
                      <span>Scan again</span>
                    </button>
                  </div>

                  <div class="grid gap-3 sm:grid-cols-3">
                    <%= for server <- @local_servers_status do %>
                      <div
                        id={"settings-server-card-#{server.provider}"}
                        class="bg-inset border border-line rounded-xl p-3 flex flex-col justify-between"
                      >
                        <div>
                          <div class="flex items-center justify-between mb-1.5">
                            <span class="text-xs font-semibold text-content">{server.name}</span>
                            <%= if server.online do %>
                              <span class="inline-flex items-center gap-1 text-[10px] font-mono text-emerald-400 bg-emerald-950/60 border border-emerald-800/40 px-1.5 py-0.5 rounded-full">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                Online
                              </span>
                            <% else %>
                              <span class="inline-flex items-center gap-1 text-[10px] font-mono text-subtle bg-gray-900 border border-gray-800 px-1.5 py-0.5 rounded-full">
                                <span class="w-1.5 h-1.5 rounded-full bg-gray-600"></span> Offline
                              </span>
                            <% end %>
                          </div>

                          <div class="text-[11px] text-muted font-mono space-y-0.5">
                            <div>Port: <span class="text-muted">:{server.port}</span></div>
                            <div>
                              Models:
                              <span class={
                                if server.online,
                                  do: "text-emerald-300 font-semibold",
                                  else: "text-subtle"
                              }>
                                {length(server.models)}
                              </span>
                            </div>
                            <%= if server.latency_ms do %>
                              <div>
                                Latency: <span class="text-muted">{server.latency_ms}ms</span>
                              </div>
                            <% end %>
                            <%= if server.version do %>
                              <div>
                                Version: <span class="text-muted">{server.version}</span>
                              </div>
                            <% end %>
                          </div>
                        </div>

                        <%= if server.models != [] do %>
                          <div class="mt-2.5 pt-2 border-t border-line space-y-1">
                            <div class="text-[10px] text-muted">
                              Models:
                            </div>
                            <%= for m <- Enum.take(server.models, 3) do %>
                              <button
                                type="button"
                                phx-click="use_local_model"
                                phx-value-provider={server.provider}
                                phx-value-model={m.id}
                                title={"Set #{m.name} as default model"}
                                class="w-full text-left truncate text-[11px] px-2 py-1 rounded bg-inset hover:bg-raised text-muted hover:text-content transition-smooth flex items-center justify-between"
                              >
                                <span class="truncate">{m.name}</span>
                                <span class="text-[9px] text-emerald-400 font-mono ml-1 shrink-0">Use</span>
                              </button>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </section>

              <%!-- Provider Diagnostics & Live Ping Card --%>
              <section id="provider-diagnostics" class="settings-section-card">
                <.settings_section_header
                  id="provider-diagnostics-title"
                  eyebrow="Diagnostics"
                  title="Connection tests"
                  description="Check saved endpoints for availability, latency, and discovered models."
                />

                <div class="settings-connection-list">
                  <%= for {provider, name, icon, endpoint} <- [
                {"openai", "OpenAI / Compatible", "hero-cpu-chip", @settings.openai_base_url || "https://cli.llmotions.com/v1"},
                {"anthropic", "Anthropic Claude", "hero-sparkles", @settings.anthropic_base_url || "https://api.anthropic.com"},
                {"gemini", "Google Gemini", "hero-globe-alt", "https://generativelanguage.googleapis.com"},
                {"ollama", "Ollama (Local)", "hero-command-line", "http://localhost:11434/v1"},
                {"lm_studio", "LM Studio (Local)", "hero-computer-desktop", "http://localhost:1234/v1"},
                {"llama_cpp", "llama.cpp (Local)", "hero-server", "http://localhost:8080/v1"}
              ] do %>
                    <% ping_res = Map.get(@provider_latencies, provider)
                    status = Map.get(@provider_statuses, provider, :idle) %>
                    <div
                      id={"provider-card-#{provider}"}
                      class="settings-connection-row"
                    >
                      <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-3">
                          <div class="flex items-center gap-2">
                            <.icon name={icon} class="h-4 w-4 text-accent" />
                            <span class="text-sm font-semibold text-content">{name}</span>
                          </div>
                          <span
                            id={"ping-badge-#{provider}"}
                            class={[
                              "inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 text-[10px] font-medium border",
                              case status do
                                :online ->
                                  "border-emerald-500/40 bg-emerald-500/10 text-emerald-300"

                                :degraded ->
                                  "border-amber-500/40 bg-amber-500/10 text-amber-300"

                                :offline ->
                                  "border-rose-500/40 bg-rose-500/10 text-rose-300"

                                _ ->
                                  "border-line bg-inset text-muted"
                              end
                            ]}
                          >
                            <%= if status == :online do %>
                              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                              {ping_res.latency_ms}ms
                            <% else %>
                              <%= if status == :degraded do %>
                                <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
                                {ping_res.latency_ms}ms
                              <% else %>
                                <%= if status == :offline do %>
                                  <span class="h-1.5 w-1.5 rounded-full bg-rose-400"></span>
                                  Offline
                                <% else %>
                                  <span class="h-1.5 w-1.5 rounded-full bg-gray-500"></span> Ready
                                <% end %>
                              <% end %>
                            <% end %>
                          </span>
                        </div>
                        <p class="mt-1 font-mono text-[11px] text-muted truncate">{endpoint}</p>
                        <%= if ping_res && ping_res[:model_count] && ping_res[:model_count] > 0 do %>
                          <p class="mt-1 font-mono text-[10px] text-accent">
                            {ping_res.model_count} models discovered
                          </p>
                        <% end %>
                      </div>

                      <button
                        type="button"
                        id={"ping-btn-#{provider}"}
                        phx-click="ping_provider"
                        phx-value-provider={provider}
                        phx-disable-with="Testing…"
                        class="settings-connection-test"
                      >
                        <.icon name="hero-bolt" class="h-3.5 w-3.5 text-accent" />
                        <span>Test connection</span>
                      </button>
                    </div>
                  <% end %>
                </div>
              </section>

              <section
                id="providers"
                aria-labelledby="providers-title"
                class="settings-section-card settings-section-card-research scroll-mt-24"
              >
                <.settings_section_header
                  id="providers-title"
                  eyebrow="Providers"
                  title="Federated search order"
                  description="Enabled providers are tried in this order. Status reflects the current form configuration, not a live connectivity test. Retired adapters stay visible for compatibility but cannot enter new automatic runs."
                  tone="research"
                />
                <label for="settings-provider-filter" class="sr-only">Filter research providers</label>
                <div class="relative mb-4">
                  <.icon
                    name="hero-magnifying-glass"
                    class="pointer-events-none absolute left-3 top-3.5 h-4 w-4 text-subtle"
                  />
                  <input
                    id="settings-provider-filter"
                    name="provider_filter"
                    type="search"
                    value={@provider_filter}
                    placeholder="Filter providers by name, lifecycle, or capability"
                    phx-change="filter_providers"
                    phx-debounce="200"
                    class="settings-control w-full pl-10"
                  />
                </div>

                <div id="settings-search-providers" class="space-y-2">
                  <article
                    :for={
                      descriptor <-
                        filtered_descriptors(@search_provider_descriptors, @provider_filter)
                    }
                    id={"settings-search-provider-#{provider_id(descriptor)}"}
                    data-provider-lifecycle={descriptor.lifecycle}
                    class="settings-provider-row"
                  >
                    <% provider = provider_id(descriptor) %>
                    <% config = provider_config(@settings_form, @settings, provider) %>
                    <% {status_label, status_tone} = provider_status(descriptor, config) %>
                    <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
                      <div class="flex min-w-0 flex-1 items-start gap-3">
                        <div class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center border border-line bg-inset font-mono text-xs font-bold text-muted">
                          {provider |> String.first() |> String.upcase()}
                        </div>
                        <div class="min-w-0">
                          <div class="flex flex-wrap items-center gap-2">
                            <h3 class="text-sm font-semibold text-content">
                              {provider_name(descriptor)}
                            </h3>
                            <span
                              id={"settings-provider-status-#{provider}"}
                              data-tone={status_tone}
                              class="settings-provider-status"
                            >
                              {status_label}
                            </span>
                            <span class="text-[11px] font-medium text-muted">
                              {descriptor.lifecycle}
                            </span>
                          </div>
                          <p class="mt-1 text-sm leading-5 text-muted">
                            {Enum.map_join(
                              descriptor.capabilities,
                              " · ",
                              &(&1 |> Atom.to_string() |> String.replace("_", " "))
                            )}
                          </p>
                          <p
                            :if={provider_lifecycle_note(descriptor)}
                            class="mt-1 text-xs leading-5 text-subtle"
                          >
                            {provider_lifecycle_note(descriptor)}
                          </p>
                        </div>
                      </div>

                      <div class="flex flex-wrap items-center gap-2 sm:justify-end">
                        <input
                          type="hidden"
                          name={"settings[search_providers][#{provider}][enabled]"}
                          value="false"
                        />
                        <label
                          for={"settings-provider-enabled-#{provider}"}
                          class="settings-provider-toggle"
                        >
                          <input
                            id={"settings-provider-enabled-#{provider}"}
                            type="checkbox"
                            name={"settings[search_providers][#{provider}][enabled]"}
                            value="true"
                            checked={provider_enabled?(config)}
                            disabled={descriptor.lifecycle == :retired}
                            class="h-4 w-4 accent-violet-400"
                          /> Enabled
                        </label>
                        <div
                          class="flex"
                          role="group"
                          aria-label={"Move #{provider_name(descriptor)} in provider order"}
                        >
                          <button
                            id={"settings-provider-move-up-#{provider}"}
                            type="button"
                            phx-click="move_provider"
                            phx-value-provider={provider}
                            phx-value-direction="up"
                            disabled={first_provider?(@settings_form, @settings, provider)}
                            aria-label={"Move #{provider_name(descriptor)} up"}
                            class="settings-icon-action"
                          ><.icon name="hero-arrow-up" class="h-4 w-4" /></button>
                          <button
                            id={"settings-provider-move-down-#{provider}"}
                            type="button"
                            phx-click="move_provider"
                            phx-value-provider={provider}
                            phx-value-direction="down"
                            disabled={last_provider?(@settings_form, @settings, provider)}
                            aria-label={"Move #{provider_name(descriptor)} down"}
                            class="settings-icon-action -ml-px"
                          ><.icon name="hero-arrow-down" class="h-4 w-4" /></button>
                        </div>
                        <button
                          id={"settings-provider-advanced-#{provider}"}
                          type="button"
                          phx-click="toggle_provider_advanced"
                          phx-value-provider={provider}
                          aria-expanded={MapSet.member?(@expanded_providers, provider)}
                          aria-controls={"settings-provider-panel-#{provider}"}
                          aria-label={"Configure #{provider_name(descriptor)}"}
                          class="settings-secondary-action"
                        >
                          Configure <.icon name="hero-chevron-down" class="h-3.5 w-3.5" />
                        </button>
                      </div>
                    </div>

                    <div
                      :if={MapSet.member?(@expanded_providers, provider)}
                      id={"settings-provider-panel-#{provider}"}
                      class="mt-4 grid gap-4 border-t border-line pt-4 sm:grid-cols-2"
                    >
                      <div :if={:api_key in descriptor.config_fields}>
                        <.input
                          name={"settings[search_providers][#{provider}][api_key]"}
                          id={"settings-provider-key-#{provider}"}
                          type="password"
                          value=""
                          label={descriptor.auth_label}
                          autocomplete="new-password"
                          placeholder={credential_placeholder(config["api_key"])}
                          class="settings-control font-mono"
                        />
                        <button
                          :if={credential_configured?(config["api_key"])}
                          id={"settings-provider-clear-#{provider}"}
                          type="button"
                          phx-click="clear_credential"
                          phx-value-credential={"provider:#{provider}"}
                          data-confirm={"Remove the saved #{provider_name(descriptor)} credential immediately? Other unsaved form edits will remain available to save."}
                          class="settings-danger-action"
                        >Remove credential</button>
                      </div>
                      <.input
                        :if={:base_url in descriptor.config_fields}
                        name={"settings[search_providers][#{provider}][base_url]"}
                        id={"settings-provider-url-#{provider}"}
                        type="url"
                        label={
                          if descriptor.id == :searxng,
                            do: "Instance URL",
                            else: "Official endpoint"
                        }
                        value={config["base_url"] || ""}
                        readonly={descriptor.id != :searxng}
                        class="settings-control font-mono read-only:cursor-not-allowed read-only:text-subtle"
                      />
                      <.input
                        :if={descriptor.id == :google}
                        name="settings[search_providers][google][engine_id]"
                        id="settings-provider-engine-google"
                        type="text"
                        label="Search engine ID"
                        value={config["engine_id"] || ""}
                        class="settings-control font-mono"
                      />
                      <.input
                        :if={descriptor.id == :serpapi}
                        name="settings[search_providers][serpapi][engine]"
                        id="settings-provider-engine-serpapi"
                        type="select"
                        label="Search engine"
                        value={config["engine"] || "google"}
                        options={
                          Enum.map(
                            ~w(google bing duckduckgo baidu yahoo yandex),
                            &{String.capitalize(&1), &1}
                          )
                        }
                        class="settings-control font-mono"
                      />
                    </div>
                  </article>

                  <div
                    :if={
                      filtered_descriptors(@search_provider_descriptors, @provider_filter) == []
                    }
                    id="settings-provider-filter-empty"
                    class="settings-empty-state"
                  >
                    No providers match this filter.
                  </div>
                </div>
              </section>

              <section
                id="runtime"
                aria-labelledby="runtime-title"
                class="settings-section-card scroll-mt-24"
              >
                <.settings_section_header
                  id="runtime-title"
                  eyebrow="Runtime"
                  title="Operational facts"
                  description="Read-only state from the local OTP runtime. Service capacity and security boundaries are not editable browser preferences."
                />
                <div class="divide-y divide-line border-y border-line">
                  <article
                    :for={fact <- @runtime_facts}
                    id={"settings-runtime-#{fact.id}"}
                    class="grid gap-2 py-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:gap-6"
                  >
                    <div>
                      <h3 class="text-sm font-semibold text-content">{fact.label}</h3><p class="mt-1 text-sm leading-5 text-subtle">
                        {fact.note}
                      </p>
                    </div>
                    <span data-tone={fact.tone} class="settings-runtime-value">{fact.value}</span>
                  </article>
                </div>
                <div class="mt-4 flex items-start gap-2 text-xs leading-5 text-subtle">
                  <.icon name="hero-information-circle" class="mt-0.5 h-4 w-4 shrink-0" />
                  Changes to process-level concurrency, shell adapters, or network policy require a runtime restart and remain configuration-file settings.
                </div>
              </section>
            </div>

            <div
              id="tab-panel-reasoning"
              class={[@active_tab != :reasoning && "hidden", "settings-tab-panel"]}
            >
              <section id="reasoning-profiles" class="settings-section-card">
                <.settings_section_header
                  id="reasoning-profiles-title"
                  eyebrow="Reasoning"
                  title="Thinking defaults"
                  description="Choose a default effort and thinking budget. Each provider receives the parameters it supports."
                />

                <div class="settings-fields">
                  <div>
                    <.input
                      field={@settings_form[:default_reasoning_effort]}
                      id="settings-default-reasoning-effort"
                      type="select"
                      label="Default reasoning effort"
                      options={[
                        "None (Disabled)": "none",
                        "Low Effort": "low",
                        "Medium Effort": "medium",
                        "High Effort": "high",
                        "Max Effort": "max"
                      ]}
                      class="settings-control"
                      error_class="settings-control-error"
                    />
                    <p class="mt-1.5 text-xs text-muted">
                      Passed to OpenAI reasoning models (o1, o3, o3-mini) and maps to thinking intensity on Gemini and Claude 3.7.
                    </p>
                  </div>

                  <div>
                    <.input
                      field={@settings_form[:default_thinking_budget]}
                      id="settings-default-thinking-budget"
                      type="number"
                      label="Default thinking token budget"
                      min="1024"
                      max="128000"
                      step="1024"
                      class="settings-control font-mono"
                      error_class="settings-control-error"
                    />
                    <p class="mt-1.5 text-xs text-muted">
                      Defines the maximum token budget allocated for internal chain-of-thought on Anthropic Claude 3.7 and Gemini Flash Thinking.
                    </p>
                  </div>
                </div>
              </section>

              <%!-- Per-Model Overrides Matrix Card --%>
              <section id="model-overrides-card" class="settings-section-card">
                <.settings_section_header
                  id="model-overrides-title"
                  eyebrow="Overrides Matrix"
                  title="Model overrides"
                  description="Define granular overrides for specific models. When configured, these values take precedence over global defaults."
                />

                <div class="space-y-4">
                  <%!-- Configured Overrides List --%>
                  <div
                    id="configured-model-overrides"
                    class="rounded-xl border border-white/5 bg-inset overflow-hidden"
                  >
                    <table class="w-full text-left text-xs text-muted">
                      <thead class="border-b border-white/5 bg-white/[0.02] text-[10px] font-medium text-muted">
                        <tr>
                          <th class="px-4 py-2.5">Model ID</th>
                          <th class="px-4 py-2.5">Effort</th>
                          <th class="px-4 py-2.5">Budget</th>
                          <th class="px-4 py-2.5">Max Tokens</th>
                          <th class="px-4 py-2.5">Temperature</th>
                          <th class="px-4 py-2.5 text-right">Actions</th>
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-white/5 font-mono">
                        <%= if is_map(@settings.model_overrides) and map_size(@settings.model_overrides) > 0 do %>
                          <%= for {m_name, config} <- @settings.model_overrides do %>
                            <tr id={"override-row-#{m_name}"} class="hover:bg-white/[0.02]">
                              <td class="px-4 py-2 font-semibold text-content">{m_name}</td>
                              <td class="px-4 py-2 text-cyan-300">
                                {Map.get(config, "reasoning_effort", "—")}
                              </td>
                              <td class="px-4 py-2 text-violet-300">
                                {Map.get(config, "budget_tokens", "—")}
                              </td>
                              <td class="px-4 py-2 text-muted">
                                {Map.get(config, "max_tokens", "—")}
                              </td>
                              <td class="px-4 py-2 text-muted">
                                {Map.get(config, "temperature", "—")}
                              </td>
                              <td class="px-4 py-2 text-right">
                                <button
                                  type="button"
                                  phx-click="delete_model_override"
                                  phx-value-model={m_name}
                                  class="text-rose-400 hover:text-rose-300 transition-colors font-sans text-xs cursor-pointer"
                                >
                                  Delete
                                </button>
                              </td>
                            </tr>
                          <% end %>
                        <% else %>
                          <tr>
                            <td colspan="6" class="px-4 py-4 text-center text-subtle font-sans">
                              No model-specific overrides configured yet. Global defaults apply to all reasoning models.
                            </td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </section>

              <%!-- Live Payload inspector Component --%>
              <section id="payload-inspector-card" class="settings-section-card">
                <.settings_section_header
                  id="payload-inspector-title"
                  eyebrow="Live Diagnostic"
                  title="Payload inspector"
                  description="Inspect the exact native JSON payload generated for any model based on active settings. Verify temperature omission for OpenAI reasoning models, clamped temperature 1.0 for Anthropic extended thinking, and custom token ceilings."
                />

                <div class="space-y-4">
                  <div class="flex flex-wrap items-center gap-2 pb-2">
                    <span class="text-xs font-semibold text-muted">Sample Models:</span>
                    <button
                      type="button"
                      id="preview-btn-o3-mini"
                      phx-click="update_preview_model"
                      phx-value-provider="openai"
                      phx-value-model="o3-mini"
                      class={[
                        "rounded-lg px-2.5 py-1 text-xs font-mono font-medium border transition-colors cursor-pointer",
                        if(@preview_model == "o3-mini",
                          do: "border-cyan-500 bg-cyan-500/20 text-cyan-300",
                          else: "border-white/10 bg-white/5 text-muted hover:text-content"
                        )
                      ]}
                    >
                      o3-mini
                    </button>
                    <button
                      type="button"
                      id="preview-btn-o1"
                      phx-click="update_preview_model"
                      phx-value-provider="openai"
                      phx-value-model="o1"
                      class={[
                        "rounded-lg px-2.5 py-1 text-xs font-mono font-medium border transition-colors cursor-pointer",
                        if(@preview_model == "o1",
                          do: "border-cyan-500 bg-cyan-500/20 text-cyan-300",
                          else: "border-white/10 bg-white/5 text-muted hover:text-content"
                        )
                      ]}
                    >
                      o1
                    </button>
                    <button
                      type="button"
                      id="preview-btn-claude"
                      phx-click="update_preview_model"
                      phx-value-provider="anthropic"
                      phx-value-model="claude-3-7-sonnet-20250219"
                      class={[
                        "rounded-lg px-2.5 py-1 text-xs font-mono font-medium border transition-colors cursor-pointer",
                        if(String.contains?(@preview_model, "claude-3-7"),
                          do: "border-violet-500 bg-violet-500/20 text-violet-300",
                          else: "border-white/10 bg-white/5 text-muted hover:text-content"
                        )
                      ]}
                    >
                      Claude 3.7 Sonnet
                    </button>
                    <button
                      type="button"
                      id="preview-btn-gemini"
                      phx-click="update_preview_model"
                      phx-value-provider="gemini"
                      phx-value-model="gemini-2.0-flash-thinking-exp"
                      class={[
                        "rounded-lg px-2.5 py-1 text-xs font-mono font-medium border transition-colors cursor-pointer",
                        if(String.contains?(@preview_model, "gemini"),
                          do: "border-amber-500 bg-amber-500/20 text-amber-300",
                          else: "border-white/10 bg-white/5 text-muted hover:text-content"
                        )
                      ]}
                    >
                      Gemini Flash Thinking
                    </button>
                    <button
                      type="button"
                      id="preview-btn-deepseek"
                      phx-click="update_preview_model"
                      phx-value-provider="ollama"
                      phx-value-model="deepseek-r1:14b"
                      class={[
                        "rounded-lg px-2.5 py-1 text-xs font-mono font-medium border transition-colors cursor-pointer",
                        if(String.contains?(@preview_model, "deepseek"),
                          do: "border-emerald-500 bg-emerald-500/20 text-emerald-300",
                          else: "border-white/10 bg-white/5 text-muted hover:text-content"
                        )
                      ]}
                    >
                      DeepSeek R1
                    </button>
                  </div>

                  <IexCodeWeb.Components.PayloadPreviewer.payload_previewer
                    provider={@preview_provider}
                    model={@preview_model}
                    settings={@settings}
                    reasoning_effort={@preview_reasoning_effort}
                    thinking_budget={@preview_thinking_budget}
                  />
                </div>
              </section>
            </div>

            <div
              id="tab-panel-safety"
              class={[@active_tab != :safety && "hidden", "settings-tab-panel"]}
            >
              <section id="safety-policy-card" class="settings-section-card">
                <.settings_section_header
                  id="safety-policy-title"
                  eyebrow="Autonomous Safety"
                  title="Approvals & sandbox"
                  description="Set when agents ask for approval and the environment available to their tools."
                />

                <div class="settings-fields">
                  <div>
                    <.input
                      field={@settings_form[:tool_approval_mode]}
                      id="settings-tool-approval-mode"
                      type="select"
                      label="Global tool approval mode"
                      options={[
                        "Prompt Dangerous (Recommended)": "prompt_dangerous",
                        "Full Autonomous (No Prompts)": "full_auto",
                        "Read Only (Strictly Disallow Mutations)": "read_only"
                      ]}
                      class="settings-control"
                      error_class="settings-control-error"
                    />
                    <p class="mt-1.5 text-xs text-muted">
                      In Read Only mode, mutating tools (shell commands, file writes, git push) are denied immediately before category overrides.
                    </p>
                  </div>

                  <div>
                    <.input
                      field={@settings_form[:sandbox_mode]}
                      id="settings-sandbox-mode"
                      type="select"
                      label="Execution sandbox mode"
                      options={[
                        "Inherit Filtered Environment": "inherit_filtered",
                        "Isolated Subshell (Strict)": "isolated",
                        Passthrough: "passthrough"
                      ]}
                      class="settings-control"
                      error_class="settings-control-error"
                    />
                    <p class="mt-1.5 text-xs text-muted">
                      Governs how environment variables, path credentials, and subshell processes are spawned by agent tools.
                    </p>
                  </div>
                </div>
              </section>

              <section
                id="execution"
                aria-labelledby="execution-title"
                class="settings-section-card scroll-mt-24"
              >
                <.settings_section_header
                  id="execution-title"
                  eyebrow="Execution"
                  title="Run defaults"
                  description="Set the global policy inherited by new runs. Per-run setup in the workspace can override these values."
                />
                <div class="settings-fields">
                  <.input
                    field={@settings_form[:default_dispatch_mode]}
                    id="settings-default-dispatch-mode"
                    type="select"
                    label="Prompt dispatch"
                    options={[
                      "Durable background": "background",
                      "Live interactive": "interactive"
                    ]}
                    class="settings-control"
                    error_class="settings-control-error"
                  />
                  <.input
                    field={@settings_form[:default_run_mode]}
                    id="settings-default-run-mode"
                    type="select"
                    label="Default mission type"
                    options={[
                      "Single agent": "single",
                      Swarm: "swarm",
                      "Typed DAG": "dag",
                      Research: "research"
                    ]}
                    class="settings-control"
                    error_class="settings-control-error"
                  />
                  <.input
                    field={@settings_form[:default_run_priority]}
                    id="settings-default-run-priority"
                    type="select"
                    label="Queue priority"
                    options={[Low: "low", Normal: "normal", High: "high", Critical: "critical"]}
                    class="settings-control"
                    error_class="settings-control-error"
                  />
                  <.input
                    field={@settings_form[:default_run_max_attempts]}
                    id="settings-default-run-max-attempts"
                    type="number"
                    label="Manual retry ceiling"
                    min="1"
                    max="10"
                    aria-description="Counts the initial execution; eligible terminal runs require a user-requested retry."
                    class="settings-control"
                    error_class="settings-control-error"
                  />
                  <.input
                    field={@settings_form[:default_run_time_budget_minutes]}
                    id="settings-default-run-time-budget"
                    type="number"
                    label="Time budget (minutes)"
                    min="1"
                    max="10080"
                    placeholder="Not capped"
                    class="settings-control"
                    error_class="settings-control-error"
                  />
                  <.input
                    field={@settings_form[:default_run_token_budget]}
                    id="settings-default-run-token-budget"
                    type="number"
                    label="Token budget"
                    min="1"
                    placeholder="Not capped"
                    class="settings-control"
                    error_class="settings-control-error"
                  />
                  <.input
                    field={@settings_form[:default_run_cost_budget_cents]}
                    id="settings-default-run-cost-budget"
                    type="number"
                    label="Cost budget (cents)"
                    min="1"
                    placeholder="Not capped"
                    class="settings-control"
                    error_class="settings-control-error"
                  />
                  <.input
                    field={@settings_form[:agent_max_turns]}
                    id="settings-agent-max-turns"
                    type="number"
                    label="Agent / coder turn limit"
                    min="1"
                    max="20"
                    aria-description="Bounds the single-agent loop and each durable swarm coder invocation, including diagnostic repair passes."
                    class="settings-control"
                    error_class="settings-control-error"
                  />
                </div>
                <details id="settings-run-attempt-policy" class="settings-detail-note">
                  <summary>
                    How retries and turn limits work
                    <.icon name="hero-chevron-down" class="h-4 w-4" />
                  </summary>
                  <p class="text-sm leading-6 text-muted">
                    The ceiling counts the initial execution. A value of
                    <strong class="font-semibold text-content">3</strong>
                    allows the first run plus up to two user-requested retries. Eligible failed,
                    cancelled, or interrupted runs are never requeued automatically. Exact deep-research
                    DAGs keep their fixed one-run contract; individual DAG steps own separate bounded retries.
                    The agent-turn limit separately bounds the single-agent loop and every coder
                    model/tool loop in a durable swarm, including each diagnostic repair invocation.
                  </p>
                </details>
                <fieldset id="settings-default-tools" class="settings-fieldset mt-5">
                  <legend>Optional tools for new runs</legend>
                  <p id="settings-core-tools-note" class="mt-2 text-xs leading-5 text-subtle">
                    Core workspace read, edit, terminal, and Git tools are governed separately by the
                    execution engine and safety policy.
                  </p>
                  <div class="mt-3 grid gap-3 sm:grid-cols-2">
                    <.tool_checkbox
                      id="settings-tool-ast-search"
                      name="settings[default_tools][ast_search]"
                      label="AST search"
                      description="Search project symbols and syntax structure."
                      checked={tool_enabled?(@settings_form, @settings, "ast_search")}
                    />
                    <.tool_checkbox
                      id="settings-tool-web-search"
                      name="settings[default_tools][web_search]"
                      label="Web search"
                      description="Allow enabled federated research providers."
                      checked={tool_enabled?(@settings_form, @settings, "web_search")}
                    />
                  </div>
                </fieldset>
              </section>

              <section
                id="goals"
                aria-labelledby="goals-title"
                class="settings-section-card scroll-mt-24"
              >
                <.settings_section_header
                  id="goals-title"
                  eyebrow="Goals"
                  title="Goals"
                  description="Goals inherit the execution policy above, including budgets and the manual run attempt ceiling."
                />
                <div class="settings-choice-row">
                  <.input
                    field={@settings_form[:goal_auto_start]}
                    id="settings-goal-auto-start"
                    type="checkbox"
                    label="Queue new goals immediately"
                    class="h-4 w-4 accent-accent"
                  />
                  <p class="text-sm leading-5 text-muted">
                    Turn this off to save newly created goals as durable drafts for review.
                  </p>
                </div>
              </section>

              <section
                id="swarm"
                aria-labelledby="swarm-title"
                class="settings-section-card scroll-mt-24"
              >
                <.settings_section_header
                  id="swarm-title"
                  eyebrow="Swarm"
                  title="Swarm limits"
                  description="Choose bounded defaults for the supervised agent fleet. Individual runs may request fewer agents."
                />
                <div class="settings-fields">
                  <.input
                    field={@settings_form[:swarm_agent_count]}
                    id="settings-swarm-agent-count"
                    type="number"
                    label="Default fleet size"
                    min="4"
                    max="32"
                    class="settings-control"
                    error_class="settings-control-error"
                  />
                  <.input
                    field={@settings_form[:swarm_max_retries]}
                    id="settings-swarm-max-retries"
                    type="number"
                    label="Swarm self-healing retries"
                    min="0"
                    max="10"
                    aria-description="Self-healing verification retries inside one run attempt."
                    class="settings-control"
                    error_class="settings-control-error"
                  />
                </div>
                <p id="settings-swarm-retry-policy" class="settings-help-copy">
                  Verification self-healing retries happen inside one run attempt; they do not add
                  manual run retries. Fleet size remains constrained by durable run capacity and
                  workspace locks.
                </p>
              </section>
            </div>

            <div
              id="tab-panel-context"
              class={[@active_tab != :context && "hidden", "settings-tab-panel"]}
            >
              <section id="context-compaction-card" class="settings-section-card">
                <.settings_section_header
                  id="context-compaction-title"
                  eyebrow="Token Management"
                  title="Context window"
                  description="Choose how much conversation to retain and when older context is condensed."
                />

                <div class="settings-fields">
                  <.input
                    field={@settings_form[:context_window_tokens]}
                    id="settings-context-window-tokens"
                    type="number"
                    label="Context window limit"
                    min="1000"
                    max="10000000"
                    class="settings-control font-mono"
                    error_class="settings-control-error"
                  />
                  <.input
                    field={@settings_form[:context_prune_threshold_percent]}
                    id="settings-context-prune-threshold"
                    type="number"
                    label="Prune threshold (%)"
                    min="10"
                    max="95"
                    class="settings-control font-mono"
                    error_class="settings-control-error"
                  />
                  <.input
                    field={@settings_form[:context_compaction_strategy]}
                    id="settings-context-compaction-strategy"
                    type="select"
                    label="Compaction strategy"
                    options={[
                      "Token Compaction (Fast)": "token_compaction",
                      "Rolling Summary (Fidelity)": "rolling_summary",
                      "Sliding Window (Deterministic)": "sliding_window"
                    ]}
                    class="settings-control"
                    error_class="settings-control-error"
                  />
                  <.input
                    field={@settings_form[:keep_recent_turns]}
                    id="settings-keep-recent-turns"
                    type="number"
                    label="Keep recent turns"
                    min="1"
                    max="50"
                    class="settings-control font-mono"
                    error_class="settings-control-error"
                  />
                </div>
              </section>

              <section id="workspace-persona-card" class="settings-section-card">
                <.settings_section_header
                  id="workspace-persona-title"
                  eyebrow="Personas & Instructions"
                  title="Instructions"
                  description="Set the working style and instructions included in agent prompts."
                />

                <div class="space-y-4">
                  <div>
                    <.input
                      field={@settings_form[:workspace_persona]}
                      id="settings-workspace-persona"
                      type="select"
                      label="Workspace persona preset"
                      options={[
                        "Pragmatic Senior Engineer": "pragmatic_engineer",
                        "Systems Architect": "architect",
                        "Security Auditor": "security_auditor",
                        "Minimalist Code Crafter": "minimalist",
                        "Custom Persona": "custom"
                      ]}
                      class="settings-control"
                      error_class="settings-control-error"
                    />
                  </div>

                  <div>
                    <.input
                      field={@settings_form[:custom_system_prompt]}
                      id="settings-custom-system-prompt"
                      type="textarea"
                      label="Custom system prompt"
                      rows="3"
                      placeholder="Enter instructions appended to every agent prompt..."
                      class="settings-control font-mono text-xs"
                      error_class="settings-control-error"
                    />
                  </div>

                  <div>
                    <.input
                      field={@settings_form[:coding_style_rules]}
                      id="settings-coding-style-rules"
                      type="textarea"
                      label="Coding style rules"
                      rows="3"
                      placeholder="Enter codebase coding conventions and style rules..."
                      class="settings-control font-mono text-xs"
                      error_class="settings-control-error"
                    />
                  </div>
                </div>
              </section>

              <section
                id="research"
                aria-labelledby="research-title"
                class="settings-section-card settings-section-card-research scroll-mt-24"
              >
                <.settings_section_header
                  id="research-title"
                  eyebrow="Research"
                  title="Research effort and enforced caps"
                  description="Every preset remains bounded. Optional caps below can tighten a preset but never expand its safety ceiling."
                  tone="research"
                />
                <% {effort_name, effort_copy} =
                  research_effort_value(@settings_form[:research_level].value) %>
                <div
                  id="settings-research-effort-summary"
                  class="mb-5 border border-violet-400/25 bg-violet-400/[0.05] p-4"
                >
                  <p class="font-mono text-xs font-semibold text-violet-300">
                    {effort_name} effort
                  </p>
                  <p class="mt-1 text-sm leading-5 text-muted">{effort_copy}</p>
                  <dl class="mt-4 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
                    <div>
                      <dt class="text-subtle">Sources</dt><dd class="mt-1 font-mono text-content">
                        up to {@settings_form[:research_max_sources].value}
                      </dd>
                    </div>
                    <div>
                      <dt class="text-subtle">Fetch workers</dt><dd class="mt-1 font-mono text-content">
                        {@settings_form[:research_parallelism].value}
                      </dd>
                    </div>
                    <div>
                      <dt class="text-subtle">Token cap</dt><dd class="mt-1 font-mono text-content">
                        {optional_limit(@settings_form[:research_max_tokens].value, "tokens")}
                      </dd>
                    </div>
                    <div>
                      <dt class="text-subtle">Time cap</dt><dd class="mt-1 font-mono text-content">
                        {optional_limit(
                          @settings_form[:research_time_budget_minutes].value,
                          "minutes"
                        )}
                      </dd>
                    </div>
                  </dl>
                </div>
                <div class="settings-fields">
                  <.input
                    field={@settings_form[:research_level]}
                    id="settings-research-level"
                    type="select"
                    label="Research effort"
                    options={[Low: "low", Medium: "medium", High: "high", Ultra: "ultra"]}
                    class="settings-control settings-control-research"
                    error_class="settings-control-error"
                  />
                  <.input
                    field={@settings_form[:research_max_sources]}
                    id="settings-research-max-sources"
                    type="number"
                    label="Maximum sources"
                    min="1"
                    max="40"
                    class="settings-control settings-control-research"
                    error_class="settings-control-error"
                  />
                  <.input
                    field={@settings_form[:research_parallelism]}
                    id="settings-research-parallelism"
                    type="number"
                    label="Fetch parallelism"
                    min="1"
                    max="16"
                    class="settings-control settings-control-research"
                    error_class="settings-control-error"
                  />
                  <.input
                    field={@settings_form[:research_time_budget_minutes]}
                    id="settings-research-time-budget"
                    type="number"
                    label="Time cap (minutes)"
                    min="1"
                    max="1440"
                    placeholder="Preset ceiling"
                    class="settings-control settings-control-research"
                    error_class="settings-control-error"
                  />
                  <.input
                    field={@settings_form[:research_max_tokens]}
                    id="settings-research-max-tokens"
                    type="number"
                    label="Token cap"
                    min="0"
                    max="10000000"
                    placeholder="Preset ceiling"
                    aria-description="Hard admission cap. Zero blocks manifests that reserve tokens; leave blank to use the effort preset ceiling."
                    class="settings-control settings-control-research"
                    error_class="settings-control-error"
                  />
                  <.input
                    field={@settings_form[:research_max_cost_cents]}
                    id="settings-research-max-cost"
                    type="number"
                    label="Cost cap (cents)"
                    min="0"
                    max="10000000"
                    placeholder="Preset ceiling"
                    aria-description="Hard admission cap. Zero blocks manifests that reserve reported provider cost; leave blank to use the effort preset ceiling."
                    class="settings-control settings-control-research"
                    error_class="settings-control-error"
                  />
                  <.input
                    field={@settings_form[:research_depth]}
                    id="settings-research-depth"
                    type="select"
                    label="Legacy workflow depth"
                    options={[Quick: "quick", Standard: "standard", Deep: "deep"]}
                    class="settings-control settings-control-research"
                    error_class="settings-control-error"
                  />
                  <div class="settings-choice-row min-h-11">
                    <.input
                      field={@settings_form[:research_require_conflict_audit]}
                      id="settings-research-conflict-audit"
                      type="checkbox"
                      label="Require conflict audit"
                      class="h-4 w-4 accent-violet-400"
                    />
                  </div>
                </div>
                <p id="settings-research-zero-cap-note" class="mt-4 text-xs leading-5 text-subtle">
                  Token and reported-cost caps are hard admission limits. Entering 0 blocks any
                  research manifest that reserves that resource; leave a cap blank to use the bounded
                  effort-preset ceiling.
                </p>
              </section>
            </div>

            <div
              id="tab-panel-environment"
              class={[@active_tab != :environment && "hidden", "settings-tab-panel"]}
            >
              <section id="environment-vars-card" class="settings-section-card">
                <.settings_section_header
                  id="environment-vars-title"
                  eyebrow="Environment Sandbox"
                  title="Variables & secrets"
                  description="Configure environment variables passed into agent subshell tasks and terminal sessions. Sensitive variables are sanitized by SecretMasker."
                />

                <div class="space-y-4">
                  <div class="rounded-xl border border-white/10 bg-inset p-4 space-y-3">
                    <h4 class="text-xs font-semibold text-muted">
                      Configured variables
                    </h4>
                    <div class="overflow-hidden rounded-lg border border-white/5">
                      <table class="w-full text-left text-xs text-muted">
                        <thead class="border-b border-white/5 bg-white/[0.02] text-[10px] font-medium text-muted">
                          <tr>
                            <th class="px-4 py-2">Variable Key</th>
                            <th class="px-4 py-2">Value</th>
                            <th class="px-4 py-2 text-right">Status</th>
                          </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5 font-mono">
                          <%= if is_map(@settings.custom_env_vars) and map_size(@settings.custom_env_vars) > 0 do %>
                            <%= for {k, v} <- @settings.custom_env_vars do %>
                              <tr>
                                <td class="px-4 py-2 font-semibold text-cyan-300">{k}</td>
                                <td class="px-4 py-2 text-muted truncate max-w-xs">{v}</td>
                                <td class="px-4 py-2 text-right text-emerald-400 text-[10px]">
                                  Active
                                </td>
                              </tr>
                            <% end %>
                          <% else %>
                            <tr>
                              <td colspan="3" class="px-4 py-4 text-center text-subtle font-sans">
                                No custom environment variables defined yet. Subshells inherit the filtered parent environment.
                              </td>
                            </tr>
                          <% end %>
                        </tbody>
                      </table>
                    </div>
                  </div>

                  <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/[0.03] p-4 flex items-start gap-3">
                    <.icon
                      name="hero-shield-check"
                      class="h-5 w-5 text-emerald-400 shrink-0 mt-0.5"
                    />
                    <div class="text-xs text-muted space-y-1">
                      <p class="font-semibold text-content">Secret masking is enabled</p>
                      <p class="text-muted leading-5">
                        The <code class="font-mono text-emerald-300">SecretMasker</code>
                        engine inspects all command outputs, terminal streams, and agent execution traces, automatically redacting API keys, bearer tokens, and private credentials with
                        <span class="font-mono text-cyan-300">[REDACTED_SECRET]</span>
                        before persistence or telemetry broadcast.
                      </p>
                    </div>
                  </div>
                </div>
              </section>
            </div>

            <div
              id="tab-panel-appearance"
              class={[
                @active_tab != :appearance && "hidden",
                "settings-tab-panel settings-appearance-panel"
              ]}
            >
              <section
                id="visual-appearance-card"
                aria-labelledby="visual-appearance-title"
                class="settings-section-card order-1 rounded-[20px]"
              >
                <div id="settings-appearance-studio" class="appearance-studio">
                  <header class="settings-section-header">
                    <h3 id="visual-appearance-title">Theme & depth</h3>
                    <p>Preview your changes here. Save to apply them across the workspace.</p>
                  </header>

                  <div class="appearance-studio-grid">
                    <div class="appearance-controls-column min-w-0">
                      <% theme_errors = appearance_theme_errors(@settings_form) %>
                      <fieldset
                        id="settings-theme-choices"
                        class="appearance-theme-fieldset"
                        aria-invalid={theme_errors != [] && "true"}
                        aria-describedby={theme_errors != [] && "settings-ui-theme-error"}
                      >
                        <legend class="appearance-field-label">Workspace palette</legend>
                        <p class="appearance-field-help">
                          A different atmosphere. The same workspace.
                        </p>

                        <div class="appearance-theme-grid">
                          <label
                            :for={theme <- appearance_themes()}
                            for={"settings-ui-theme-#{theme.id}"}
                            class="appearance-theme-choice"
                            title={theme.description}
                          >
                            <input
                              id={"settings-ui-theme-#{theme.id}"}
                              type="radio"
                              name="settings[ui_theme]"
                              value={theme.id}
                              checked={appearance_theme(@settings_form) == theme.id}
                              class="peer sr-only"
                            />
                            <span
                              class="appearance-theme-card"
                              data-theme-swatch={theme.id}
                            >
                              <span
                                class="appearance-theme-swatch"
                                data-ui-theme={theme.id}
                                aria-hidden="true"
                              >
                                <span class="appearance-swatch-orbit"></span>
                                <span class="appearance-swatch-planet"></span>
                                <span class="appearance-swatch-console"><i></i><i></i><i></i></span>
                                <span class="appearance-swatch-spectrum"><i></i><i></i><i></i></span>
                              </span>
                              <span class="appearance-theme-copy">
                                <span class="appearance-theme-name">{theme.name}</span>
                                <span class="appearance-theme-mood">{theme.mood}</span>
                                <span class="appearance-theme-description">{theme.description}</span>
                              </span>
                              <span class="appearance-theme-check" aria-hidden="true">
                                <.icon name="hero-check" class="h-3.5 w-3.5" />
                              </span>
                            </span>
                          </label>
                        </div>
                        <p
                          :if={theme_errors != []}
                          id="settings-ui-theme-error"
                          role="alert"
                          class="mt-3 text-sm text-rose-300"
                        >
                          {Enum.join(theme_errors, ". ")}
                        </p>
                      </fieldset>

                      <fieldset id="settings-depth-controls" class="appearance-depth-panel">
                        <legend class="appearance-field-label">Depth & motion</legend>
                        <p class="appearance-field-help">
                          Control shadows and movement independently.
                        </p>

                        <div class="appearance-switch-list">
                          <label for="settings-shadows-3d" class="appearance-switch-row">
                            <span class="appearance-switch-icon">
                              <.icon name="hero-square-3-stack-3d" class="h-5 w-5" />
                            </span>
                            <span class="min-w-0 flex-1">
                              <span class="appearance-switch-title">3D shadows</span>
                              <span
                                id="settings-shadows-3d-description"
                                class="appearance-switch-description"
                              >
                                Adds elevation and soft contact shadows to raised surfaces.
                              </span>
                            </span>
                            <input type="hidden" name="settings[shadows_3d]" value="false" />
                            <input
                              id="settings-shadows-3d"
                              type="checkbox"
                              name="settings[shadows_3d]"
                              value="true"
                              checked={appearance_enabled?(@settings_form, :shadows_3d)}
                              role="switch"
                              aria-describedby="settings-shadows-3d-description"
                              class="peer sr-only"
                            />
                            <span class="appearance-switch" aria-hidden="true"><span></span></span>
                          </label>

                          <label for="settings-effects-3d" class="appearance-switch-row">
                            <span class="appearance-switch-icon">
                              <.icon name="hero-cursor-arrow-rays" class="h-5 w-5" />
                            </span>
                            <span class="min-w-0 flex-1">
                              <span class="appearance-switch-title">3D effects</span>
                              <span
                                id="settings-effects-3d-description"
                                class="appearance-switch-description"
                              >
                                Enables perspective, hover lift, and spatial movement.
                              </span>
                            </span>
                            <input type="hidden" name="settings[effects_3d]" value="false" />
                            <input
                              id="settings-effects-3d"
                              type="checkbox"
                              name="settings[effects_3d]"
                              value="true"
                              checked={appearance_enabled?(@settings_form, :effects_3d)}
                              role="switch"
                              aria-describedby="settings-effects-3d-description"
                              class="peer sr-only"
                            />
                            <span class="appearance-switch" aria-hidden="true"><span></span></span>
                          </label>
                        </div>
                      </fieldset>

                      <details class="appearance-legacy-settings">
                        <summary id="settings-appearance-more">
                          <span>Layout preferences</span>
                          <.icon name="hero-chevron-down" class="h-4 w-4" />
                        </summary>
                        <div class="grid gap-4 pt-4 sm:grid-cols-2">
                          <.input
                            field={@settings_form[:layout_density]}
                            id="settings-layout-density"
                            type="select"
                            label="Layout density"
                            options={[Comfortable: "comfortable", Compact: "compact"]}
                            class="settings-control"
                            error_class="settings-control-error"
                          />
                          <.input
                            field={@settings_form[:theme_accent]}
                            id="settings-theme-accent"
                            type="select"
                            label="Legacy accent compatibility"
                            options={[
                              Cyan: "cyan",
                              Emerald: "emerald",
                              Violet: "violet",
                              Amber: "amber",
                              Rose: "rose",
                              Carbon: "carbon"
                            ]}
                            class="settings-control"
                            error_class="settings-control-error"
                          />
                        </div>
                        <p class="appearance-legacy-note">
                          The named palette controls workspace color. Legacy accent is retained for
                          older extensions and does not override the palette.
                        </p>
                      </details>
                    </div>

                    <aside class="appearance-preview-column" aria-label="Appearance preview">
                      <div class="appearance-preview-label">
                        <span><.icon name="hero-eye" class="h-3.5 w-3.5" />Workspace preview</span>
                        <span>{String.capitalize(appearance_theme(@settings_form))}</span>
                      </div>
                      <div
                        id="settings-appearance-preview"
                        class="appearance-preview"
                        aria-hidden="true"
                        data-ui-theme={appearance_theme(@settings_form)}
                        data-depth-shadows={
                          if(appearance_enabled?(@settings_form, :shadows_3d),
                            do: "true",
                            else: "false"
                          )
                        }
                        data-depth-effects={
                          if(appearance_enabled?(@settings_form, :effects_3d),
                            do: "true",
                            else: "false"
                          )
                        }
                      >
                        <div class="appearance-preview-window">
                          <div class="appearance-preview-rail">
                            <span class="appearance-preview-brand">IX</span>
                            <span class="is-active"></span><span></span><span></span><span></span>
                          </div>
                          <div class="appearance-preview-body">
                            <div class="appearance-preview-topbar">
                              <span class="appearance-preview-crumb">workspace / iex-code</span>
                              <span class="appearance-preview-avatar"><.icon
                                name="hero-user"
                                class="h-3 w-3"
                              /></span>
                            </div>
                            <div class="appearance-preview-canvas">
                              <div class="appearance-preview-heading">
                                <div>
                                  <span>Current mission</span>
                                  <strong>Polish the release</strong>
                                </div>
                                <span class="appearance-preview-run">Run</span>
                              </div>
                              <div class="appearance-preview-columns">
                                <div class="appearance-preview-editor">
                                  <span class="line is-short"></span>
                                  <span class="line is-accent"></span>
                                  <span class="line"></span>
                                  <span class="line is-mid"></span>
                                  <span class="line is-short"></span>
                                </div>
                                <div class="appearance-preview-stack">
                                  <article>
                                    <span>Agent status</span><strong>Reviewing</strong>
                                  </article>
                                  <article>
                                    <span>Changed files</span><strong>08</strong>
                                  </article>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                      <p class="appearance-preview-caption">
                        Theme, shadows, and effects are shown together in this preview.
                      </p>
                    </aside>
                  </div>
                </div>
              </section>

              <section id="audio-ergonomics-card" class="settings-section-card order-2">
                <.settings_section_header
                  id="audio-ergonomics-title"
                  eyebrow="Ergonomics"
                  title="Sound"
                  description="Choose alerts for completed tasks, approval requests, and errors."
                />

                <div class="settings-fields">
                  <div class="space-y-4">
                    <label class="flex items-center gap-3">
                      <input type="hidden" name="settings[sound_enabled]" value="false" />
                      <input
                        id="settings-sound-enabled"
                        type="checkbox"
                        name="settings[sound_enabled]"
                        value="true"
                        checked={@settings_form[:sound_enabled].value in [true, "true"]}
                        class="h-4 w-4 rounded border-gray-600 bg-inset accent-cyan-500"
                      />
                      <span class="text-sm font-semibold text-content">Play notification sounds</span>
                    </label>

                    <div>
                      <.input
                        field={@settings_form[:sound_volume]}
                        id="settings-sound-volume"
                        type="number"
                        label="Audio volume (0-100)"
                        min="0"
                        max="100"
                        class="settings-control font-mono"
                        error_class="settings-control-error"
                      />
                    </div>
                  </div>

                  <div class="space-y-3">
                    <div class="flex items-center justify-between gap-3">
                      <div class="flex-1">
                        <.input
                          field={@settings_form[:completion_chime]}
                          id="settings-completion-chime"
                          type="select"
                          label="Completion chime"
                          options={[
                            Hero: "hero",
                            Sosumi: "sosumi",
                            Ping: "ping",
                            Glass: "glass",
                            Bottle: "bottle",
                            Funk: "funk"
                          ]}
                          class="settings-control"
                        />
                      </div>
                      <button
                        type="button"
                        id="test-completion-chime-btn"
                        phx-click="test_chime"
                        phx-value-chime={@settings_form[:completion_chime].value || "hero"}
                        class="settings-chime-test"
                      >
                        <.icon name="hero-speaker-wave" class="h-3.5 w-3.5" />
                        <span>Test</span>
                      </button>
                    </div>

                    <div class="flex items-center justify-between gap-3">
                      <div class="flex-1">
                        <.input
                          field={@settings_form[:error_alert_chime]}
                          id="settings-error-alert-chime"
                          type="select"
                          label="Error alert chime"
                          options={[Basso: "basso", Sosumi: "sosumi", Funk: "funk"]}
                          class="settings-control"
                        />
                      </div>
                      <button
                        type="button"
                        id="test-error-chime-btn"
                        phx-click="test_chime"
                        phx-value-chime={@settings_form[:error_alert_chime].value || "basso"}
                        class="settings-chime-test"
                      >
                        <.icon name="hero-speaker-wave" class="h-3.5 w-3.5" />
                        <span>Test</span>
                      </button>
                    </div>

                    <div class="flex items-center justify-between gap-3">
                      <div class="flex-1">
                        <.input
                          field={@settings_form[:approval_prompt_chime]}
                          id="settings-approval-prompt-chime"
                          type="select"
                          label="Approval prompt chime"
                          options={[Ping: "ping", Glass: "glass", Hero: "hero"]}
                          class="settings-control"
                        />
                      </div>
                      <button
                        type="button"
                        id="test-approval-chime-btn"
                        phx-click="test_chime"
                        phx-value-chime={@settings_form[:approval_prompt_chime].value || "ping"}
                        class="settings-chime-test"
                      >
                        <.icon name="hero-speaker-wave" class="h-3.5 w-3.5" />
                        <span>Test</span>
                      </button>
                    </div>
                  </div>
                </div>
              </section>

              <section
                id="editor"
                aria-labelledby="editor-title"
                class="settings-section-card order-3 scroll-mt-24"
              >
                <.settings_section_header
                  id="editor-title"
                  eyebrow="Editor"
                  title="File editing"
                  description="Control how workspace file edits behave after agent or user changes."
                />
                <div class="settings-choice-row">
                  <.input
                    field={@settings_form[:auto_save]}
                    id="settings-auto-save"
                    type="checkbox"
                    label="Automatically save file edits"
                    class="h-4 w-4 accent-accent"
                  />
                  <p class="text-sm leading-5 text-muted">
                    When disabled, edited buffers remain marked as unsaved until you confirm them.
                  </p>
                </div>
              </section>

              <section
                id="usage"
                aria-labelledby="usage-title"
                class="settings-section-card order-4 scroll-mt-24"
              >
                <.settings_section_header
                  id="usage-title"
                  eyebrow="Usage"
                  title={if @context_session, do: "Current session usage", else: "Global usage"}
                  description="Only provider-reported token-bearing messages are counted. No estimates or fabricated credit bars."
                />
                <div :if={@usage_status == :ready} id="settings-usage-ready">
                  <dl class="mb-5 grid gap-3 sm:grid-cols-2">
                    <div class="settings-metric">
                      <dt>Observed tokens</dt><dd>{usage_total_value(@usage_totals)}</dd>
                    </div>
                    <div class="settings-metric">
                      <dt>Reported cost</dt><dd>
                        ${:erlang.float_to_binary(usage_cost_value(@usage_totals), decimals: 2)}
                      </dd>
                    </div>
                  </dl>
                  <div
                    id="settings-usage-rows"
                    class="divide-y divide-line border-y border-line"
                  >
                    <article
                      :for={row <- Enum.take(@usage_rows, 20)}
                      id={"settings-usage-row-#{usage_dom_id(row)}"}
                      class="grid gap-2 py-3 text-sm sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:items-center sm:gap-5"
                    >
                      <div class="min-w-0">
                        <p class="truncate font-medium text-content">
                          {usage_value(row, :model, "Unknown model")}
                        </p><p class="mt-0.5 font-mono text-xs text-subtle">
                          {format_usage_date(usage_value(row, :date))}
                        </p>
                      </div>
                      <p class="font-mono text-xs text-muted">
                        {usage_value(row, :provider, "unknown")}
                      </p>
                      <p class="font-mono text-sm font-semibold tabular-nums text-content">
                        {usage_value(row, :tokens, 0)} tokens
                      </p>
                    </article>
                  </div>
                </div>
                <div
                  :if={@usage_status in [:empty, :unavailable]}
                  id="settings-usage-empty"
                  class="settings-empty-state"
                >
                  <.icon name="hero-chart-bar" class="mx-auto mb-3 h-6 w-6 text-subtle" />{@usage_message}
                </div>
                <div
                  :if={@usage_status == :error}
                  id="settings-usage-error"
                  role="alert"
                  class="settings-error-state"
                >
                  <.icon name="hero-exclamation-triangle" class="h-5 w-5 shrink-0" />{@usage_message}
                </div>
              </section>
            </div>
          </div>
          <div id="settings-save-bar" class="settings-save-bar">
            <div id="settings-save-status" role="status" aria-live="polite" class="min-w-0">
              <div class="phx-submit-loading:hidden">
                <p class={["text-sm font-semibold", status_text_class(@settings_status)]}>
                  {status_title(@settings_status)}
                </p>
                <p class="mt-0.5 text-xs leading-5 text-subtle">
                  {@settings_message}
                  <%= if @saved_at && @settings_status == :saved do %>
                    · {Calendar.strftime(@saved_at, "%H:%M:%S UTC")}
                  <% end %>
                </p>
              </div>
              <div class="hidden phx-submit-loading:block">
                <p class="text-sm font-semibold text-accent">Saving</p>
                <p class="mt-0.5 text-xs text-subtle">
                  Writing validated defaults to local storage…
                </p>
              </div>
            </div>
            <div class="flex shrink-0 items-center gap-2">
              <button
                id="settings-discard"
                type="button"
                phx-click="discard_settings"
                disabled={@settings_status not in [:dirty, :error]}
                aria-describedby="settings-save-status"
                class="settings-discard-button"
              >
                Discard
              </button>
              <button
                id="settings-save"
                type="submit"
                phx-disable-with="Saving…"
                disabled={@settings_status not in [:dirty, :error]}
                aria-describedby="settings-save-status"
                class="settings-save-button phx-submit-loading:cursor-wait"
              >
                Save settings
              </button>
            </div>
          </div>
        </.form>
      </div>
    </div>
  </main>
  <div
    id="settings-client-behaviors"
    phx-hook=".SettingsPage"
    data-dirty={if(@settings_status in [:dirty, :error], do: "true", else: "false")}
    class="hidden"
  >
  </div>
  <script :type={Phoenix.LiveView.ColocatedHook} name=".SettingsPage">
    export default {
      mounted() {
        this.dirty = this.el.dataset.dirty === "true"
        this.settingsBasePath = this.settingsBasePathFor(window.location.pathname)
        this.settingsLocation = null
        this.afterNavigate = () => this.scrollToSettingsLocation()
        window.addEventListener("phx:page-loading-stop", this.afterNavigate)
        this.scrollToSettingsLocation()

        this.beforeUnload = event => {
          if (!this.dirty) return
          event.preventDefault()
          event.returnValue = ""
        }

        this.guardNavigation = event => {
          const link = event.target.closest("[data-settings-navigation]")
          if (!this.dirty || !link) return

          const message = link.dataset.unsavedConfirm
          if (!message || !window.confirm(message)) {
            event.preventDefault()
            event.stopImmediatePropagation()
            return
          }

          this.dirty = false
        }

        this.beforeNavigate = event => {
          if (!this.dirty) return

          const destination = new URL(event.detail.href, window.location.href)
          if (this.settingsBasePathFor(destination.pathname) === this.settingsBasePath) return

          if (!window.confirm("Discard your unsaved settings and leave this page?")) {
            event.preventDefault()
            return
          }

          this.dirty = false
        }

        window.addEventListener("beforeunload", this.beforeUnload)
        window.addEventListener("phx:before-navigate", this.beforeNavigate)
        document.addEventListener("click", this.guardNavigation, true)

        this.handleEvent("settings_clear_secrets", () => {
          document.querySelectorAll("#settings-form input[type='password']").forEach(input => {
            input.value = ""
          })
        })
      },

      updated() {
        this.dirty = this.el.dataset.dirty === "true"
      },

      destroyed() {
        window.removeEventListener("beforeunload", this.beforeUnload)
        window.removeEventListener("phx:before-navigate", this.beforeNavigate)
        window.removeEventListener("phx:page-loading-stop", this.afterNavigate)
        if (this.scrollFrame) cancelAnimationFrame(this.scrollFrame)
        document.removeEventListener("click", this.guardNavigation, true)
      },

      scrollToSettingsLocation() {
        const location = window.location.pathname + window.location.hash
        if (location === this.settingsLocation) return
        this.settingsLocation = location
        if (this.scrollFrame) cancelAnimationFrame(this.scrollFrame)
        this.scrollFrame = requestAnimationFrame(() => {
          const region = document.getElementById("settings-scroll-region")
          if (!region) return
          let sectionId
          try {
            sectionId = decodeURIComponent(window.location.hash.slice(1))
          } catch {
            sectionId = ""
          }
          const section = sectionId && document.getElementById(sectionId)
          region.scrollTop = section && region.contains(section) && section.getClientRects().length
            ? region.scrollTop + section.getBoundingClientRect().top - region.getBoundingClientRect().top - 16
            : 0
        })
      },

      settingsBasePathFor(pathname) {
        if (pathname === "/settings" || pathname.startsWith("/settings/")) return "/settings"

        const sessionSettings = pathname.match(/^\/sessions\/[^/]+\/settings(?:\/|$)/)
        return sessionSettings ? sessionSettings[0].replace(/\/$/, "") : null
      }
    }
  </script>
</Layouts.app>
