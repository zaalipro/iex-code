<Layouts.app flash={@flash}>
  <div class="flex h-screen w-full bg-[#0a0d12] text-[#f0f6fc] font-sans antialiased overflow-hidden select-none">
    <!-- Sidebar: Sessions & Projects Navigation (Matching Reference Image) -->
    <aside class="w-64 bg-[#11151c] border-r border-[#21262d] flex flex-col justify-between shrink-0">
      <div class="flex flex-col h-full overflow-hidden">
        <!-- Brand / Workspace Header (Matching Reference Image) -->
        <div class="p-3.5 border-b border-[#21262d] relative">
          <button
            phx-click="toggle_workspace_menu"
            class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-xl hover:bg-[#161b22] text-left transition-smooth group"
          >
            <div class="flex items-center gap-2.5 min-w-0">
              <div class="w-7 h-7 rounded-xl bg-gradient-to-tr from-[#ff5e3a] to-[#feb47b] flex items-center justify-center text-white font-bold shadow-md shadow-orange-500/20 text-xs shrink-0">
                <.icon name="hero-cube-transparent" class="w-4 h-4 text-white" />
              </div>
              <div class="min-w-0">
                <div class="text-xs font-bold text-white tracking-tight flex items-center gap-1.5 truncate">
                  <span>IexCode</span>
                  <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-[#21262d] text-emerald-400 font-normal truncate">
                    {@project.name}
                  </span>
                </div>
              </div>
            </div>
            <.icon
              name="hero-chevron-up-down"
              class="w-3.5 h-3.5 text-gray-400 group-hover:text-white shrink-0"
            />
          </button>

          <!-- Workspace Switcher Popover (Image 3) -->
          <%= if @show_workspace_menu do %>
            <div
              class="absolute left-3 right-3 top-14 z-50 bg-[#161b22]/95 backdrop-blur-xl border border-[#30363d] rounded-2xl shadow-2xl p-2.5 transition-smooth animate-in fade-in"
              phx-click-away="toggle_workspace_menu"
            >
              <div class="relative mb-2">
                <input
                  type="text"
                  placeholder="Search Workspace..."
                  phx-change="search_workspace"
                  name="query"
                  value={@workspace_search}
                  class="w-full bg-[#0d1117] border border-[#30363d] rounded-lg px-3 py-1.5 text-xs text-white placeholder-gray-500 focus:border-emerald-500 focus:outline-none font-mono"
                />
              </div>

              <div class="max-h-48 overflow-y-auto space-y-1">
                <%= for p <- @projects do %>
                  <button
                    phx-click="switch_project"
                    phx-value-id={p.id}
                    class={[
                      "w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs font-mono transition-smooth text-left",
                      p.id == @project.id && "bg-[#21262d] text-emerald-400 font-medium",
                      p.id != @project.id && "hover:bg-[#1f242c] text-gray-300 hover:text-white"
                    ]}
                  >
                    <div class="flex items-center gap-2 truncate">
                      <span class={[
                        "w-2 h-2 rounded-full",
                        p.id == @project.id && "bg-emerald-400",
                        p.id != @project.id && "bg-gray-500"
                      ]}></span>
                      <span class="truncate">{p.name}</span>
                    </div>
                    <span class="text-[10px] text-gray-500">repo</span>
                  </button>
                <% end %>
              </div>

              <div class="mt-2 pt-2 border-t border-[#21262d] flex justify-between items-center px-1">
                <button
                  phx-click="toggle_project_modal"
                  class="text-[11px] text-emerald-400 hover:text-emerald-300 font-medium flex items-center gap-1 font-mono"
                >
                  <.icon name="hero-plus" class="w-3.5 h-3.5" /> New Workspace
                </button>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Search Bar (Matching Reference Image) -->
        <div class="px-3 pt-3 pb-1">
          <div class="relative">
            <.icon
              name="hero-magnifying-glass"
              class="w-3.5 h-3.5 text-gray-500 absolute left-3 top-2.5"
            />
            <input
              type="text"
              placeholder="Search..."
              phx-change="search_workspace"
              name="query"
              value={@workspace_search}
              class="w-full bg-[#161b22] border border-[#21262d] rounded-xl pl-8 pr-3 py-1.5 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-gray-400 transition-smooth font-mono"
            />
          </div>
        </div>

        <!-- Primary Navigation Links (Matching Reference Image) -->
        <div class="px-3 py-2 space-y-0.5">
          <button
            id="sidebar-tab-kanban"
            phx-click="switch_tab"
            phx-value-sidebar_tab="kanban"
            class={[
              "w-full flex items-center gap-2.5 px-3 py-1.5 rounded-xl text-xs font-medium transition-smooth text-left",
              @active_tab == "kanban" && "bg-[#21262d] text-white shadow-sm font-semibold",
              @active_tab != "kanban" && "text-gray-400 hover:text-gray-200 hover:bg-[#161b22]"
            ]}
          >
            <.icon name="hero-squares-2x2" class="w-3.5 h-3.5 text-gray-400" />
            <span>Dashboard</span>
          </button>

          <button
            id="sidebar-tab-swarm"
            phx-click="switch_tab"
            phx-value-sidebar_tab="swarm"
            class={[
              "w-full flex items-center gap-2.5 px-3 py-1.5 rounded-xl text-xs font-medium transition-smooth text-left",
              @active_tab == "swarm" && "bg-[#21262d] text-white shadow-sm font-semibold",
              @active_tab != "swarm" && "text-gray-400 hover:text-gray-200 hover:bg-[#161b22]"
            ]}
          >
            <.icon name="hero-sparkles" class="w-3.5 h-3.5 text-amber-400" />
            <span>Coach & Swarm</span>
          </button>

          <button
            id="sidebar-tab-calendar"
            phx-click="switch_tab"
            phx-value-sidebar_tab="calendar"
            class={[
              "w-full flex items-center gap-2.5 px-3 py-1.5 rounded-xl text-xs font-medium transition-smooth text-left",
              @active_tab == "calendar" && "bg-[#21262d] text-white shadow-sm font-semibold",
              @active_tab != "calendar" && "text-gray-400 hover:text-gray-200 hover:bg-[#161b22]"
            ]}
          >
            <.icon name="hero-calendar" class="w-3.5 h-3.5 text-indigo-400" />
            <span>Scheduled</span>
          </button>

          <button
            id="sidebar-tab-changes"
            phx-click="switch_tab"
            phx-value-sidebar_tab="changes"
            class={[
              "w-full flex items-center gap-2.5 px-3 py-1.5 rounded-xl text-xs font-medium transition-smooth text-left",
              @active_tab == "changes" && "bg-[#21262d] text-white shadow-sm font-semibold",
              @active_tab != "changes" && "text-gray-400 hover:text-gray-200 hover:bg-[#161b22]"
            ]}
          >
            <.icon name="hero-code-bracket" class="w-3.5 h-3.5 text-cyan-400" />
            <span>Progress & Diffs</span>
          </button>

          <button
            id="sidebar-tab-files"
            phx-click="switch_tab"
            phx-value-sidebar_tab="files"
            class={[
              "w-full flex items-center gap-2.5 px-3 py-1.5 rounded-xl text-xs font-medium transition-smooth text-left",
              @active_tab == "files" && "bg-[#21262d] text-white shadow-sm font-semibold",
              @active_tab != "files" && "text-gray-400 hover:text-gray-200 hover:bg-[#161b22]"
            ]}
          >
            <.icon name="hero-folder" class="w-3.5 h-3.5 text-gray-400" />
            <span>Resources & Files</span>
          </button>

          <button
            id="sidebar-tab-terminal"
            phx-click="switch_tab"
            phx-value-sidebar_tab="terminal"
            class={[
              "w-full flex items-center gap-2.5 px-3 py-1.5 rounded-xl text-xs font-medium transition-smooth text-left",
              @active_tab == "terminal" && "bg-[#21262d] text-white shadow-sm font-semibold",
              @active_tab != "terminal" && "text-gray-400 hover:text-gray-200 hover:bg-[#161b22]"
            ]}
          >
            <.icon name="hero-command-line" class="w-3.5 h-3.5 text-gray-400" />
            <span>Terminal</span>
          </button>
        </div>

        <!-- Sessions Subtree (Matching Reference Image) -->
        <div class="flex-1 overflow-y-auto px-3 py-2">
          <div class="flex items-center justify-between px-2 py-1 mb-1">
            <span class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider flex items-center gap-1.5">
              <.icon name="hero-document-text" class="w-3.5 h-3.5" /> Sessions
            </span>
            <button
              id="new-session-btn"
              phx-click="new_session"
              class="text-gray-400 hover:text-white p-1 hover:bg-[#21262d] rounded-lg transition-smooth"
              title="New Session"
            >
              <.icon name="hero-plus" class="w-3.5 h-3.5" />
            </button>
          </div>

          <div class="space-y-0.5 pl-2 relative border-l border-[#21262d] ml-3">
            <%= for s <- @sessions do %>
              <div class={[
                "group flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs font-mono transition-smooth cursor-pointer",
                s.id == @session.id && "bg-[#1c2128] text-white font-medium shadow-sm",
                s.id != @session.id && "text-gray-400 hover:text-gray-200 hover:bg-[#161b22]"
              ]}>
                <.link
                  patch={~p"/sessions/#{s.id}?project_id=#{@project.id}"}
                  class="flex items-center gap-2 truncate flex-1"
                >
                  <span class={[
                    "w-1.5 h-1.5 rounded-full shrink-0",
                    s.status == "running" && "bg-emerald-400 animate-pulse",
                    s.status != "running" && "bg-gray-500"
                  ]}></span>
                  <span class="truncate">{s.title}</span>
                </.link>

                <button
                  phx-click="delete_session"
                  phx-value-id={s.id}
                  class="opacity-0 group-hover:opacity-100 text-gray-500 hover:text-red-400 p-0.5 rounded transition-smooth"
                  title="Delete Session"
                >
                  <.icon name="hero-trash" class="w-3 h-3" />
                </button>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Sidebar Footer: Settings & User Profile Card (Matching Reference Image) -->
        <div class="p-3 border-t border-[#21262d] bg-[#0d1117] space-y-1.5">
          <div class="px-2 pt-1 text-[10px] font-mono text-gray-500 uppercase tracking-wider font-semibold">
            Settings
          </div>
          <button
            phx-click="toggle_settings_modal"
            class="w-full flex items-center gap-2.5 px-3 py-1.5 rounded-xl text-xs text-gray-400 hover:text-gray-200 hover:bg-[#161b22] transition-smooth text-left"
          >
            <.icon name="hero-key" class="w-3.5 h-3.5 text-gray-400" />
            <span>API & Models</span>
          </button>
          <button
            phx-click="toggle_settings_modal"
            class="w-full flex items-center gap-2.5 px-3 py-1.5 rounded-xl text-xs text-gray-400 hover:text-gray-200 hover:bg-[#161b22] transition-smooth text-left"
          >
            <.icon name="hero-cog-6-tooth" class="w-3.5 h-3.5 text-gray-400" />
            <span>General Settings</span>
          </button>

          <!-- User Profile / OTP Engine Card (Matching Reference Image) -->
          <div
            phx-click="toggle_settings_modal"
            class="mt-2 p-2.5 rounded-2xl bg-[#161b22] border border-[#21262d] hover:border-[#38404a] flex items-center justify-between cursor-pointer transition-smooth group"
          >
            <div class="flex items-center gap-2.5 min-w-0">
              <div class="w-7 h-7 rounded-xl bg-gradient-to-tr from-indigo-500 to-purple-500 flex items-center justify-center text-white font-bold text-xs shrink-0 shadow-sm">
                Z
              </div>
              <div class="min-w-0">
                <div class="text-xs font-semibold text-white truncate leading-tight">zaali</div>
                <div class="text-[10px] font-mono text-emerald-400 flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_6px_rgba(34,197,94,0.8)]"></span>
                  OTP Active
                </div>
              </div>
            </div>
            <.icon
              name="hero-chevron-right"
              class="w-3.5 h-3.5 text-gray-500 group-hover:text-white"
            />
          </div>
        </div>
      </div>
    </aside>

    <!-- Main Workspace Area -->
    <main class="flex-1 flex flex-col h-full min-w-0 bg-[#0a0d12] relative overflow-hidden">
      <!-- Top Navigation Bar & Tab Switchers (Image 1, 3, 4, 5) -->
      <header class="h-14 border-b border-[#21262d] bg-[#11151c] flex items-center justify-between px-5 shrink-0">
        <div class="flex items-center gap-2">
          <!-- Modern Tab Navigation -->
          <div class="flex items-center bg-[#161b22] p-1 rounded-xl border border-[#21262d] gap-1">
            <button
              id="tab-btn-kanban"
              phx-click="switch_tab"
              phx-value-tab="kanban"
              class={[
                "px-3 py-1 rounded-lg text-xs font-mono font-medium flex items-center gap-1.5 transition-smooth",
                @active_tab == "kanban" && "bg-[#21262d] text-white shadow-sm",
                @active_tab != "kanban" && "text-gray-400 hover:text-gray-200"
              ]}
            >
              <.icon name="hero-view-columns" class="w-3.5 h-3.5" /> Kanban
            </button>

            <button
              id="tab-btn-swarm"
              phx-click="switch_tab"
              phx-value-tab="swarm"
              class={[
                "px-3 py-1 rounded-lg text-xs font-mono font-medium flex items-center gap-1.5 transition-smooth",
                @active_tab == "swarm" && "bg-[#21262d] text-white shadow-sm",
                @active_tab != "swarm" && "text-gray-400 hover:text-gray-200"
              ]}
            >
              <.icon name="hero-cpu-chip" class="w-3.5 h-3.5 text-amber-400" /> Swarm
            </button>

            <button
              id="tab-btn-calendar"
              phx-click="switch_tab"
              phx-value-tab="calendar"
              class={[
                "px-3 py-1 rounded-lg text-xs font-mono font-medium flex items-center gap-1.5 transition-smooth",
                @active_tab == "calendar" && "bg-[#21262d] text-white shadow-sm",
                @active_tab != "calendar" && "text-gray-400 hover:text-gray-200"
              ]}
            >
              <.icon name="hero-calendar" class="w-3.5 h-3.5 text-indigo-400" /> Scheduled
            </button>

            <button
              id="tab-btn-changes"
              phx-click="switch_tab"
              phx-value-tab="changes"
              class={[
                "px-3 py-1 rounded-lg text-xs font-mono font-medium flex items-center gap-1.5 transition-smooth",
                @active_tab == "changes" && "bg-[#21262d] text-white shadow-sm",
                @active_tab != "changes" && "text-gray-400 hover:text-gray-200"
              ]}
            >
              <.icon name="hero-code-bracket" class="w-3.5 h-3.5 text-cyan-400" /> Changes
            </button>

            <button
              id="tab-btn-chat"
              phx-click="switch_tab"
              phx-value-tab="chat"
              class={[
                "px-3 py-1 rounded-lg text-xs font-mono font-medium flex items-center gap-1.5 transition-smooth",
                @active_tab == "chat" && "bg-[#21262d] text-white shadow-sm",
                @active_tab != "chat" && "text-gray-400 hover:text-gray-200"
              ]}
            >
              <.icon name="hero-chat-bubble-left-right" class="w-3.5 h-3.5" /> Chat
            </button>

            <button
              id="tab-btn-files"
              phx-click="switch_tab"
              phx-value-tab="files"
              class={[
                "px-3 py-1 rounded-lg text-xs font-mono font-medium flex items-center gap-1.5 transition-smooth",
                @active_tab == "files" && "bg-[#21262d] text-white shadow-sm",
                @active_tab != "files" && "text-gray-400 hover:text-gray-200"
              ]}
            >
              <.icon name="hero-folder" class="w-3.5 h-3.5" /> Files
            </button>

            <button
              id="tab-btn-terminal"
              phx-click="switch_tab"
              phx-value-tab="terminal"
              class={[
                "px-3 py-1 rounded-lg text-xs font-mono font-medium flex items-center gap-1.5 transition-smooth",
                @active_tab == "terminal" && "bg-[#21262d] text-white shadow-sm",
                @active_tab != "terminal" && "text-gray-400 hover:text-gray-200"
              ]}
            >
              <.icon name="hero-command-line" class="w-3.5 h-3.5" /> Terminal
            </button>
          </div>
        </div>

        <!-- Top Right Actions -->
        <div class="flex items-center gap-3">
          <div class="tooltip-trigger">
            <button
              phx-click="toggle_swarm"
              class={[
                "flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-mono font-medium transition-smooth border",
                @session.swarm_mode && "bg-amber-500/10 text-amber-400 border-amber-500/30",
                !@session.swarm_mode &&
                  "bg-[#161b22] text-gray-400 border-[#21262d] hover:text-gray-200"
              ]}
            >
              <.icon name="hero-sparkles" class="w-3.5 h-3.5" />
              <span>Swarm: {if @session.swarm_mode, do: "ON", else: "OFF"}</span>
            </button>
            <div class="luxury-tooltip luxury-tooltip-bottom">
              <div class="text-xs font-semibold text-white tracking-tight mb-1">
                Autonomous Swarm Mode
              </div>
              <div class="flex items-center justify-between text-[11px] font-mono text-gray-400 pt-1 border-t border-white/10">
                <span class="text-gray-300">Supervised OTP Tree</span>
                <span class={
                  if @session.swarm_mode,
                    do: "text-amber-400 font-semibold",
                    else: "text-gray-400"
                }>
                  {if @session.swarm_mode, do: "4 Agents Active", else: "Single Agent"}
                </span>
              </div>
            </div>
          </div>

          <!-- Live Presence & Focus Status Trigger (Image 2) -->
          <div class="tooltip-trigger">
            <button
              id="header-focus-time-btn"
              phx-click="open_time_picker"
              class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-[#161b22] hover:bg-[#1c2128] border border-[#21262d] text-gray-300 hover:text-white text-xs font-mono font-medium transition-smooth cursor-pointer"
            >
              <span class={[
                "w-2 h-2 rounded-full",
                @user_availability == "Available" &&
                  "bg-emerald-400 shadow-[0_0_8px_rgba(34,197,94,0.8)]",
                @user_availability == "Busy" && "bg-red-400 shadow-[0_0_8px_rgba(239,68,68,0.8)]",
                @user_availability == "In-meeting" &&
                  "bg-amber-400 shadow-[0_0_8px_rgba(245,158,11,0.8)]",
                @user_availability == "Offline" && "bg-gray-400"
              ]}></span>
              <span class="text-white font-semibold">{@user_availability}</span>
              <span class="text-gray-500 text-[10px]">· {@selected_time_slot
              |> String.split(" - ")
              |> List.first()}</span>
            </button>
            <div class="luxury-tooltip luxury-tooltip-bottom">
              <div class="text-xs font-semibold text-white tracking-tight mb-1">
                Presence: {@user_availability}
              </div>
              <p class="text-[11px] text-gray-400 mb-1.5 font-sans">
                {@user_availability_subtext}
              </p>
              <div class="flex items-center justify-between text-[11px] font-mono text-gray-400 pt-1 border-t border-white/10">
                <span class="text-gray-300">Slot: {@selected_time_slot}</span>
                <span class="text-blue-400">Click to change</span>
              </div>
            </div>
          </div>

          <div class="tooltip-trigger">
            <button
              phx-click="toggle_new_task_modal"
              class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-[#ff5e3a] hover:bg-[#ff4e24] text-white text-xs font-medium font-mono shadow-md shadow-orange-500/20 transition-smooth"
            >
              <.icon name="hero-plus" class="w-3.5 h-3.5" />
              <span>New Task</span>
            </button>
            <div class="luxury-tooltip luxury-tooltip-bottom">
              <div class="text-xs font-semibold text-white tracking-tight mb-1">
                Create Kanban Task
              </div>
              <div class="flex items-center justify-between text-[11px] font-mono text-gray-400 pt-1 border-t border-white/10">
                <span class="text-gray-300">Dispatch to Swarm</span>
                <span class="text-emerald-400 font-semibold">✦ Ready</span>
              </div>
            </div>
          </div>
        </div>
      </header>

      <!-- View Containers -->
      <div class="flex-1 flex overflow-hidden">
        <!-- TAB 1: KANBAN BOARD (Image 1 & 5) -->
        <%= if @active_tab == "kanban" do %>
          <div class="flex-1 flex flex-col h-full overflow-hidden p-5">
            <!-- Header & Filter Bar (Image 1 & 5) -->
            <div class="flex items-center justify-between mb-4 shrink-0">
              <div class="flex items-center gap-3">
                <h2 class="text-lg font-semibold text-white tracking-tight flex items-center gap-2">
                  Today's tasks
                  <span class="px-2 py-0.5 rounded-full bg-[#1c2128] text-xs font-mono text-gray-400 border border-[#30363d]">
                    {length(@tasks)}
                  </span>
                </h2>
              </div>

              <!-- Filter Bar (Image 5 & Reference Image Styled Dropdowns) -->
              <div class="flex items-center gap-2.5 text-xs font-mono text-gray-400">
                <.form
                  for={to_form(@kanban_filter)}
                  id="kanban-filter-form"
                  phx-change="filter_kanban"
                  class="flex items-center gap-2"
                >
                  <div class="relative">
                    <input
                      type="text"
                      name="search"
                      value={@kanban_filter["search"]}
                      placeholder="Filter cards..."
                      class="bg-[#11151c] border border-[#21262d] rounded-xl px-3 py-1.5 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-gray-400 transition-smooth"
                    />
                  </div>

                  <input type="hidden" name="priority" value={@kanban_filter["priority"]} />
                  <input type="hidden" name="status" value={@kanban_filter["status"]} />
                  <input type="hidden" name="assignee" value={@kanban_filter["assignee"]} />
                </.form>

                <!-- PRIORITY Custom Dropdown (Matching Reference Image) -->
                <div class="relative">
                  <button
                    type="button"
                    phx-click="toggle_dropdown"
                    phx-value-name="priority"
                    class={[
                      "flex items-center gap-1.5 px-3 py-1.5 rounded-xl border text-xs font-mono transition-smooth",
                      @kanban_filter["priority"] != "" &&
                        "bg-amber-500/10 text-amber-300 border-amber-500/30",
                      @kanban_filter["priority"] == "" &&
                        "bg-[#11151c] hover:bg-[#161b22] text-gray-300 border-[#21262d]"
                    ]}
                  >
                    <div class="flex items-end gap-0.5">
                      <span class="w-1 h-1.5 rounded-xs bg-current"></span>
                      <span class="w-1 h-2.5 rounded-xs bg-current"></span>
                      <span class="w-1 h-3.5 rounded-xs bg-current"></span>
                    </div>
                    <span>
                      <%= if @kanban_filter["priority"] != "" do %>
                        {String.upcase(@kanban_filter["priority"])}
                      <% else %>
                        PRIORITY
                      <% end %>
                    </span>
                    <.icon name="hero-chevron-down" class="w-3 h-3 text-gray-400" />
                  </button>

                  <%= if @open_dropdown == "priority" do %>
                    <div class="absolute right-0 top-full mt-2 w-48 bg-[#11151c]/95 border border-[#21262d] rounded-2xl p-1.5 shadow-2xl backdrop-blur-xl z-50 animate-in fade-in zoom-in-95">
                      <button
                        type="button"
                        phx-click="select_kanban_filter"
                        phx-value-key="priority"
                        phx-value-value=""
                        class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs hover:bg-[#1c2128] text-gray-300 transition-smooth"
                      >
                        <span>All Priorities</span>
                        <%= if @kanban_filter["priority"] == "" do %>
                          <.icon name="hero-check" class="w-3.5 h-3.5 text-emerald-400" />
                        <% end %>
                      </button>
                      <%= for p <- ["critical", "high", "medium", "low"] do %>
                        <button
                          type="button"
                          phx-click="select_kanban_filter"
                          phx-value-key="priority"
                          phx-value-value={p}
                          class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs hover:bg-[#1c2128] text-gray-300 transition-smooth"
                        >
                          <div class="flex items-center gap-2">
                            <span class={[
                              "w-2 h-2 rounded-full",
                              p == "critical" && "bg-red-400",
                              p == "high" && "bg-orange-400",
                              p == "medium" && "bg-blue-400",
                              p == "low" && "bg-gray-400"
                            ]}></span>
                            <span class="capitalize">{p}</span>
                          </div>
                          <%= if @kanban_filter["priority"] == p do %>
                            <.icon name="hero-check" class="w-3.5 h-3.5 text-emerald-400" />
                          <% end %>
                        </button>
                      <% end %>
                    </div>
                  <% end %>
                </div>

                <!-- STATUS Custom Dropdown (Matching Reference Image) -->
                <div class="relative">
                  <button
                    type="button"
                    phx-click="toggle_dropdown"
                    phx-value-name="status"
                    class={[
                      "flex items-center gap-1.5 px-3 py-1.5 rounded-xl border text-xs font-mono transition-smooth",
                      @kanban_filter["status"] != "" &&
                        "bg-blue-500/10 text-blue-300 border-blue-500/30",
                      @kanban_filter["status"] == "" &&
                        "bg-[#11151c] hover:bg-[#161b22] text-gray-300 border-[#21262d]"
                    ]}
                  >
                    <span class="text-xs">◌</span>
                    <span>
                      <%= if @kanban_filter["status"] != "" do %>
                        {String.upcase(@kanban_filter["status"])}
                      <% else %>
                        STATUS
                      <% end %>
                    </span>
                    <.icon name="hero-chevron-down" class="w-3 h-3 text-gray-400" />
                  </button>

                  <%= if @open_dropdown == "status" do %>
                    <div class="absolute right-0 top-full mt-2 w-52 bg-[#11151c]/95 border border-[#21262d] rounded-2xl p-1.5 shadow-2xl backdrop-blur-xl z-50 animate-in fade-in zoom-in-95 max-h-72 overflow-y-auto">
                      <button
                        type="button"
                        phx-click="select_kanban_filter"
                        phx-value-key="status"
                        phx-value-value=""
                        class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs hover:bg-[#1c2128] text-gray-300 transition-smooth"
                      >
                        <span>All Statuses</span>
                        <%= if @kanban_filter["status"] == "" do %>
                          <.icon name="hero-check" class="w-3.5 h-3.5 text-emerald-400" />
                        <% end %>
                      </button>
                      <%= for s <- Kanban.Task.statuses() do %>
                        <button
                          type="button"
                          phx-click="select_kanban_filter"
                          phx-value-key="status"
                          phx-value-value={s}
                          class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs hover:bg-[#1c2128] text-gray-300 transition-smooth"
                        >
                          <div class="flex items-center gap-2">
                            <span class={[
                              "w-2 h-2 rounded-full",
                              s == "triage" && "bg-gray-400",
                              s == "todo" && "bg-purple-400",
                              s == "scheduled" && "bg-indigo-400",
                              s == "ready" && "bg-blue-400",
                              s == "running" &&
                                "bg-emerald-400 shadow-[0_0_6px_rgba(34,197,94,0.8)]",
                              s == "blocked" && "bg-red-400",
                              s == "review" && "bg-amber-400",
                              s == "done" && "bg-gray-500"
                            ]}></span>
                            <span class="uppercase tracking-wider">{s}</span>
                          </div>
                          <%= if @kanban_filter["status"] == s do %>
                            <.icon name="hero-check" class="w-3.5 h-3.5 text-emerald-400" />
                          <% end %>
                        </button>
                      <% end %>
                    </div>
                  <% end %>
                </div>

                <!-- ASSIGNEE Custom Dropdown -->
                <div class="relative">
                  <button
                    type="button"
                    phx-click="toggle_dropdown"
                    phx-value-name="assignee"
                    class={[
                      "flex items-center gap-1.5 px-3 py-1.5 rounded-xl border text-xs font-mono transition-smooth",
                      @kanban_filter["assignee"] != "" &&
                        "bg-purple-500/10 text-purple-300 border-purple-500/30",
                      @kanban_filter["assignee"] == "" &&
                        "bg-[#11151c] hover:bg-[#161b22] text-gray-300 border-[#21262d]"
                    ]}
                  >
                    <.icon name="hero-user" class="w-3.5 h-3.5 text-gray-400" />
                    <span>
                      <%= if @kanban_filter["assignee"] != "" do %>
                        {String.upcase(@kanban_filter["assignee"])}
                      <% else %>
                        ASSIGNEE
                      <% end %>
                    </span>
                    <.icon name="hero-chevron-down" class="w-3 h-3 text-gray-400" />
                  </button>

                  <%= if @open_dropdown == "assignee" do %>
                    <div class="absolute right-0 top-full mt-2 w-48 bg-[#11151c]/95 border border-[#21262d] rounded-2xl p-1.5 shadow-2xl backdrop-blur-xl z-50 animate-in fade-in zoom-in-95">
                      <button
                        type="button"
                        phx-click="select_kanban_filter"
                        phx-value-key="assignee"
                        phx-value-value=""
                        class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs hover:bg-[#1c2128] text-gray-300 transition-smooth"
                      >
                        <span>All Assignees</span>
                        <%= if @kanban_filter["assignee"] == "" do %>
                          <.icon name="hero-check" class="w-3.5 h-3.5 text-emerald-400" />
                        <% end %>
                      </button>
                      <%= for a <- ["default", "planner", "coder", "verifier"] do %>
                        <button
                          type="button"
                          phx-click="select_kanban_filter"
                          phx-value-key="assignee"
                          phx-value-value={a}
                          class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs hover:bg-[#1c2128] text-gray-300 transition-smooth"
                        >
                          <div class="flex items-center gap-2">
                            <span class="w-4 h-4 rounded-full bg-[#21262d] text-center font-bold text-[8px] flex items-center justify-center text-white">
                              {String.first(a) |> String.upcase()}
                            </span>
                            <span class="capitalize">{a}</span>
                          </div>
                          <%= if @kanban_filter["assignee"] == a do %>
                            <.icon name="hero-check" class="w-3.5 h-3.5 text-emerald-400" />
                          <% end %>
                        </button>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Agent Rule Explanatory Banner (Image 1) -->
            <div class="mb-4 p-3 bg-[#11151c] border border-[#21262d] rounded-xl text-xs text-gray-400 flex items-center justify-between shrink-0">
              <div class="flex items-center gap-2">
                <span class="text-amber-400">✦</span>
                <span>You don't run the cards — agents do. Put a card in
                <strong class="text-white">Ready</strong>
                with an assignee and an agent picks it up with worker into a proper task first.</span>
              </div>
              <span class="text-gray-500 font-mono text-[11px]">8 Status Columns</span>
            </div>

            <!-- 8 Column Accordion Kanban Grid (Matching Reference Image) -->
            <div
              id="kanban-accordion-container"
              class="flex-1 flex kanban-grid gap-3 h-full overflow-x-auto overflow-y-hidden pb-2 select-none"
            >
              <%= for status <- Kanban.Task.statuses() do %>
                <% column_tasks = Enum.filter(@tasks, &(&1.status == status))
                is_expanded = status == @expanded_column

                dot_color =
                  case status do
                    "triage" -> "bg-gray-400"
                    "todo" -> "bg-purple-400"
                    "scheduled" -> "bg-indigo-400"
                    "ready" -> "bg-blue-400"
                    "running" -> "bg-emerald-400 shadow-[0_0_8px_rgba(34,197,94,0.8)]"
                    "blocked" -> "bg-red-400"
                    "review" -> "bg-amber-400"
                    "done" -> "bg-gray-500"
                  end %>

                <%= if is_expanded do %>
                  <!-- EXPANDED COLUMN (Matching Reference Image) -->
                  <div
                    id={"kanban-col-#{status}"}
                    phx-hook=".KanbanDrag"
                    data-col-status={status}
                    class="kanban-col kanban-col-expanded bg-[#11151c] border border-[#21262d] rounded-2xl flex flex-col h-full overflow-hidden shadow-lg animate-in fade-in"
                  >
                    <!-- Expanded Header -->
                    <div class="p-3 border-b border-[#21262d] flex items-center justify-between shrink-0 bg-[#161b22]/50">
                      <div class="flex items-center gap-2 font-mono text-xs font-semibold text-gray-200">
                        <span class={["w-2 h-2 rounded-full", dot_color]}></span>
                        <span class="uppercase tracking-wider">{String.upcase(status)}</span>
                        <span class="text-gray-500 font-normal text-[11px]">{length(column_tasks)}</span>
                      </div>
                      <button
                        phx-click="toggle_column"
                        phx-value-status={status}
                        class="text-gray-500 hover:text-white p-1 rounded-lg transition-smooth"
                        title="Collapse section"
                      >
                        <.icon name="hero-chevron-left" class="w-3.5 h-3.5" />
                      </button>
                    </div>

                    <!-- Cards List -->
                    <div class="flex-1 overflow-y-auto p-3 space-y-3">
                      <%= if column_tasks == [] do %>
                        <div class="h-32 border border-dashed border-[#21262d] rounded-xl flex items-center justify-center text-gray-500 font-mono text-[11px]">
                          Drop task here to move to {status}
                        </div>
                      <% end %>

                      <%= for task <- column_tasks do %>
                        <div
                          id={"task-card-#{task.id}"}
                          phx-click="open_task_drawer"
                          phx-value-id={task.id}
                          phx-hook=".KanbanCard"
                          data-task-id={task.id}
                          draggable="true"
                          class={[
                            "bg-[#11151c] hover:bg-[#161b22] border border-[#21262d] hover:border-[#38404a] p-4 rounded-2xl cursor-grab active:cursor-grabbing transition-smooth group relative shadow-md",
                            task.status == "running" && "card-running-glow"
                          ]}
                        >
                          <!-- Card Header (Matching Reference Image): Signal Bars / Pie Status / ID & Stats -->
                          <div class="flex items-center justify-between mb-2.5">
                            <div class="flex items-center gap-2">
                              <!-- Priority Signal Bars -->
                              <div
                                class="flex items-end gap-0.5 px-1.5 py-1 rounded-md bg-[#1c2128]"
                                title={"Priority: #{task.priority}"}
                              >
                                <span class={[
                                  "w-1 h-1.5 rounded-xs",
                                  task.priority in ["low", "medium", "high", "critical"] &&
                                    "bg-amber-400",
                                  task.priority not in ["low", "medium", "high", "critical"] &&
                                    "bg-gray-600"
                                ]}></span>
                                <span class={[
                                  "w-1 h-2.5 rounded-xs",
                                  task.priority in ["medium", "high", "critical"] &&
                                    "bg-amber-400",
                                  task.priority not in ["medium", "high", "critical"] &&
                                    "bg-gray-600"
                                ]}></span>
                                <span class={[
                                  "w-1 h-3.5 rounded-xs",
                                  task.priority in ["high", "critical"] && "bg-amber-400",
                                  task.priority not in ["high", "critical"] && "bg-gray-600"
                                ]}></span>
                              </div>

                              <!-- Pie / Status Icon -->
                              <span class="text-gray-400 text-xs">◐</span>

                              <!-- Task ID Hash -->
                              <span class="font-mono text-xs text-gray-300 font-semibold tracking-tight">
                                #{String.slice(task.id, 0..5)}
                              </span>
                            </div>

                            <!-- Right Side: Comments / Attachments / Worker PID -->
                            <div class="flex items-center gap-2 text-gray-400 text-[11px] font-mono">
                              <%= if task.worker_pid do %>
                                <span class="text-[10px] text-emerald-400 bg-emerald-500/10 px-1.5 py-0.5 rounded border border-emerald-500/20">
                                  pid {task.worker_pid}
                                </span>
                              <% end %>
                              <span class="flex items-center gap-1 hover:text-gray-200">
                                <.icon name="hero-chat-bubble-left" class="w-3.5 h-3.5" /> 12
                              </span>
                              <span class="flex items-center gap-1 hover:text-gray-200">
                                <.icon name="hero-paper-clip" class="w-3.5 h-3.5" /> 6
                              </span>
                            </div>
                          </div>

                          <!-- Title (Matching Reference Image) -->
                          <h4 class="text-sm font-semibold text-white group-hover:text-amber-200 transition-smooth mb-3 leading-snug">
                            {task.title}
                          </h4>

                          <!-- Segmented Progress Bar (Matching Reference Image) -->
                          <div class="flex items-center gap-2.5 mb-3.5">
                            <span class="px-2 py-0.5 rounded-md bg-[#1c2128] text-[11px] font-mono text-gray-300 font-medium shrink-0">
                              {task.steps_completed}/{max(task.steps_total, 1)}
                            </span>
                            <div class="flex-1 flex gap-1.5 h-1.5">
                              <%= for step <- 1..max(task.steps_total, 1) do %>
                                <div class={[
                                  "flex-1 rounded-full transition-all duration-300",
                                  step <= task.steps_completed &&
                                    "bg-emerald-400 shadow-[0_0_8px_rgba(34,197,94,0.7)]",
                                  step > task.steps_completed && "bg-[#21262d]"
                                ]}>
                                </div>
                              <% end %>
                            </div>
                          </div>

                          <!-- Footer Tags (Matching Reference Image) -->
                          <div class="flex items-center gap-2 pt-2 border-t border-[#21262d]/60 text-xs">
                            <span class="px-2.5 py-1 rounded-xl bg-[#1c2128] text-gray-300 font-medium text-[11px]">
                              FinPay
                            </span>
                            <span class="px-2.5 py-1 rounded-xl bg-[#2b1810] text-[#ff5e3a] font-medium text-[11px] flex items-center gap-1.5 border border-[#ff5e3a]/20">
                              <span class="w-1.5 h-1.5 rounded-full bg-[#ff5e3a]"></span> Bug
                            </span>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  </div>
                <% else %>
                  <!-- COLLAPSED VERTICAL RIBBON (Matching Reference Image) -->
                  <div
                    id={"kanban-col-#{status}"}
                    phx-click="toggle_column"
                    phx-value-status={status}
                    phx-hook=".KanbanDrag"
                    data-col-status={status}
                    class="kanban-col kanban-col-collapsed bg-[#11151c] hover:bg-[#161b22] border border-[#21262d] hover:border-[#38404a] rounded-2xl flex flex-col items-center justify-between py-5 group shadow-sm transition-smooth"
                    title={"Click or drag over to open #{status}"}
                  >
                    <!-- Status Dot -->
                    <span class={[
                      "w-2 h-2 rounded-full shrink-0 group-hover:scale-125 transition-smooth",
                      dot_color
                    ]}></span>

                    <!-- Rotated Vertical Text (Matching Reference Image) -->
                    <div class="vertical-text font-mono text-xs font-semibold text-gray-400 group-hover:text-gray-200 uppercase tracking-widest my-auto py-4">
                      {status}
                    </div>

                    <!-- Count Badge -->
                    <span class="text-[10px] font-mono text-gray-500 group-hover:text-gray-300 font-bold shrink-0">
                      {length(column_tasks)}
                    </span>
                  </div>
                <% end %>
              <% end %>
            </div>

            <!-- Colocated Hook for Smooth Drag & Drop Auto-Expansion & Decreased Drag Ghost Size -->
            <script :type={Phoenix.LiveView.ColocatedHook} name=".KanbanDrag">
              export default {
                mounted() {
                  this.el.addEventListener("dragover", e => {
                    e.preventDefault();
                    e.dataTransfer.dropEffect = "move";
                    const colStatus = this.el.dataset.colStatus;
                    if (colStatus && this.el.classList.contains("kanban-col-collapsed")) {
                      this.pushEvent("set_expanded_column", { status: colStatus });
                    }
                  });

                  this.el.addEventListener("drop", e => {
                    e.preventDefault();
                    const taskId = e.dataTransfer.getData("text/plain");
                    const targetStatus = this.el.dataset.colStatus;
                    if (taskId && targetStatus) {
                      this.pushEvent("move_task", { id: taskId, status: targetStatus });
                    }
                  });
                }
              }
            </script>

            <script :type={Phoenix.LiveView.ColocatedHook} name=".KanbanCard">
              export default {
                mounted() {
                  this.el.addEventListener("dragstart", e => {
                    const taskId = this.el.dataset.taskId;
                    e.dataTransfer.setData("text/plain", taskId);
                    e.dataTransfer.effectAllowed = "move";

                    // Create compact decreased-size drag preview ghost
                    const ghost = this.el.cloneNode(true);
                    ghost.id = "kanban-drag-ghost";
                    ghost.style.position = "fixed";
                    ghost.style.top = "-9999px";
                    ghost.style.left = "-9999px";
                    ghost.style.width = "200px";
                    ghost.style.maxWidth = "200px";
                    ghost.style.transform = "scale(0.72)";
                    ghost.style.transformOrigin = "top left";
                    ghost.style.opacity = "0.95";
                    ghost.style.borderRadius = "0.75rem";
                    ghost.style.boxShadow = "0 20px 25px -5px rgba(0, 0, 0, 0.8), 0 0 15px rgba(59, 130, 246, 0.4)";
                    ghost.style.pointerEvents = "none";
                    ghost.style.zIndex = "99999";
                    document.body.appendChild(ghost);

                    e.dataTransfer.setDragImage(ghost, 100, 25);

                    setTimeout(() => {
                      if (ghost.parentNode) ghost.parentNode.removeChild(ghost);
                      this.el.classList.add("card-dragging");
                    }, 0);
                  });

                  this.el.addEventListener("dragend", () => {
                    this.el.classList.remove("card-dragging");
                  });
                }
              }
            </script>
          </div>
        <% end %>

        <!-- TAB 2: SWARM 4-COLUMN CARDS, AGENT OVERVIEW & OPERATION TREE (Matching Reference Image & F5/F6) -->
        <%= if @active_tab == "swarm" do %>
          <div class="flex-1 flex flex-col h-full overflow-y-auto p-5 space-y-6">
            <!-- Agent Overview Card (Matching Reference Image media_1787240812268.png) -->
            <div class="bg-[#11151c] border border-[#21262d] rounded-3xl p-6 shadow-2xl relative">
              <!-- Top Header Row -->
              <div class="flex items-center justify-between mb-5">
                <div class="flex items-center gap-2">
                  <h3 class="text-sm font-semibold text-white tracking-tight">Agent overview</h3>
                </div>
                <div class="flex items-center gap-2 bg-[#161b22] px-3 py-1 rounded-full border border-[#21262d] text-xs text-gray-300 font-mono">
                  <span class="w-4 h-4 rounded-full bg-indigo-500/20 text-indigo-400 font-bold text-[9px] flex items-center justify-center">
                    Z
                  </span>
                  <span>Owner: zaali</span>
                </div>
              </div>

              <!-- Main Agent Info Box -->
              <div class="bg-[#161b22]/70 border border-[#21262d] rounded-2xl p-5 mb-4 relative">
                <!-- Status Badge Top Right -->
                <div class="absolute top-5 right-5 flex items-center gap-1.5 text-emerald-400 text-xs font-mono font-semibold">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(34,197,94,0.8)] animate-pulse"></span>
                  <span>ACTIVE</span>
                </div>

                <div class="flex items-start gap-4">
                  <!-- Pixel Avatar Graphic (Matching Reference Image) -->
                  <div class="w-16 h-16 rounded-2xl bg-gradient-to-b from-[#1c2128] to-[#11151c] border border-[#30363d] flex items-center justify-center text-3xl shadow-inner shrink-0 relative overflow-hidden">
                    <span class="animate-bounce">🧙‍♂️</span>
                    <div class="absolute bottom-1 left-2 right-2 h-1 bg-indigo-500/40 rounded-full blur-[1px]">
                    </div>
                  </div>

                  <!-- Name, Role & Connected Integrations -->
                  <div class="flex-1 min-w-0">
                    <h2 class="text-2xl font-bold text-white tracking-tight">
                      Milo
                    </h2>
                    <div class="text-xs font-mono text-gray-400 uppercase tracking-wider mb-3">
                      EXECUTIVE CODING HARNESS ASSISTANT
                    </div>

                    <!-- Integration Badges -->
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="px-2.5 py-1 rounded-xl bg-[#11151c] border border-[#21262d] text-xs font-mono text-gray-300 flex items-center gap-1.5">
                        <span class="text-red-400">✉</span> Gmail
                      </span>
                      <span class="px-2.5 py-1 rounded-xl bg-[#11151c] border border-[#21262d] text-xs font-mono text-gray-300 flex items-center gap-1.5">
                        <span class="text-blue-400">📅</span> Google Calendar
                      </span>
                      <span class="px-2.5 py-1 rounded-xl bg-[#11151c] border border-[#21262d] text-xs font-mono text-gray-300 flex items-center gap-1.5">
                        <span class="text-gray-300">📓</span> Notion
                      </span>
                      <span class="px-2 py-1 rounded-xl bg-[#11151c] border border-[#21262d] text-xs font-mono text-gray-400 font-semibold">
                        +2
                      </span>
                    </div>
                  </div>
                </div>

                <!-- Current Task & Tally Tick Progress Bar (Matching Reference Image) -->
                <div class="mt-6 pt-5 border-t border-dashed border-[#21262d]">
                  <div class="text-[10px] font-mono text-gray-400 uppercase tracking-wider mb-2.5">
                    CURRENT TASK
                  </div>

                  <!-- Tally Hash Vertical Tick Bar -->
                  <div class="tally-tick-bar mb-2.5">
                    <%= for tick <- 1..65 do %>
                      <div class={[
                        "tally-tick",
                        tick <= 36 && "tally-tick-active-orange",
                        tick > 36 && "bg-[#21262d]"
                      ]}>
                      </div>
                    <% end %>
                  </div>

                  <div class="flex items-center justify-between font-mono text-xs">
                    <span class="font-semibold text-white tracking-wide">
                      GENERATE FOLLOW-UP EMAILS & CODE PATCHES
                    </span>
                    <span class="text-gray-400">
                      3.2K TOKENS · 18ms
                    </span>
                  </div>
                </div>
              </div>

              <!-- Footer Actions Row -->
              <div class="flex items-center justify-between pt-2 text-xs font-mono text-gray-400">
                <div class="flex items-center gap-3">
                  <button class="p-1.5 rounded-lg hover:bg-[#161b22] text-gray-400 hover:text-white transition-smooth">
                    <.icon name="hero-ellipsis-vertical" class="w-4 h-4" />
                  </button>
                  <button class="p-1.5 rounded-lg hover:bg-[#161b22] text-gray-400 hover:text-white transition-smooth">
                    <.icon name="hero-command-line" class="w-4 h-4" />
                  </button>
                  <button class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#161b22] hover:bg-[#21262d] text-gray-300 transition-smooth">
                    <span>⏸</span> <span>PAUSE</span>
                  </button>
                </div>

                <div class="flex items-center gap-3">
                  <span class="text-gray-500 text-[11px]">LAST ACTIVE: JUST NOW</span>
                  <button
                    phx-click="switch_tab"
                    phx-value-tab="kanban"
                    class="px-4 py-1.5 rounded-full border border-white/20 hover:bg-white/10 text-white text-xs font-medium transition-smooth"
                  >
                    View details
                  </button>
                </div>
              </div>
            </div>

            <.subagent_cards
              operations={@operations}
              active_agent={@active_agent}
              active_stage={@active_stage}
              swarm_mode={@session.swarm_mode}
            />
            <.operation_tree
              operations={@operations}
              expanded_ops={@expanded_ops}
            />
          </div>
        <% end %>

        <!-- TAB 3: SCHEDULED TASKS & CALENDAR VIEW (Matching Reference Image media_1787240886279.jpg) -->
        <%= if @active_tab == "calendar" do %>
          <div class="flex-1 flex flex-col h-full overflow-y-auto p-5 space-y-5">
            <!-- Centered Luxury Dark Calendar Container (Matching Reference Image) -->
            <div class="bg-[#11151c] border border-[#21262d] rounded-3xl p-6 shadow-2xl max-w-4xl w-full mx-auto">
              <!-- Calendar Header Row -->
              <div class="flex items-center justify-between mb-6">
                <div class="flex items-center gap-3">
                  <h2 class="text-xl font-bold text-white tracking-tight font-sans">
                    August, 2026
                  </h2>
                  <button class="px-3 py-1 rounded-full bg-[#1c2128] border border-[#30363d] text-xs font-mono text-gray-300 hover:text-white transition-smooth">
                    Today
                  </button>
                  <div class="flex items-center gap-1 text-gray-400">
                    <button class="p-1 rounded-lg hover:bg-[#1c2128] text-gray-400 hover:text-white transition-smooth">
                      <.icon name="hero-chevron-left" class="w-4 h-4" />
                    </button>
                    <button class="p-1 rounded-lg hover:bg-[#1c2128] text-gray-400 hover:text-white transition-smooth">
                      <.icon name="hero-chevron-right" class="w-4 h-4" />
                    </button>
                  </div>
                </div>

                <!-- Header Actions -->
                <div class="flex items-center gap-2">
                  <button
                    id="calendar-focus-time-btn"
                    phx-click="open_time_picker"
                    class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#1c2128] hover:bg-[#21262d] border border-[#30363d] text-xs font-mono text-gray-300 hover:text-white transition-smooth"
                    title="Set focus time and availability window"
                  >
                    <.icon name="hero-clock" class="w-3.5 h-3.5 text-blue-400" />
                    <span>Set Focus Time</span>
                  </button>

                  <!-- Primary Coral Plus Trigger -->
                  <button
                    phx-click="toggle_new_task_modal"
                    class="w-9 h-9 rounded-full bg-[#ff5e3a] hover:bg-[#ff4e24] text-white flex items-center justify-center shadow-lg shadow-orange-500/25 transition-smooth"
                    title="Schedule New Task"
                  >
                    <.icon name="hero-plus" class="w-5 h-5" />
                  </button>
                </div>
              </div>

              <!-- Day of Week Headers -->
              <div class="grid grid-cols-7 gap-2 mb-2 text-center">
                <%= for day_name <- ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"] do %>
                  <div class="py-1.5 rounded-xl bg-[#1c2128]/60 text-[10px] font-mono font-semibold text-gray-400 tracking-wider">
                    {day_name}
                  </div>
                <% end %>
              </div>

              <!-- 5-Week Monthly Calendar Grid (Matching Reference Image) -->
              <div class="grid grid-cols-7 gap-2">
                <!-- Prev Month Dimmed (July 29, 30, 31) -->
                <div class="min-h-[76px] rounded-2xl bg-[#11151c]/40 border border-[#21262d]/50 p-2 text-gray-600 font-mono text-xs">
                  29
                </div>
                <div class="min-h-[76px] rounded-2xl bg-[#11151c]/40 border border-[#21262d]/50 p-2 text-gray-600 font-mono text-xs">
                  30
                </div>
                <div class="min-h-[76px] rounded-2xl bg-[#11151c]/40 border border-[#21262d]/50 p-2 text-gray-600 font-mono text-xs">
                  31
                </div>

                <!-- Active August Days 1..31 -->
                <%= for day <- 1..31 do %>
                  <% day_tasks = tasks_for_day(@tasks, day)
                  is_today = day == 20
                  is_selected = day == @selected_calendar_day
                  date_str = "2026-08-" <> String.pad_leading("#{day}", 2, "0") %>
                  <div
                    id={"calendar-day-#{day}"}
                    phx-click="select_calendar_day"
                    phx-value-day={day}
                    phx-value-date={date_str}
                    class={[
                      "min-h-[76px] rounded-2xl p-2 transition-smooth cursor-pointer flex flex-col justify-between group",
                      is_today &&
                        "bg-[#1c2128] border-2 border-[#ff5e3a] shadow-lg shadow-orange-500/10",
                      is_selected && !is_today && "bg-[#1c2128] border border-[#ff5e3a]/60",
                      !is_today && !is_selected &&
                        "bg-[#161b22] border border-[#21262d] hover:border-[#38404a] hover:bg-[#1a2029]"
                    ]}
                    title={"Click to schedule task on August #{day}, 2026"}
                  >
                    <!-- Day Header Row -->
                    <div class="flex items-center justify-between pointer-events-none">
                      <span class={[
                        "font-mono text-xs",
                        is_today && "font-bold text-[#ff5e3a]",
                        !is_today && "text-gray-400 group-hover:text-white"
                      ]}>
                        {day}
                      </span>
                      <%= if is_today do %>
                        <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_6px_rgba(34,197,94,0.8)]"></span>
                      <% else %>
                        <%= if day_tasks != [] do %>
                          <span class="w-1.5 h-1.5 rounded-full bg-purple-400 shadow-[0_0_4px_rgba(168,85,247,0.6)]"></span>
                        <% end %>
                      <% end %>
                    </div>

                    <!-- Tasks on this Day -->
                    <div class="space-y-1 my-auto">
                      <%= for task <- day_tasks do %>
                        <button
                          type="button"
                          id={"calendar-task-#{day}-#{task.id}"}
                          phx-click="show_scheduled_task"
                          phx-value-id={task.id}
                          class="w-full text-left py-0.5 px-1.5 rounded-lg bg-[#21262d] hover:bg-[#2c333d] border border-white/10 text-[10px] font-mono text-gray-200 transition-smooth flex items-center justify-between shadow-xs truncate"
                          title={task.title}
                        >
                          <span class="truncate font-semibold">{task.title}</span>
                          <span class="text-orange-400 text-[9px] shrink-0 ml-1">✦</span>
                        </button>
                      <% end %>
                    </div>

                    <!-- Day Subtitle / Status -->
                    <div class="text-[9px] font-mono text-gray-500 pointer-events-none">
                      <%= if is_today do %>
                        <span class="text-emerald-400 font-semibold">Live</span>
                      <% else %>
                        <%= if day_tasks == [] do %>
                          <span class="opacity-0 group-hover:opacity-100 text-gray-400 transition-smooth">+ Add</span>
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                <% end %>

                <!-- Next Month Dimmed (Sept 1) -->
                <div class="min-h-[76px] rounded-2xl bg-[#11151c]/40 border border-[#21262d]/50 p-2 text-gray-600 font-mono text-xs">
                  1
                </div>
              </div>

              <!-- Calendar Footer Bar (Matching Reference Image) -->
              <div class="mt-6 pt-4 border-t border-[#21262d] flex items-center justify-between text-xs font-mono text-gray-400">
                <div class="flex items-center gap-4">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-purple-400"></span>
                    <span>ONE-SHOT TIMER</span>
                  </div>
                  <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                    <span>CRON RECURRING</span>
                  </div>
                </div>

                <div class="flex items-center gap-6">
                  <span>9 SCHEDULED TASKS · 3 ACTIVE</span>
                  <span class="text-white font-semibold">MONTHLY RUNS: 1,420</span>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <!-- TAB 4: CHANGES & CANVAS SPLIT TREE (Image 4 & F7) -->
        <%= if @active_tab == "changes" do %>
          <div class="flex-1 flex h-full overflow-hidden">
            <!-- Left Changes Tree (Image 4) -->
            <div class="w-1/3 border-r border-[#21262d] bg-[#11151c] flex flex-col h-full overflow-hidden shrink-0">
              <!-- Subtabs: Changes | All files | Desktop -->
              <div class="p-3 border-b border-[#21262d] flex items-center justify-between">
                <div class="flex items-center bg-[#161b22] p-1 rounded-lg border border-[#21262d] text-xs font-mono">
                  <button
                    phx-click="switch_changes_subtab"
                    phx-value-tab="changes"
                    class={[
                      "px-2.5 py-0.5 rounded font-medium",
                      @changes_subtab == "changes" && "bg-[#21262d] text-white",
                      @changes_subtab != "changes" && "text-gray-400"
                    ]}
                  >
                    Changes
                  </button>
                  <button
                    phx-click="switch_changes_subtab"
                    phx-value-tab="all"
                    class={[
                      "px-2.5 py-0.5 rounded font-medium",
                      @changes_subtab == "all" && "bg-[#21262d] text-white",
                      @changes_subtab != "all" && "text-gray-400"
                    ]}
                  >
                    All files
                  </button>
                  <button
                    phx-click="switch_changes_subtab"
                    phx-value-tab="desktop"
                    class={[
                      "px-2.5 py-0.5 rounded font-medium",
                      @changes_subtab == "desktop" && "bg-[#21262d] text-white",
                      @changes_subtab != "desktop" && "text-gray-400"
                    ]}
                  >
                    Desktop
                  </button>
                </div>

                <div class="flex items-center gap-1.5 font-mono text-xs">
                  <span class="text-emerald-400 font-bold">+17</span>
                  <span class="text-red-400 font-bold">-8</span>
                </div>
              </div>

              <!-- Changes File Hierarchy (Image 4) -->
              <div class="flex-1 overflow-y-auto p-4 space-y-1 font-mono text-xs">
                <div class="text-gray-400 font-semibold mb-2 flex items-center justify-between">
                  <span>All Changes</span>
                  <span class="text-[11px] text-gray-500">6 files</span>
                </div>

                <div class="space-y-1 pl-2">
                  <div class="flex items-center justify-between py-1 px-2 rounded hover:bg-[#161b22] cursor-pointer">
                    <span class="text-gray-300">⌄ lib/iex_code/engine/</span>
                    <span class="text-gray-500">0</span>
                  </div>
                  <div class="flex items-center justify-between py-1 pl-6 pr-2 rounded hover:bg-[#161b22] cursor-pointer">
                    <span class="text-emerald-300">ex swarm_coordinator.ex</span>
                    <span class="text-emerald-400 font-bold">+12</span>
                  </div>
                  <div class="flex items-center justify-between py-1 pl-6 pr-2 rounded hover:bg-[#161b22] cursor-pointer">
                    <span class="text-red-300">ex verifier_agent.ex</span>
                    <span class="text-red-400 font-bold">-4</span>
                  </div>
                  <div class="flex items-center justify-between py-1 pl-6 pr-2 rounded hover:bg-[#161b22] cursor-pointer">
                    <span class="text-emerald-300">ex auto_fix.ex</span>
                    <span class="text-emerald-400 font-bold">+8</span>
                  </div>

                  <div class="flex items-center justify-between py-1 px-2 rounded hover:bg-[#161b22] cursor-pointer">
                    <span class="text-gray-300">⌄ lib/iex_code/kanban/</span>
                    <span class="text-gray-500">0</span>
                  </div>
                  <div class="flex items-center justify-between py-1 pl-6 pr-2 rounded hover:bg-[#161b22] cursor-pointer">
                    <span class="text-emerald-300">ex task.ex</span>
                    <span class="text-emerald-400 font-bold">+52</span>
                  </div>
                </div>

                <div class="mt-4 pt-3 border-t border-[#21262d]">
                  <div class="text-xs font-semibold text-gray-400 mb-2">Canvas · 4</div>
                  <div class="space-y-1 text-[11px]">
                    <div class="p-2 bg-[#161b22] rounded text-gray-300">
                      pr-1781-walkthrough.html
                    </div>
                    <div class="p-2 bg-[#161b22] rounded text-gray-300">rt-412-march.html</div>
                    <div class="p-2 bg-[#161b22] rounded text-gray-300">
                      pr-5567-proof-of-history.html
                    </div>
                    <div class="p-2 bg-[#161b22] rounded text-gray-300">
                      pr-22-toll-express.html
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Right Interactive Diff Viewer (F7) -->
            <div class="flex-1 flex flex-col h-full overflow-hidden p-3 bg-[#0a0d12]">
              <.diff_viewer
                diff_text={@diff_text}
                diff_mode={@diff_mode}
                file_path={@diff_file_path}
              />
            </div>
          </div>
        <% end %>

        <!-- TAB 5: CHAT WITH SCROLL ASSISTANT MINIMAP (Matching Reference Images media_1787243221945.png, media_1787243229747.png, media_1787243238460.png) -->
        <%= if @active_tab == "chat" do %>
          <div class="flex-1 flex h-full overflow-hidden relative">
            <!-- Left Rail: Chat Scroll Assistant Minimap & Hover Preview Cards -->
            <div class="w-12 pl-2.5 py-6 shrink-0 flex flex-col items-start z-30 select-none border-r border-[#21262d]/40">
              <div class="scroll-assistant-rail">
                <div class="scroll-timeline-track" id="chat-timeline-track">
                  <%= for {msg, idx} <- Enum.with_index(@messages) do %>
                    <% msg_id = msg.id || "msg-#{idx}"
                    is_user = msg.role == "user"

                    preview_title =
                      if is_user,
                        do:
                          msg.content |> String.split("\n") |> List.first() |> String.slice(0, 40),
                        else: msg.agent_name || "Assistant Response"

                    preview_snippet = msg.content |> String.slice(0, 140) %>
                    <div
                      id={"scroll-node-#{msg_id}"}
                      class={[
                        "scroll-timeline-node group",
                        idx == 0 && "is-active"
                      ]}
                      data-target-msg-id={msg_id}
                      onclick={"const el = document.getElementById('chat-msg-#{msg_id}'); if (el) { el.scrollIntoView({ behavior: 'smooth', block: 'center' }); }"}
                      title={"Jump to message ##{idx + 1}"}
                    >
                      <!-- Timeline Tick / Notch (Matching Reference Image) -->
                      <div class={[
                        "scroll-notch",
                        is_user && "scroll-notch-landmark"
                      ]}>
                      </div>

                      <!-- Hover Floating Preview Card (Matching Reference Image media_1787243229747.png) -->
                      <div class="scroll-preview-card">
                        <div class="flex items-center justify-between mb-1.5 pb-1 border-b border-white/10">
                          <span class="text-[10px] font-mono font-bold text-gray-400 uppercase tracking-wider flex items-center gap-1.5">
                            <span class={[
                              "w-1.5 h-1.5 rounded-full",
                              is_user && "bg-blue-400",
                              !is_user && "bg-purple-400"
                            ]}></span>
                            {if is_user, do: "User Prompt", else: msg.agent_name || "Assistant"}
                          </span>
                          <span class="text-[9px] font-mono text-gray-500">#{idx + 1}</span>
                        </div>
                        <div class="text-xs font-semibold text-white tracking-tight leading-snug mb-1 truncate">
                          {preview_title}
                        </div>
                        <div class="text-[11px] font-sans text-gray-400 line-clamp-3 leading-relaxed">
                          {preview_snippet}
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Main Chat Messages Viewport (Matching Reference Image Layout) -->
            <div
              id="chat-viewport"
              phx-hook=".ChatScrollAssistant"
              class="flex-1 flex flex-col h-full overflow-y-auto p-6 space-y-6 scroll-smooth"
            >
              <%= for {msg, idx} <- Enum.with_index(@messages) do %>
                <% msg_id = msg.id || "msg-#{idx}"
                is_user = msg.role == "user" %>
                <div
                  id={"chat-msg-#{msg_id}"}
                  data-chat-msg-id={msg_id}
                  class={[
                    "w-full max-w-3xl transition-smooth group",
                    is_user && "ml-auto",
                    !is_user && "mr-auto"
                  ]}
                >
                  <!-- Message Bubble (Matching Reference Images) -->
                  <div class={[
                    "p-5 rounded-2xl border text-xs shadow-md transition-smooth",
                    is_user && "bg-[#161b22] border-[#30363d] text-white",
                    !is_user && "bg-[#11151c] border-[#21262d] text-gray-200"
                  ]}>
                    <!-- Bubble Header -->
                    <div class="flex items-center justify-between mb-2 text-[11px] font-mono text-gray-400 pb-1.5 border-b border-white/5">
                      <div class="flex items-center gap-2">
                        <span class={[
                          "w-2 h-2 rounded-full",
                          is_user && "bg-blue-400",
                          !is_user && "bg-emerald-400"
                        ]}></span>
                        <span class="font-bold text-gray-300 uppercase tracking-wider">{msg.agent_name ||
                          msg.role}</span>
                      </div>
                      <span class="text-gray-500 text-[10px]">#{idx + 1}</span>
                    </div>

                    <!-- Message Body -->
                    <div class="whitespace-pre-wrap font-sans text-sm leading-relaxed text-gray-200">
                      {msg.content}
                    </div>

                    <!-- Bubble Footer Action Bar (Image 1 bottom left) -->
                    <%= if !is_user do %>
                      <div class="flex items-center gap-3 pt-3 mt-3 border-t border-white/5 text-gray-500">
                        <button
                          class="hover:text-gray-300 p-1 rounded transition-smooth"
                          title="Copy to clipboard"
                        >
                          <.icon name="hero-clipboard" class="w-3.5 h-3.5" />
                        </button>
                        <button
                          class="hover:text-gray-300 p-1 rounded transition-smooth"
                          title="Expand message"
                        >
                          <.icon name="hero-arrows-pointing-out" class="w-3.5 h-3.5" />
                        </button>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>

          <script :type={Phoenix.LiveView.ColocatedHook} name=".ChatScrollAssistant">
            export default {
              mounted() {
                const container = this.el;
                const updateActiveNotch = () => {
                  const messages = container.querySelectorAll('[data-chat-msg-id]');
                  let activeId = null;
                  const containerRect = container.getBoundingClientRect();

                  messages.forEach(msg => {
                    const rect = msg.getBoundingClientRect();
                    if (rect.top <= containerRect.top + 200 && rect.bottom >= containerRect.top) {
                      activeId = msg.getAttribute('data-chat-msg-id');
                    }
                  });

                  if (activeId) {
                    document.querySelectorAll('.scroll-timeline-node').forEach(node => {
                      if (node.getAttribute('data-target-msg-id') === activeId) {
                        node.classList.add('is-active');
                      } else {
                        node.classList.remove('is-active');
                      }
                    });
                  }
                };

                container.addEventListener('scroll', updateActiveNotch, { passive: true });
                updateActiveNotch();

                this.handleEvent('scroll_to_msg', ({ id }) => {
                  const target = document.getElementById('chat-msg-' + id);
                  if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'center' });
                  }
                });
              }
            }
          </script>
        <% end %>

        <!-- TAB 6: FILES TREE EXPLORER & PREVIEW (F8) -->
        <%= if @active_tab == "files" do %>
          <.file_explorer
            files={@project_files}
            filter={@file_filter}
            selected_file={@selected_file}
            file_content={@file_content}
          />
        <% end %>

        <!-- TAB 7: TERMINAL SESSION RUNNER (F9) -->
        <div class={[
          "flex-1 flex flex-col h-full bg-[#0a0d12] overflow-hidden",
          @active_tab != "terminal" && "hidden"
        ]}>
          <.terminal_session
            output={@terminal_output}
            form={@terminal_form}
          />
        </div>

        <!-- RIGHT TASK DETAIL DRAWER / INSPECTOR (Image 1) -->
        <%= if @show_task_drawer and @selected_task do %>
          <div class="w-96 border-l border-[#21262d] bg-[#11151c] flex flex-col h-full overflow-y-auto shrink-0 transition-smooth animate-in slide-in-from-right">
            <!-- Drawer Header -->
            <div class="p-4 border-b border-[#21262d] flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class={[
                  "px-2 py-0.5 rounded-full text-[10px] font-mono uppercase font-bold flex items-center gap-1.5",
                  @selected_task.status == "running" &&
                    "bg-emerald-500/10 text-emerald-400 border border-emerald-500/30",
                  @selected_task.status != "running" &&
                    "bg-gray-500/10 text-gray-400 border border-gray-500/30"
                ]}>
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  {@selected_task.status}
                </span>
                <span class="font-mono text-xs text-gray-500">#{String.slice(
                  @selected_task.id,
                  0..5
                )}</span>
              </div>
              <button
                phx-click="close_task_drawer"
                class="text-gray-400 hover:text-white p-1 rounded-lg"
              >
                <.icon name="hero-x-mark" class="w-4 h-4" />
              </button>
            </div>

            <!-- Drawer Body -->
            <div class="p-5 space-y-5 flex-1">
              <!-- Task Title -->
              <div>
                <h3 class="text-base font-bold text-white tracking-tight leading-snug">
                  {@selected_task.title}
                </h3>
              </div>

              <!-- Metadata Grid (Image 1) -->
              <div class="space-y-2.5 font-mono text-xs pt-3 border-t border-[#21262d]">
                <div class="flex justify-between">
                  <span class="text-gray-400">Assignee</span>
                  <span class="text-white font-medium flex items-center gap-1">
                    <span class="w-3.5 h-3.5 rounded-full bg-[#21262d] text-center font-bold text-[8px]">
                      <%= if is_binary(@selected_task.assignee) and @selected_task.assignee != "" do %>
                        {String.first(@selected_task.assignee) |> String.upcase()}
                      <% else %>
                        U
                      <% end %>
                    </span>
                    {@selected_task.assignee}
                  </span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-400">Priority</span>
                  <span class="text-white uppercase">{@selected_task.priority}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-400">Worker PID</span>
                  <span class="text-emerald-400">{@selected_task.worker_pid || "Unassigned"}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-400">Created</span>
                  <span class="text-gray-300">Just now</span>
                </div>
              </div>

              <!-- Effort Estimate Button (Image 1) -->
              <div class="pt-3 border-t border-[#21262d]">
                <div class="text-[11px] font-mono text-gray-400 uppercase tracking-wider mb-2">
                  Estimate
                </div>
                <%= if @selected_task.estimate do %>
                  <div class="p-2.5 bg-[#161b22] border border-[#21262d] rounded-xl font-mono text-xs text-amber-300">
                    {@selected_task.estimate}
                  </div>
                <% else %>
                  <button
                    phx-click="estimate_task"
                    phx-value-id={@selected_task.id}
                    class="w-full flex items-center justify-center gap-2 py-2 px-3 bg-[#161b22] hover:bg-[#21262d] border border-[#30363d] rounded-xl text-xs font-mono text-gray-300 transition-smooth"
                  >
                    <.icon name="hero-calculator" class="w-3.5 h-3.5 text-amber-400" />
                    Estimate effort (makes model call)
                  </button>
                <% end %>
              </div>

              <!-- Latest Summary (Image 1) -->
              <%= if @selected_task.latest_summary do %>
                <div class="pt-3 border-t border-[#21262d]">
                  <div class="text-[11px] font-mono text-gray-400 uppercase tracking-wider mb-2">
                    Latest Summary
                  </div>
                  <div class="p-3 bg-[#161b22] border border-[#21262d] rounded-xl font-mono text-xs text-gray-300">
                    {@selected_task.latest_summary}
                  </div>
                </div>
              <% end %>

              <!-- Quick Worker Actions -->
              <div class="pt-3 border-t border-[#21262d] flex gap-2">
                <button
                  phx-click="claim_task"
                  phx-value-id={@selected_task.id}
                  class="flex-1 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-mono font-medium transition-smooth"
                >
                  Claim & Run Worker
                </button>
                <button
                  phx-click="move_task"
                  phx-value-id={@selected_task.id}
                  phx-value-status="done"
                  class="px-3 py-2 bg-[#21262d] hover:bg-gray-700 text-gray-300 rounded-xl text-xs font-mono transition-smooth"
                >
                  Mark Done
                </button>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- FLOATING RAINBOW GLOW PROMPT INPUT BOX (Image 2) -->
      <footer class="p-5 pt-0 bg-gradient-to-t from-[#0a0d12] via-[#0a0d12]/95 to-transparent shrink-0">
        <div class="max-w-4xl mx-auto">
          <!-- Announcement Pill (Image 2) -->
          <div class="flex items-center gap-2 mb-2 px-2">
            <span class="text-cyan-400 text-xs">✦</span>
            <span class="text-xs font-mono text-gray-400">New: Opus 4.7 & Gemini 3.7 Flash High are active with Multi-Agent Swarm</span>
          </div>

          <!-- Rainbow Border Glow Container (Image 2) -->
          <div class="rainbow-box-wrapper shadow-2xl">
            <div class="bg-[#11151c] rounded-[1.2rem] p-3">
              <.form
                for={@prompt_form}
                id="prompt-form"
                phx-submit="submit_prompt"
                class="flex flex-col gap-2"
              >
                <textarea
                  name="prompt"
                  rows="2"
                  placeholder="What's my next task or swarm instruction? (e.g. /swarm fix authentication)"
                  class="w-full bg-transparent border-0 text-white placeholder-gray-500 font-sans text-sm focus:outline-none focus:ring-0 resize-none px-2 py-1"
                ></textarea>

                <!-- Bottom Action Toolbar (Image 2) -->
                <div class="flex items-center justify-between pt-2 border-t border-[#21262d] px-1">
                  <!-- Left Tool / Model Badges (Image 2) -->
                  <div class="flex items-center gap-2">
                    <!-- Model Pill Dropdown (Matching Reference Image) -->
                    <div class="relative">
                      <button
                        type="button"
                        phx-click="toggle_dropdown"
                        phx-value-name="model"
                        class="flex items-center bg-[#161b22] hover:bg-[#1c2128] border border-[#30363d] rounded-xl px-2.5 py-1 text-xs font-mono text-gray-200 transition-smooth"
                      >
                        <.icon name="hero-sparkles" class="w-3.5 h-3.5 text-amber-400 mr-1.5" />
                        <span>{@session.model_name}</span>
                        <.icon name="hero-chevron-up-down" class="w-3 h-3 text-gray-400 ml-1.5" />
                      </button>

                      <%= if @open_dropdown == "model" do %>
                        <div class="absolute left-0 bottom-full mb-2 w-64 bg-[#11151c]/95 border border-[#21262d] rounded-2xl p-1.5 shadow-2xl backdrop-blur-xl z-50 animate-in fade-in zoom-in-95">
                          <div class="px-3 py-1.5 text-[10px] font-mono text-gray-400 uppercase tracking-wider border-b border-[#21262d] mb-1">
                            Select AI Model
                          </div>
                          <%= for {model_id, label, provider} <- [
                            {"gemini-3.7-flash-high", "Gemini 3.7 Flash High", "Google DeepMind"},
                            {"gpt-5.4-turbo", "GPT 5.4 Turbo", "OpenAI"},
                            {"claude-3.7-sonnet", "Claude 3.7 Sonnet", "Anthropic"}
                          ] do %>
                            <button
                              type="button"
                              phx-click="change_model"
                              phx-value-model={model_id}
                              class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs hover:bg-[#1c2128] text-gray-300 transition-smooth"
                            >
                              <div class="text-left">
                                <div class="font-medium text-white">{label}</div>
                                <div class="text-[10px] text-gray-500 font-mono">{provider}</div>
                              </div>
                              <%= if @session.model_name == model_id do %>
                                <.icon name="hero-check" class="w-3.5 h-3.5 text-emerald-400" />
                              <% end %>
                            </button>
                          <% end %>
                        </div>
                      <% end %>
                    </div>

                    <!-- Tool Icons (Image 2) with Luxury Tooltips -->
                    <div class="tooltip-trigger">
                      <button
                        type="button"
                        class="p-1.5 rounded-lg bg-[#161b22] border border-[#21262d] text-gray-400 hover:text-white transition-smooth"
                      >
                        <.icon name="hero-magnifying-glass" class="w-3.5 h-3.5" />
                      </button>
                      <div class="luxury-tooltip">
                        <div class="text-xs font-semibold text-white tracking-tight mb-1">
                          AST Search Engine
                        </div>
                        <div class="flex items-center justify-between text-[11px] font-mono text-gray-400 pt-1 border-t border-white/10">
                          <span class="text-gray-300">Semantic AST Query</span>
                          <span class="text-cyan-400 font-semibold">Active</span>
                        </div>
                      </div>
                    </div>

                    <div class="tooltip-trigger">
                      <button
                        type="button"
                        class="p-1.5 rounded-lg bg-[#161b22] border border-[#21262d] text-gray-400 hover:text-white transition-smooth"
                      >
                        <.icon name="hero-cpu-chip" class="w-3.5 h-3.5 text-amber-400" />
                      </button>
                      <div class="luxury-tooltip">
                        <div class="text-xs font-semibold text-white tracking-tight mb-1">
                          Agent Swarm Coordinator
                        </div>
                        <div class="flex items-center justify-between text-[11px] font-mono text-gray-400 pt-1 border-t border-white/10">
                          <span class="text-gray-300">Planner & Coder & Verifier</span>
                          <span class="text-amber-400 font-semibold">Auto-Heal</span>
                        </div>
                      </div>
                    </div>

                    <div class="tooltip-trigger">
                      <button
                        type="button"
                        class="p-1.5 rounded-lg bg-[#161b22] border border-[#21262d] text-gray-400 hover:text-white transition-smooth"
                      >
                        <.icon name="hero-globe-alt" class="w-3.5 h-3.5 text-cyan-400" />
                      </button>
                      <div class="luxury-tooltip">
                        <div class="text-xs font-semibold text-white tracking-tight mb-1">
                          Live Web Search
                        </div>
                        <div class="flex items-center justify-between text-[11px] font-mono text-gray-400 pt-1 border-t border-white/10">
                          <span class="text-gray-300">Tavily & Documentation</span>
                          <span class="text-emerald-400 font-semibold">Ready</span>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Right Send Button with Luxury Tooltip -->
                  <div class="tooltip-trigger">
                    <button
                      type="submit"
                      class="px-4 py-1.5 rounded-xl bg-gradient-to-r from-[#ff7e5f] to-[#feb47b] text-white font-semibold text-xs font-mono shadow-md shadow-orange-500/20 hover:opacity-90 transition-smooth"
                    >
                      Execute
                    </button>
                    <div class="luxury-tooltip luxury-tooltip-left">
                      <div class="text-xs font-semibold text-white tracking-tight mb-1">
                        Run Swarm Workflow
                      </div>
                      <div class="flex items-center justify-between text-[11px] font-mono text-gray-400 pt-1 border-t border-white/10">
                        <span class="text-gray-300">Trigger Pipeline</span>
                        <span class="text-orange-400 font-semibold">↵ Enter</span>
                      </div>
                    </div>
                  </div>
                </div>
              </.form>
            </div>
          </div>
        </div>
      </footer>
    </main>
  </div>

  <!-- Settings Modal with Usage History (Matching Reference Image media_1787240939225.jpg) -->
  <%= if @show_settings_modal do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-md p-4">
      <div class="bg-[#11151c] border border-[#21262d] rounded-3xl w-full max-w-2xl p-6 shadow-2xl font-sans text-xs space-y-5 animate-in fade-in zoom-in-95 max-h-[90vh] overflow-y-auto">
        <!-- Modal Header -->
        <div class="flex items-center justify-between pb-3 border-b border-[#21262d]">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-indigo-500 to-purple-500 flex items-center justify-center text-white font-bold text-xs shadow-md">
              <.icon name="hero-chart-bar" class="w-4 h-4 text-white" />
            </div>
            <div>
              <h3 class="text-sm font-bold text-white tracking-tight">API & Usage History</h3>
              <p class="text-[11px] font-mono text-gray-400">
                Model orchestration & credit telemetry
              </p>
            </div>
          </div>
          <button
            phx-click="toggle_settings_modal"
            class="text-gray-400 hover:text-white p-1 rounded-lg"
          >
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
        </div>

        <!-- Top Section: Credits Used & Tally Bar (Matching Reference Image) -->
        <div class="bg-[#161b22]/70 border border-[#21262d] rounded-2xl p-5 relative">
          <div class="flex items-start justify-between mb-2">
            <div>
              <div class="text-[11px] font-mono text-gray-400 font-semibold tracking-wider uppercase mb-1">
                CREDITS USED
              </div>
              <div class="text-3xl font-bold text-white tracking-tight">
                56.4%
              </div>
            </div>
            <div class="text-[10px] font-mono text-gray-500 uppercase tracking-wider text-right">
              AUTO-SWITCH TO CHEAPER MODEL AT LIMIT
            </div>
          </div>

          <!-- Tally Tick Vertical Hash Bar (Matching Reference Image) -->
          <div class="tally-tick-bar my-3">
            <%= for tick <- 1..65 do %>
              <div class={[
                "tally-tick",
                tick <= 37 && "tally-tick-active-orange",
                tick > 37 && "bg-[#21262d]"
              ]}>
              </div>
            <% end %>
          </div>

          <div class="flex items-center justify-between font-mono text-xs text-gray-400 pt-1">
            <span class="text-gray-300 font-medium">56.4M / 100M CREDITS</span>
            <span>45.6M REMAINING</span>
          </div>
        </div>

        <!-- Usage History Table Section (Matching Reference Image) -->
        <div class="bg-[#161b22]/70 border border-[#21262d] rounded-2xl p-5">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <h4 class="text-sm font-bold text-white tracking-tight">Usage History</h4>
              <button class="px-3 py-1 rounded-full border border-white/20 hover:bg-white/10 text-white text-[11px] font-mono transition-smooth">
                View all
              </button>
            </div>
            <div class="px-3 py-1 rounded-full bg-[#11151c] border border-[#21262d] text-gray-400 text-xs font-mono">
              30 Days
            </div>
          </div>

          <!-- Table Header -->
          <div class="grid grid-cols-12 gap-2 text-[11px] font-mono text-gray-500 uppercase tracking-wider pb-2 border-b border-[#21262d]">
            <div class="col-span-4">Date</div>
            <div class="col-span-5">Model</div>
            <div class="col-span-3 text-right">Credits</div>
          </div>

          <!-- Table Rows (Matching Reference Image) -->
          <div class="divide-y divide-[#21262d]/60 font-mono text-xs">
            <div class="grid grid-cols-12 gap-2 py-2.5 items-center text-gray-300">
              <div class="col-span-4 text-gray-400">Aug 20, 07:26 PM</div>
              <div class="col-span-5 text-white font-medium">Claude 3.7 Sonnet Thinking</div>
              <div class="col-span-3 text-right text-amber-400 font-semibold">641.5K</div>
            </div>
            <div class="grid grid-cols-12 gap-2 py-2.5 items-center text-gray-300">
              <div class="col-span-4 text-gray-400">Aug 20, 07:21 PM</div>
              <div class="col-span-5 text-white font-medium">Gemini 3.7 Flash High</div>
              <div class="col-span-3 text-right text-amber-400 font-semibold">334.1K</div>
            </div>
            <div class="grid grid-cols-12 gap-2 py-2.5 items-center text-gray-300">
              <div class="col-span-4 text-gray-400">Aug 20, 07:18 PM</div>
              <div class="col-span-5 text-white font-medium">GPT 5.4 Turbo Codex</div>
              <div class="col-span-3 text-right text-amber-400 font-semibold">194.4K</div>
            </div>
            <div class="grid grid-cols-12 gap-2 py-2.5 items-center text-gray-300">
              <div class="col-span-4 text-gray-400">Aug 20, 07:05 PM</div>
              <div class="col-span-5 text-white font-medium">Gemini 3.7 Flash High</div>
              <div class="col-span-3 text-right text-gray-400 font-semibold">112.8K</div>
            </div>
          </div>
        </div>

        <!-- LLM API Key Configuration Form -->
        <div class="bg-[#161b22]/70 border border-[#21262d] rounded-2xl p-5">
          <h4 class="text-xs font-bold text-white tracking-tight mb-3 uppercase font-mono">
            Provider Keys & Endpoint
          </h4>
          <.form
            for={@settings_form}
            phx-submit="save_settings"
            class="space-y-3 font-mono text-xs"
          >
            <div>
              <label class="block text-gray-400 mb-1">OpenAI / Proxy API Key</label>
              <input
                type="password"
                name="settings[openai_api_key]"
                value={@settings.openai_api_key}
                class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-2 text-white font-mono"
              />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-gray-400 mb-1">Base URL</label>
                <input
                  type="text"
                  name="settings[openai_base_url]"
                  value={@settings.openai_base_url}
                  class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-2 text-white font-mono text-[11px]"
                />
              </div>
              <div>
                <label class="block text-gray-400 mb-1">Default Model</label>
                <input
                  type="text"
                  name="settings[default_model]"
                  value={@settings.default_model}
                  class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-2 text-white font-mono text-[11px]"
                />
              </div>
            </div>
            <div class="flex justify-end gap-2 pt-2 border-t border-[#21262d]">
              <button
                type="button"
                phx-click="toggle_settings_modal"
                class="px-4 py-2 bg-[#21262d] text-gray-300 rounded-xl"
              >
                Close
              </button>
              <button
                type="submit"
                class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl font-bold"
              >
                Save Configuration
              </button>
            </div>
          </.form>
        </div>
      </div>
    </div>
  <% end %>

  <!-- New Project / Workspace Modal -->
  <%= if @show_project_modal do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm">
      <div class="bg-[#161b22] border border-[#30363d] rounded-2xl w-full max-w-md p-6 shadow-2xl font-mono text-xs">
        <div class="flex items-center justify-between mb-4 border-b border-[#21262d] pb-3">
          <h3 class="text-sm font-bold text-white">Open Workspace Folder</h3>
          <button
            id="close-project-modal-btn"
            phx-click="toggle_project_modal"
            class="text-gray-400 hover:text-white"
          >✕</button>
        </div>
        <.form for={@project_form} phx-submit="open_project" class="space-y-4">
          <div>
            <label class="block text-gray-400 mb-1">Folder Path</label>
            <input
              type="text"
              name="project[path]"
              placeholder="/Users/.../my-app"
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-lg px-3 py-2 text-white"
              required
            />
          </div>
          <div>
            <label class="block text-gray-400 mb-1">Project Name (Optional)</label>
            <input
              type="text"
              name="project[name]"
              placeholder="my-app"
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-lg px-3 py-2 text-white"
            />
          </div>
          <div class="flex justify-end gap-2 pt-3 border-t border-[#21262d]">
            <button
              type="button"
              phx-click="toggle_project_modal"
              class="px-4 py-2 bg-[#21262d] text-gray-300 rounded-lg"
            >Cancel</button>
            <button type="submit" class="px-4 py-2 bg-emerald-600 text-white rounded-lg font-bold">Open</button>
          </div>
        </.form>
      </div>
    </div>
  <% end %>

  <%!-- Scheduled Task Details Modal --%>
  <%= if @show_scheduled_task_modal && @selected_scheduled_task do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-md animate-in fade-in duration-150">
      <div
        id="scheduled-task-detail-modal"
        class="bg-[#11151c] border border-[#21262d] rounded-3xl w-full max-w-lg p-6 shadow-2xl space-y-5 animate-in zoom-in-95 duration-150 font-sans"
      >
        <%!-- Modal Header --%>
        <div class="flex items-start justify-between pb-3 border-b border-[#21262d]">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-2xl bg-[#1c2128] border border-[#30363d] flex items-center justify-center text-orange-400 shadow-inner shrink-0">
              <.icon name="hero-calendar" class="w-5 h-5 text-orange-400" />
            </div>
            <div>
              <div class="flex items-center gap-2 mb-0.5">
                <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded-md bg-amber-500/15 border border-amber-500/30 text-amber-300 font-semibold">
                  ● {@selected_scheduled_task.status}
                </span>
                <span class={[
                  "text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded-md font-semibold",
                  @selected_scheduled_task.priority == "critical" &&
                    "bg-red-500/15 border border-red-500/30 text-red-300",
                  @selected_scheduled_task.priority == "high" &&
                    "bg-orange-500/15 border border-orange-500/30 text-orange-300",
                  @selected_scheduled_task.priority in ["medium", "low"] &&
                    "bg-blue-500/15 border border-blue-500/30 text-blue-300"
                ]}>
                  {String.capitalize(@selected_scheduled_task.priority)} Priority
                </span>
              </div>
              <h3 class="text-base font-bold text-white tracking-tight">
                {@selected_scheduled_task.title}
              </h3>
            </div>
          </div>
          <button
            phx-click="close_scheduled_task_modal"
            class="text-gray-400 hover:text-white p-1 rounded-lg hover:bg-[#1c2128] transition-smooth"
            title="Close"
          >
            ✕
          </button>
        </div>

        <%!-- Meta Grid --%>
        <div class="grid grid-cols-2 gap-3 font-mono text-xs">
          <div class="p-3 bg-[#161b22] border border-[#21262d] rounded-2xl">
            <div class="text-[10px] text-gray-500 uppercase tracking-wider mb-1 flex items-center gap-1.5">
              <.icon name="hero-clock" class="w-3.5 h-3.5 text-blue-400" /> Scheduled Timing
            </div>
            <div class="text-white font-medium">
              <%= if @selected_scheduled_task.scheduled_at do %>
                {Calendar.strftime(@selected_scheduled_task.scheduled_at, "%b %d, %Y · %I:%M %p")}
              <% else %>
                <%= if @selected_scheduled_task.cron_expression do %>
                  Recurring: {@selected_scheduled_task.cron_expression}
                <% else %>
                  Immediate / On-demand
                <% end %>
              <% end %>
            </div>
          </div>

          <div class="p-3 bg-[#161b22] border border-[#21262d] rounded-2xl">
            <div class="text-[10px] text-gray-500 uppercase tracking-wider mb-1 flex items-center gap-1.5">
              <.icon name="hero-user-circle" class="w-3.5 h-3.5 text-purple-400" />
              Assignee & Worker
            </div>
            <div class="text-white font-medium flex items-center gap-1.5">
              <span>{@selected_scheduled_task.assignee}</span>
              <%= if @selected_scheduled_task.worker_pid do %>
                <span class="text-[10px] text-emerald-400 font-mono">PID: {@selected_scheduled_task.worker_pid}</span>
              <% end %>
            </div>
          </div>
        </div>

        <%!-- Description Box --%>
        <div class="space-y-1.5 font-sans">
          <div class="text-[11px] font-mono text-gray-400 uppercase tracking-wider">
            Task Instructions & Requirements
          </div>
          <div class="p-3.5 bg-[#0d1117] border border-[#21262d] rounded-2xl text-xs leading-relaxed text-gray-300 font-sans whitespace-pre-wrap">
            {@selected_scheduled_task.description || "No specific instructions provided."}
          </div>
        </div>

        <%!-- Execution Progress & Latest Telemetry --%>
        <%= if @selected_scheduled_task.latest_summary do %>
          <div class="p-3 bg-[#161b22] border border-[#21262d] rounded-2xl text-xs font-mono">
            <div class="text-[10px] text-gray-400 uppercase tracking-wider mb-1">
              Latest Execution Telemetry
            </div>
            <div class="text-emerald-400">
              {@selected_scheduled_task.latest_summary}
            </div>
          </div>
        <% end %>

        <%!-- Modal Actions --%>
        <div class="flex items-center justify-between pt-3 border-t border-[#21262d]">
          <button
            type="button"
            phx-click="delete_scheduled_task"
            phx-value-id={@selected_scheduled_task.id}
            class="px-3.5 py-2 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 text-xs font-mono transition-smooth flex items-center gap-1.5"
          >
            <.icon name="hero-trash" class="w-3.5 h-3.5" />
            <span>Delete Task</span>
          </button>

          <div class="flex items-center gap-2">
            <button
              type="button"
              phx-click="close_scheduled_task_modal"
              class="px-4 py-2 bg-[#1c2128] hover:bg-[#21262d] text-gray-300 rounded-xl text-xs font-mono border border-[#30363d] transition-smooth"
            >
              Close
            </button>
            <button
              type="button"
              phx-click="run_scheduled_task"
              phx-value-id={@selected_scheduled_task.id}
              class="px-4 py-2 bg-[#ff5e3a] hover:bg-[#ff4e24] text-white rounded-xl text-xs font-mono font-bold shadow-lg shadow-orange-500/20 transition-smooth flex items-center gap-1.5"
            >
              <.icon name="hero-play" class="w-3.5 h-3.5" />
              <span>Run Now</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%!-- Create Agent Task Modal (Matching Reference Image media_1787246700849.png) --%>
  <%= if @show_new_task_modal do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-md animate-in fade-in duration-150">
      <div
        id="new-task-modal"
        class="bg-[#11151c] border border-[#21262d] rounded-3xl w-full max-w-lg p-6 shadow-2xl font-mono text-xs animate-in zoom-in-95 duration-150 space-y-4"
      >
        <%!-- Modal Header (Matching Reference Image media_1787246700849.png) --%>
        <div class="flex items-center justify-between pb-3 border-b border-[#21262d]">
          <h3 class="text-sm font-bold text-white flex items-center gap-2">
            <.icon name="hero-plus-circle" class="w-4 h-4 text-orange-400" /> Create Agent Task
          </h3>
          <button
            phx-click="toggle_new_task_modal"
            class="text-gray-400 hover:text-white p-1 rounded-lg hover:bg-[#1c2128]"
          >✕</button>
        </div>

        <.form for={@task_form} id="task-create-form" phx-submit="create_task" class="space-y-4">
          <!-- Task Title -->
          <div>
            <label class="block text-gray-400 mb-1.5 font-semibold text-[11px]">Task Title</label>
            <input
              type="text"
              name="title"
              placeholder="e.g. Reconcile payment webhook states"
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3.5 py-2.5 text-white font-sans text-xs focus:outline-hidden focus:border-[#ff5e3a]"
              required
            />
          </div>

          <!-- Description -->
          <div>
            <label class="block text-gray-400 mb-1.5 font-semibold text-[11px]">Description</label>
            <textarea
              name="description"
              rows="2"
              placeholder="Task requirements or prompt instructions..."
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3.5 py-2.5 text-white font-sans text-xs focus:outline-hidden focus:border-[#ff5e3a] resize-none"
            ></textarea>
          </div>

          <%!-- Status & Priority Row (Custom Glassmorphic Dropdowns matching theme) --%>
          <div class="grid grid-cols-2 gap-3">
            <%!-- Status Custom Dropdown --%>
            <div class="relative">
              <label class="block text-gray-400 mb-1.5 font-semibold text-[11px]">Status</label>
              <button
                type="button"
                id="modal-status-dropdown-trigger"
                phx-click="toggle_modal_dropdown"
                phx-value-name="modal_status"
                class="w-full bg-[#0d1117] hover:bg-[#161b22] border border-[#30363d] hover:border-gray-500 rounded-xl px-3 py-2 text-white font-sans text-xs flex items-center justify-between transition-smooth cursor-pointer"
              >
                <div class="flex items-center gap-2 truncate">
                  <span class={[
                    "w-2 h-2 rounded-full shrink-0",
                    @new_task_status == "scheduled" &&
                      "bg-amber-400 shadow-[0_0_6px_rgba(245,158,11,0.8)]",
                    @new_task_status == "ready" &&
                      "bg-emerald-400 shadow-[0_0_6px_rgba(34,197,94,0.8)]",
                    @new_task_status == "triage" && "bg-purple-400",
                    @new_task_status == "todo" && "bg-blue-400",
                    @new_task_status == "running" &&
                      "bg-cyan-400 shadow-[0_0_6px_rgba(6,182,212,0.8)]"
                  ]}></span>
                  <span class="capitalize font-medium truncate">
                    {case @new_task_status do
                      "ready" -> "Ready (Agent Claimable)"
                      s -> String.capitalize(s)
                    end}
                  </span>
                </div>
                <.icon name="hero-chevron-down" class="w-3.5 h-3.5 text-gray-400 shrink-0 ml-1" />
              </button>
              <input type="text" name="status" value={@new_task_status} class="hidden" />

              <%= if @open_modal_dropdown == "modal_status" do %>
                <div
                  id="modal-status-dropdown-menu"
                  class="absolute left-0 top-full mt-1.5 w-full bg-[#1c2128] border border-[#30363d] rounded-2xl p-1.5 shadow-2xl z-50 animate-in fade-in zoom-in-95 font-sans space-y-0.5"
                >
                  <%= for {s_val, s_label, dot_class} <- [
                    {"scheduled", "Scheduled", "bg-amber-400 shadow-[0_0_6px_rgba(245,158,11,0.8)]"},
                    {"ready", "Ready (Agent Claimable)", "bg-emerald-400 shadow-[0_0_6px_rgba(34,197,94,0.8)]"},
                    {"triage", "Triage", "bg-purple-400"},
                    {"todo", "Todo", "bg-blue-400"},
                    {"running", "Running", "bg-cyan-400 shadow-[0_0_6px_rgba(6,182,212,0.8)]"}
                  ] do %>
                    <button
                      type="button"
                      phx-click="select_modal_status"
                      phx-value-status={s_val}
                      class={[
                        "w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs transition-smooth text-left cursor-pointer",
                        @new_task_status == s_val && "bg-[#2d333b] text-white font-semibold",
                        @new_task_status != s_val &&
                          "text-gray-300 hover:bg-[#22272e] hover:text-white"
                      ]}
                    >
                      <div class="flex items-center gap-2 truncate">
                        <span class={["w-2 h-2 rounded-full shrink-0", dot_class]}></span>
                        <span class="truncate">{s_label}</span>
                      </div>
                      <%= if @new_task_status == s_val do %>
                        <.icon name="hero-check" class="w-3.5 h-3.5 text-blue-400 shrink-0" />
                      <% end %>
                    </button>
                  <% end %>
                </div>
              <% end %>
            </div>

            <%!-- Priority Custom Dropdown --%>
            <div class="relative">
              <label class="block text-gray-400 mb-1.5 font-semibold text-[11px]">Priority</label>
              <button
                type="button"
                id="modal-priority-dropdown-trigger"
                phx-click="toggle_modal_dropdown"
                phx-value-name="modal_priority"
                class="w-full bg-[#0d1117] hover:bg-[#161b22] border border-[#30363d] hover:border-gray-500 rounded-xl px-3 py-2 text-white font-sans text-xs flex items-center justify-between transition-smooth cursor-pointer"
              >
                <div class="flex items-center gap-2 truncate">
                  <span class={[
                    "w-2 h-2 rounded-full shrink-0",
                    @new_task_priority == "critical" &&
                      "bg-red-400 shadow-[0_0_6px_rgba(239,68,68,0.8)]",
                    @new_task_priority == "high" &&
                      "bg-orange-400 shadow-[0_0_6px_rgba(249,115,22,0.8)]",
                    @new_task_priority == "medium" && "bg-blue-400",
                    @new_task_priority == "low" && "bg-gray-400"
                  ]}></span>
                  <span class="capitalize font-medium truncate">{String.capitalize(
                    @new_task_priority
                  )}</span>
                </div>
                <.icon name="hero-chevron-down" class="w-3.5 h-3.5 text-gray-400 shrink-0 ml-1" />
              </button>
              <input type="text" name="priority" value={@new_task_priority} class="hidden" />

              <%= if @open_modal_dropdown == "modal_priority" do %>
                <div
                  id="modal-priority-dropdown-menu"
                  class="absolute left-0 top-full mt-1.5 w-full bg-[#1c2128] border border-[#30363d] rounded-2xl p-1.5 shadow-2xl z-50 animate-in fade-in zoom-in-95 font-sans space-y-0.5"
                >
                  <%= for {p_val, p_label, dot_class} <- [
                    {"critical", "Critical", "bg-red-400 shadow-[0_0_6px_rgba(239,68,68,0.8)]"},
                    {"high", "High", "bg-orange-400 shadow-[0_0_6px_rgba(249,115,22,0.8)]"},
                    {"medium", "Medium", "bg-blue-400"},
                    {"low", "Low", "bg-gray-400"}
                  ] do %>
                    <button
                      type="button"
                      phx-click="select_modal_priority"
                      phx-value-priority={p_val}
                      class={[
                        "w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs transition-smooth text-left cursor-pointer",
                        @new_task_priority == p_val && "bg-[#2d333b] text-white font-semibold",
                        @new_task_priority != p_val &&
                          "text-gray-300 hover:bg-[#22272e] hover:text-white"
                      ]}
                    >
                      <div class="flex items-center gap-2 truncate">
                        <span class={["w-2 h-2 rounded-full shrink-0", dot_class]}></span>
                        <span class="truncate">{p_label}</span>
                      </div>
                      <%= if @new_task_priority == p_val do %>
                        <.icon name="hero-check" class="w-3.5 h-3.5 text-blue-400 shrink-0" />
                      <% end %>
                    </button>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

          <%!-- Assignee & Tag Row (Custom Glassmorphic Dropdown) --%>
          <div class="grid grid-cols-2 gap-3">
            <%!-- Assignee Custom Dropdown --%>
            <div class="relative">
              <label class="block text-gray-400 mb-1.5 font-semibold text-[11px]">Assignee</label>
              <button
                type="button"
                id="modal-assignee-dropdown-trigger"
                phx-click="toggle_modal_dropdown"
                phx-value-name="modal_assignee"
                class="w-full bg-[#0d1117] hover:bg-[#161b22] border border-[#30363d] hover:border-gray-500 rounded-xl px-3 py-2 text-white font-sans text-xs flex items-center justify-between transition-smooth cursor-pointer"
              >
                <div class="flex items-center gap-2 truncate">
                  <.icon
                    name={
                      case @new_task_assignee do
                        "planner" -> "hero-sparkles"
                        "coder" -> "hero-code-bracket"
                        "verifier" -> "hero-check-badge"
                        _ -> "hero-user-circle"
                      end
                    }
                    class={[
                      "w-3.5 h-3.5 shrink-0",
                      @new_task_assignee == "planner" && "text-amber-400",
                      @new_task_assignee == "coder" && "text-cyan-400",
                      @new_task_assignee == "verifier" && "text-emerald-400",
                      @new_task_assignee == "default" && "text-purple-400"
                    ]}
                  />
                  <span class="font-medium truncate">
                    {case @new_task_assignee do
                      "planner" -> "PlannerAgent"
                      "coder" -> "CoderAgent"
                      "verifier" -> "VerifierAgent"
                      _ -> "Default Worker"
                    end}
                  </span>
                </div>
                <.icon name="hero-chevron-down" class="w-3.5 h-3.5 text-gray-400 shrink-0 ml-1" />
              </button>
              <input type="text" name="assignee" value={@new_task_assignee} class="hidden" />

              <%= if @open_modal_dropdown == "modal_assignee" do %>
                <div
                  id="modal-assignee-dropdown-menu"
                  class="absolute left-0 top-full mt-1.5 w-full bg-[#1c2128] border border-[#30363d] rounded-2xl p-1.5 shadow-2xl z-50 animate-in fade-in zoom-in-95 font-sans space-y-0.5"
                >
                  <%= for {a_val, a_label, icon_name, icon_color} <- [
                    {"default", "Default Worker", "hero-user-circle", "text-purple-400"},
                    {"planner", "PlannerAgent", "hero-sparkles", "text-amber-400"},
                    {"coder", "CoderAgent", "hero-code-bracket", "text-cyan-400"},
                    {"verifier", "VerifierAgent", "hero-check-badge", "text-emerald-400"}
                  ] do %>
                    <button
                      type="button"
                      phx-click="select_modal_assignee"
                      phx-value-assignee={a_val}
                      class={[
                        "w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs transition-smooth text-left cursor-pointer",
                        @new_task_assignee == a_val && "bg-[#2d333b] text-white font-semibold",
                        @new_task_assignee != a_val &&
                          "text-gray-300 hover:bg-[#22272e] hover:text-white"
                      ]}
                    >
                      <div class="flex items-center gap-2 truncate">
                        <.icon name={icon_name} class={["w-3.5 h-3.5 shrink-0", icon_color]} />
                        <span class="truncate">{a_label}</span>
                      </div>
                      <%= if @new_task_assignee == a_val do %>
                        <.icon name="hero-check" class="w-3.5 h-3.5 text-blue-400 shrink-0" />
                      <% end %>
                    </button>
                  <% end %>
                </div>
              <% end %>
            </div>
            <div>
              <label class="block text-gray-400 mb-1.5 font-semibold text-[11px]">Tag</label>
              <input
                type="text"
                name="tag"
                placeholder="Bug, Feature, Core..."
                class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3.5 py-2 text-white font-sans text-xs focus:outline-hidden focus:border-[#ff5e3a]"
              />
            </div>
          </div>

          <%!-- Custom Date & Time Schedule Picker Section (Matching media_1787247860901.png) --%>
          <div class="p-3.5 bg-[#161b22]/70 border border-[#21262d] rounded-2xl space-y-3">
            <div class="flex items-center justify-between text-[11px] font-mono font-semibold text-gray-300">
              <span class="flex items-center gap-1.5">
                <.icon name="hero-calendar" class="w-3.5 h-3.5 text-orange-400" />
                <span>Schedule & Execution Time</span>
              </span>
              <button
                type="button"
                phx-click="open_time_picker"
                phx-value-mode="datetime"
                class="text-blue-400 hover:text-blue-300 text-[10px] flex items-center gap-1 hover:underline cursor-pointer"
              >
                <.icon name="hero-clock" class="w-3 h-3" />
                <span>Change Time Slot</span>
              </button>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <%!-- Custom Popover Date Picker (Matching media_1787247860901.png) --%>
              <div class="relative">
                <label class="block text-gray-400 mb-1 text-[10px]">Target Date</label>
                <div
                  id="target-date-picker-trigger"
                  phx-click="toggle_date_picker_popover"
                  class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-1.5 text-white font-mono text-xs flex items-center justify-between cursor-pointer hover:border-gray-400 transition-smooth select-none"
                  title="Click to open calendar date picker"
                >
                  <span class={
                    if @new_task_date != "", do: "text-white font-medium", else: "text-gray-500"
                  }>
                    {format_date_display(@new_task_date)}
                  </span>
                  <.icon name="hero-calendar" class="w-3.5 h-3.5 text-gray-400 hover:text-white" />
                </div>
                <input type="text" name="scheduled_at_date" value={@new_task_date} class="hidden" />

                <%!-- Popover Calendar Card (Matching media_1787247860901.png) --%>
                <%= if @show_date_picker_popover do %>
                  <div
                    id="custom-date-picker-popover"
                    class="absolute bottom-full left-0 mb-2 z-50 w-64 bg-[#22272e] border border-[#30363d] rounded-2xl p-3 shadow-2xl shadow-black/80 font-mono text-xs select-none animate-in fade-in zoom-in-95 duration-100"
                  >
                    <%!-- Header Row: August 2026 + Navigation Arrows --%>
                    <div class="flex items-center justify-between mb-2.5 px-1">
                      <div class="flex items-center gap-1 text-white font-bold text-xs font-sans">
                        <span>{month_name(@picker_month)} {@picker_year}</span>
                        <.icon name="hero-chevron-down" class="w-3 h-3 text-gray-400" />
                      </div>
                      <div class="flex items-center gap-0.5">
                        <button
                          type="button"
                          phx-click="picker_prev_month"
                          class="p-1 rounded-lg hover:bg-[#2d333b] text-gray-400 hover:text-white transition-smooth cursor-pointer"
                          title="Previous Month"
                        >
                          <.icon name="hero-arrow-up" class="w-3 h-3" />
                        </button>
                        <button
                          type="button"
                          phx-click="picker_next_month"
                          class="p-1 rounded-lg hover:bg-[#2d333b] text-gray-400 hover:text-white transition-smooth cursor-pointer"
                          title="Next Month"
                        >
                          <.icon name="hero-arrow-down" class="w-3 h-3" />
                        </button>
                      </div>
                    </div>

                    <%!-- Weekday Row (S M T W T F S) --%>
                    <div class="grid grid-cols-7 gap-0.5 mb-1 text-center">
                      <%= for d <- ["S", "M", "T", "W", "T", "F", "S"] do %>
                        <div class="text-[10px] font-sans font-semibold text-gray-400 py-0.5">
                          {d}
                        </div>
                      <% end %>
                    </div>

                    <%!-- 6-Week Monthly Grid (42 cells matching screenshot) --%>
                    <div class="grid grid-cols-7 gap-0.5 text-center">
                      <%= for cell <- calendar_grid_cells(@picker_year, @picker_month, @new_task_date) do %>
                        <button
                          type="button"
                          phx-click="picker_select_day"
                          phx-value-year={cell.year}
                          phx-value-month={cell.month}
                          phx-value-day={cell.day}
                          class={[
                            "h-6 w-6 mx-auto flex items-center justify-center rounded-lg text-[11px] font-sans transition-smooth cursor-pointer",
                            cell.is_selected && "bg-[#58a6ff] text-white font-bold shadow-sm",
                            cell.is_today && !cell.is_selected &&
                              "border border-gray-500 text-white font-semibold",
                            !cell.is_selected && !cell.is_today && cell.is_current_month &&
                              "text-gray-200 hover:bg-[#2d333b] hover:text-white",
                            !cell.is_selected && !cell.is_today && !cell.is_current_month &&
                              "text-gray-500 hover:text-gray-400"
                          ]}
                        >
                          {cell.day}
                        </button>
                      <% end %>
                    </div>

                    <%!-- Popover Footer: Clear and Today --%>
                    <div class="flex items-center justify-between pt-2 mt-2 border-t border-[#30363d] px-1 text-xs">
                      <button
                        type="button"
                        phx-click="picker_clear"
                        class="text-blue-400 hover:text-blue-300 font-sans font-medium text-[11px] transition-smooth cursor-pointer"
                      >
                        Clear
                      </button>
                      <button
                        type="button"
                        phx-click="picker_today"
                        class="text-blue-400 hover:text-blue-300 font-sans font-medium text-[11px] transition-smooth cursor-pointer"
                      >
                        Today
                      </button>
                    </div>
                  </div>
                <% end %>
              </div>

              <%!-- Time Slot --%>
              <div>
                <label class="block text-gray-400 mb-1 text-[10px]">Time Slot</label>
                <div
                  id="target-time-slot-trigger"
                  phx-click="open_time_picker"
                  phx-value-mode="time"
                  class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-1.5 text-blue-300 font-mono text-xs flex items-center justify-between cursor-pointer hover:border-gray-400 transition-smooth select-none"
                  title="Click to select time slot"
                >
                  <span class="truncate">{@selected_time_slot}</span>
                  <.icon name="hero-clock" class="w-3.5 h-3.5 text-blue-400 shrink-0 ml-1" />
                </div>
                <input
                  type="text"
                  name="scheduled_at_time_slot"
                  value={@selected_time_slot}
                  class="hidden"
                />
              </div>
            </div>

            <div>
              <label class="block text-gray-400 mb-1 text-[10px]">Recurring Cron Expression (Optional)</label>
              <input
                type="text"
                name="cron_expression"
                placeholder="e.g. 0 0 * * * (Daily) or leave empty"
                class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-1.5 text-amber-300 font-mono text-xs focus:outline-hidden focus:border-[#ff5e3a]"
              />
            </div>
          </div>

          <%!-- Bottom Action Buttons (Matching Reference Image) --%>
          <div class="flex justify-end gap-2 pt-3 border-t border-[#21262d]">
            <button
              type="button"
              phx-click="toggle_new_task_modal"
              class="px-4 py-2 bg-[#21262d] hover:bg-[#2c333d] text-gray-300 rounded-xl transition-smooth cursor-pointer"
            >Cancel</button>
            <button
              type="submit"
              class="px-5 py-2 bg-[#ff5e3a] hover:bg-[#ff4e24] text-white rounded-xl font-bold shadow-lg shadow-orange-500/25 transition-smooth cursor-pointer"
            >Create Task</button>
          </div>
        </.form>
      </div>
    </div>
  <% end %>

  <%!-- Set Focus Time / Time & Date Picker Modal (Matching media_1787247904808.png & media_1787242440125.jpg) --%>
  <%= if @show_time_picker do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-md animate-in fade-in duration-150">
      <div
        class="bg-[#11151c] border border-[#21262d] rounded-3xl w-full max-w-md p-6 shadow-2xl space-y-5 animate-in zoom-in-95 duration-150"
        id="time-picker-modal"
      >
        <%!-- Modal Header (Matching Reference Image) --%>
        <div class="flex items-start justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-[#1c2128] border border-[#30363d] flex items-center justify-center text-gray-300 shadow-inner shrink-0">
              <.icon name="hero-clock" class="w-5 h-5 text-blue-400" />
            </div>
            <div>
              <h3 class="text-base font-bold text-white tracking-tight">
                Set focus time & presence
              </h3>
              <p class="text-xs text-gray-400 font-sans">
                Choose when you don't want to be disturbed or set autonomous swarm mode
              </p>
            </div>
          </div>
          <button
            type="button"
            phx-click="close_time_picker"
            class="text-gray-400 hover:text-white p-1 rounded-lg transition-smooth cursor-pointer"
            title="Close"
          >
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
        </div>

        <%!-- Select Status Section (Fixed Layout - Zero Truncation matching media_1787247904808.png) --%>
        <div>
          <div class="flex items-center gap-1.5 text-xs font-semibold text-gray-300 font-sans mb-2.5">
            <span>Select status</span>
            <span
              class="text-gray-500 hover:text-gray-300 cursor-pointer"
              title="Select your live presence & agent interaction mode"
            >ⓘ</span>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <%= for {status_label, dot_bg, desc} <- [
              {"Available", "bg-emerald-400 shadow-[0_0_8px_rgba(34,197,94,0.8)]", "Instant alerts"},
              {"Busy", "bg-red-400 shadow-[0_0_8px_rgba(239,68,68,0.8)]", "Deep focus mode"},
              {"In-meeting", "bg-amber-400 shadow-[0_0_8px_rgba(245,158,11,0.8)]", "Batched summaries"},
              {"Offline", "bg-gray-400", "Scheduled cron only"}
            ] do %>
              <button
                type="button"
                phx-click="select_schedule_status"
                phx-value-status={status_label}
                class={[
                  "flex items-center gap-2.5 py-2.5 px-3 rounded-2xl text-xs font-medium border transition-smooth text-left cursor-pointer",
                  @selected_schedule_status == status_label &&
                    "bg-[#1c2128] border-gray-500 shadow-md text-white ring-1 ring-white/10",
                  @selected_schedule_status != status_label &&
                    "bg-[#0d1117] border-[#21262d] text-gray-400 hover:text-gray-200 hover:bg-[#161b22]"
                ]}
              >
                <span class={["w-2 h-2 rounded-full shrink-0", dot_bg]}></span>
                <div class="min-w-0 flex-1">
                  <div class="font-bold text-white tracking-tight leading-tight">
                    {status_label}
                  </div>
                  <div class="text-[10px] text-gray-500 font-mono truncate">{desc}</div>
                </div>
              </button>
            <% end %>
          </div>
        </div>

        <!-- Select Time Section (Matching Reference Image) -->
        <div>
          <div class="flex items-center gap-1.5 text-xs font-semibold text-gray-300 font-sans mb-2.5">
            <span>Select time</span>
            <span
              class="text-gray-500 hover:text-gray-300 cursor-pointer"
              title="Pick an available focus window"
            >ⓘ</span>
          </div>

          <!-- Time Slots List -->
          <div class="space-y-1 max-h-56 overflow-y-auto pr-1">
            <%= for {start_t, end_t} <- [
              {"09:30 AM", "10:00 AM"},
              {"10:00 AM", "10:30 AM"},
              {"10:30 AM", "11:00 AM"},
              {"11:00 AM", "11:30 AM"},
              {"11:30 AM", "12:00 PM"},
              {"12:00 PM", "12:30 PM"},
              {"12:30 PM", "01:00 PM"},
              {"01:00 PM", "01:30 PM"},
              {"02:00 PM", "03:00 PM"}
            ] do %>
              <% slot_str = "#{start_t} - #{end_t}"
              is_selected = @selected_time_slot == slot_str %>
              <button
                type="button"
                phx-click="select_time_slot"
                phx-value-slot={slot_str}
                class={[
                  "w-full flex items-center justify-between px-3.5 py-2 rounded-xl text-xs font-mono transition-smooth text-left",
                  is_selected &&
                    "bg-[#21262d] text-white font-semibold border border-white/10 shadow-sm",
                  !is_selected && "text-gray-400 hover:text-gray-200 hover:bg-[#161b22]"
                ]}
              >
                <span>{start_t}</span>
                <%= if is_selected do %>
                  <div class="w-4 h-4 rounded-full bg-blue-500 flex items-center justify-center text-white text-[10px] shadow-sm">
                    <.icon name="hero-check" class="w-2.5 h-2.5" />
                  </div>
                <% else %>
                  <span class="w-4"></span>
                <% end %>
                <span>{end_t}</span>
              </button>
            <% end %>
          </div>
        </div>

        <!-- Custom Time Input (Optional Toggle) -->
        <%= if @show_custom_time_input do %>
          <div class="pt-2 border-t border-[#21262d] animate-in fade-in">
            <label class="block text-[11px] font-mono text-gray-400 mb-1">Enter Custom Time / Interval</label>
            <input
              type="text"
              name="custom_time"
              placeholder="e.g. 03:15 PM - 04:00 PM"
              class="w-full bg-[#0d1117] border border-[#30363d] rounded-xl px-3 py-2 text-xs font-mono text-white focus:outline-hidden focus:border-blue-500"
            />
          </div>
        <% end %>

        <!-- Footer Action Bar (Matching Reference Image) -->
        <div class="flex items-center justify-between pt-3 border-t border-[#21262d]">
          <button
            type="button"
            phx-click="toggle_custom_time"
            class="text-xs text-gray-400 hover:text-white transition-smooth font-mono font-medium"
          >
            {if @show_custom_time_input, do: "Use presets", else: "Set custom time"}
          </button>
          <div class="flex items-center gap-2">
            <button
              type="button"
              phx-click="close_time_picker"
              class="px-4 py-2 rounded-xl bg-[#1c2128] hover:bg-[#21262d] text-gray-300 text-xs font-mono font-medium transition-smooth"
            >
              Cancel
            </button>
            <button
              type="button"
              phx-click="apply_time_picker"
              class="px-5 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-mono font-bold shadow-lg shadow-blue-500/25 transition-smooth"
            >
              Apply
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</Layouts.app>
