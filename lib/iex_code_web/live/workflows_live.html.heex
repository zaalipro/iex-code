<Layouts.app flash={@flash}>
  <div
    id="workflows-live-container"
    class="orbital-workflows min-h-dvh bg-canvas text-content flex flex-col"
  >
    <.page_toolbar id="workflows-navigation">
      <:leading>
        <.link
          navigate={@return_path}
          class="header-control"
        >
          <.icon name="hero-arrow-left" class="w-3.5 h-3.5" />
          <span>Workspace</span>
        </.link>

        <span class="text-subtle font-mono">/</span>

        <.link
          navigate={IexCodeWeb.WorkflowsLive.workflows_index_path(@context_session)}
          class="text-xs font-mono text-accent hover:text-accent-strong hover:underline font-bold"
        >
          Workflows
        </.link>

        <%= if @workflow do %>
          <span class="text-subtle font-mono">/</span>
          <span class="text-xs font-mono text-muted truncate max-w-[200px]">
            {@workflow.name}
          </span>
        <% end %>

        <%= if @run do %>
          <span class="text-subtle font-mono">/</span>
          <span class="text-xs font-mono text-accent">
            Cockpit #{String.slice(to_string(@run.id), 0, 8)}
          </span>
        <% end %>
      </:leading>
      <:actions>
        <%= if @live_action not in [:new, :session_new] do %>
          <.link
            id="header-btn-new-workflow"
            navigate={IexCodeWeb.WorkflowsLive.workflows_new_path(@context_session)}
            class="header-control header-control--primary"
          >
            <.icon name="hero-plus" class="w-3.5 h-3.5" />
            <span>New Workflow</span>
          </.link>
        <% end %>

        <%= if @live_action not in [:index, :session_index] do %>
          <.link
            id="header-btn-gallery"
            navigate={IexCodeWeb.WorkflowsLive.workflows_index_path(@context_session)}
            class="header-control"
          >
            <.icon name="hero-rectangle-stack" class="w-3.5 h-3.5" />
            <span>All Workflows</span>
          </.link>
        <% end %>
      </:actions>
    </.page_toolbar>

    <%!-- Main Content Area --%>
    <main class="orbital-workflows-main flex-1 overflow-y-auto p-6 max-w-[100rem] mx-auto w-full">
      <%!-- =================================================================== --%>
      <%!-- 1. GALLERY VIEW (:index, :session_index)                             --%>
      <%!-- =================================================================== --%>
      <%= if @live_action in [:index, :session_index] do %>
        <% query = @search_query |> String.trim() |> String.downcase() %>
        <% visible_workflows =
          Enum.filter(@workflows, fn workflow ->
            matches_query? =
              String.contains?(String.downcase(workflow.name || ""), query) ||
                String.contains?(String.downcase(workflow.slug || ""), query)

            matches_tag? = @tag_filter == "all" || @tag_filter in (workflow.tags || [])
            matches_query? && matches_tag?
          end) %>
        <div id="workflows-gallery" class="space-y-6">
          <.page_header
            id="workflows-gallery-header"
            class="page-header--flush"
            title="Workflows"
            heading_tag="h1"
            description="Build and run multi-step research, coding, and verification workflows."
            icon="hero-rectangle-stack"
            count={length(@workflows)}
          >
            <:actions>
              <span class="text-xs text-muted">
                {Enum.count(@active_runs, &(&1.status == "running"))} active · {length(
                  @active_runs
                )} total runs
              </span>
            </:actions>
          </.page_header>

          <section
            id="workflows-overview"
            class="workflow-overview"
            aria-label="Workflow activity"
          >
            <div class="workflow-overview-intro">
              <div class="workflow-orbit-emblem ui-depth-effect" aria-hidden="true">
                <span class="workflow-orbit-emblem-ring"></span>
                <.icon name="hero-square-3-stack-3d" class="w-7 h-7" />
              </div>
              <div>
                <h2>Your execution library</h2>
                <p>Choose a pipeline. Follow every step from research to verification.</p>
              </div>
            </div>
            <dl class="workflow-overview-metrics">
              <div>
                <dt>Workflows</dt>
                <dd>{length(@workflows)}</dd>
              </div>
              <div>
                <dt>Running</dt>
                <dd class="text-accent">{Enum.count(@active_runs, &(&1.status == "running"))}</dd>
              </div>
              <div>
                <dt>Recent runs</dt>
                <dd>{length(@active_runs)}</dd>
              </div>
            </dl>
          </section>

          <%!-- Controls: Search & Tag Filters --%>
          <div class="workflow-library-controls flex flex-col sm:flex-row items-center justify-between gap-4">
            <.form
              for={to_form(%{"query" => @search_query})}
              id="workflows-search-form"
              phx-change="search"
              phx-submit="search"
              class="workflow-search relative w-full sm:w-80"
            >
              <.icon
                name="hero-magnifying-glass"
                class="w-4 h-4 text-subtle absolute left-3.5 top-3"
              />
              <.input
                type="text"
                id="workflows-search-input"
                name="query"
                aria-label="Search workflows"
                placeholder="Search workflows by name or slug..."
                value={@search_query}
                class="w-full pl-10 pr-10 py-2 rounded-xl bg-surface border border-line text-xs font-mono text-content placeholder:text-subtle focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-all"
              />
              <button
                :if={@search_query != ""}
                type="button"
                id="workflows-search-clear"
                aria-label="Clear workflow search"
                phx-click="search"
                phx-value-query=""
                class="absolute right-2 top-2 flex h-7 w-7 items-center justify-center rounded-lg text-muted hover:bg-accent/10 hover:text-content"
              >
                <.icon name="hero-x-mark" class="h-3.5 w-3.5" />
              </button>
            </.form>

            <%!-- Tags Filter --%>
            <div class="flex items-center gap-1.5 overflow-x-auto w-full sm:w-auto pb-1 sm:pb-0">
              <button
                type="button"
                id="workflows-filter-all"
                phx-click="filter_tag"
                phx-value-tag="all"
                aria-pressed={to_string(@tag_filter == "all")}
                class={[
                  "px-3 py-1.5 rounded-lg text-xs font-mono transition-colors shrink-0",
                  @tag_filter == "all" &&
                    "bg-accent/15 text-accent border border-accent/40",
                  @tag_filter != "all" && "bg-raised/40 text-muted hover:text-content"
                ]}
              >
                All
              </button>
              <%= for tag <- ["autonomous", "swarm", "full-cycle", "research"] do %>
                <button
                  type="button"
                  id={"workflows-filter-#{tag}"}
                  phx-click="filter_tag"
                  phx-value-tag={tag}
                  aria-pressed={to_string(@tag_filter == tag)}
                  class={[
                    "px-3 py-1.5 rounded-lg text-xs font-mono transition-colors shrink-0",
                    @tag_filter == tag &&
                      "bg-accent/15 text-accent border border-accent/40",
                    @tag_filter != tag && "bg-raised/40 text-muted hover:text-content"
                  ]}
                >
                  #{tag}
                </button>
              <% end %>
            </div>
          </div>

          <%!-- Workflows Cards Grid --%>
          <%= if length(visible_workflows) > 0 do %>
            <div
              id="workflows-library-grid"
              class="workflow-library-grid grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6"
            >
              <%= for workflow <- visible_workflows do %>
                <% active_run =
                  Enum.find(@active_runs, fn r ->
                    r.workflow_id == workflow.id and r.status == "running"
                  end) %>
                <.workflow_card
                  workflow={workflow}
                  active_run={active_run}
                  on_launch="launch_workflow"
                  on_delete="delete_workflow"
                />
              <% end %>
            </div>
          <% else %>
            <%!-- Empty State --%>
            <div
              id="workflows-empty-state"
              class="workflow-empty-state rounded-3xl border border-line p-12"
            >
              <div class="workflow-observatory ui-depth-effect" aria-hidden="true">
                <span class="workflow-observatory-orbit workflow-observatory-orbit--outer"></span>
                <span class="workflow-observatory-orbit workflow-observatory-orbit--inner"></span>
                <span class="workflow-observatory-core"><.icon
                  name="hero-square-3-stack-3d"
                  class="w-9 h-9"
                /></span>
                <span class="workflow-observatory-satellite workflow-observatory-satellite--one"><.icon
                  name="hero-magnifying-glass"
                  class="w-4 h-4"
                /></span>
                <span class="workflow-observatory-satellite workflow-observatory-satellite--two"><.icon
                  name="hero-code-bracket"
                  class="w-4 h-4"
                /></span>
                <span class="workflow-observatory-satellite workflow-observatory-satellite--three"><.icon
                  name="hero-check"
                  class="w-4 h-4"
                /></span>
              </div>
              <div class="workflow-empty-copy">
                <h3 class="text-base font-bold text-content">
                  {if @search_query != "" || @tag_filter != "all",
                    do: "No matching workflows",
                    else: "No workflows configured yet"}
                </h3>
                <p class="text-xs text-muted mt-2">
                  <%= if @search_query != "" || @tag_filter != "all" do %>
                    Try a different search or select another tag to find a pipeline.
                  <% else %>
                    Describe your objective to create a five-step pipeline, then inspect its architecture before launch.
                  <% end %>
                </p>
                <.link
                  id="workflows-empty-create"
                  navigate={IexCodeWeb.WorkflowsLive.workflows_new_path(@context_session)}
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-accent bg-accent text-accent-ink font-mono text-xs font-bold hover:bg-accent-strong shadow-[var(--ui-shadow-control)] transition-colors"
                >
                  <.icon name="hero-plus" class="w-4 h-4" />
                  <span>Create Workflow</span>
                </.link>
              </div>
            </div>
          <% end %>

          <%!-- Recent Runs Section --%>
          <%= if length(@active_runs) > 0 do %>
            <section id="workflows-recent-runs" class="workflow-recent-runs space-y-4">
              <div class="workflow-section-heading">
                <h3>Recent execution runs</h3>
                <span>Latest {length(@active_runs)}</span>
              </div>
              <div class="workflow-runs-table overflow-x-auto rounded-2xl border border-line bg-surface">
                <table class="w-full text-left text-xs font-mono">
                  <thead class="bg-raised text-muted border-b border-line">
                    <tr>
                      <th class="p-3.5">Run ID</th>
                      <th class="p-3.5">Workflow</th>
                      <th class="p-3.5">Status</th>
                      <th class="p-3.5">Progress</th>
                      <th class="p-3.5">Duration</th>
                      <th class="p-3.5 text-right">Action</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-line text-muted">
                    <%= for run <- @active_runs do %>
                      <tr
                        id={"workflow-run-row-#{run.id}"}
                        class="hover:bg-accent/5 transition-colors"
                      >
                        <td class="p-3.5 text-accent">
                          #{String.slice(to_string(run.id), 0, 8)}
                        </td>
                        <td class="p-3.5 font-bold text-content">
                          {if run.workflow, do: run.workflow.name, else: "Workflow"}
                        </td>
                        <td class="p-3.5">
                          <span class={[
                            "px-2 py-0.5 rounded text-[10px] font-bold uppercase",
                            status_badge_class(run.status)
                          ]}>
                            {run.status}
                          </span>
                        </td>
                        <td class="p-3.5">
                          <div class="flex items-center gap-2">
                            <div class="w-20 bg-raised rounded-full h-1.5 overflow-hidden">
                              <div
                                class="bg-accent h-1.5 rounded-full"
                                style={"width: #{run.progress}%"}
                              >
                              </div>
                            </div>
                            <span class="text-[10px] text-subtle tabular-nums">{run.progress}%</span>
                          </div>
                        </td>
                        <td class="p-3.5 text-muted tabular-nums">
                          {format_duration(run.duration_ms)}
                        </td>
                        <td class="p-3.5 text-right">
                          <.link
                            id={"workflow-run-open-#{run.id}"}
                            navigate={
                              IexCodeWeb.WorkflowsLive.workflow_run_path(
                                @context_session,
                                run.workflow_id,
                                run.id
                              )
                            }
                            class="px-2.5 py-1 rounded-lg bg-raised hover:bg-accent/10 text-accent text-xs font-semibold transition-colors"
                          >
                            Open Cockpit →
                          </.link>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </section>
          <% end %>
        </div>
      <% end %>

      <%!-- =================================================================== --%>
      <%!-- 2. WORKFLOW BUILDER / ASSISTANT (:new, :session_new)                 --%>
      <%!-- =================================================================== --%>
      <%= if @live_action in [:new, :session_new] do %>
        <div id="workflows-builder" class="space-y-6 max-w-6xl mx-auto">
          <.page_header
            id="workflows-builder-header"
            class="page-header--flush"
            title="Create workflow"
            heading_tag="h1"
            description="Describe a workflow or configure its steps below."
            icon="hero-rectangle-stack"
          />

          <%!-- Natural Language Synthesis Assistant --%>
          <div class="workflow-builder-layout">
            <section
              id="workflow-blueprint-assistant"
              class="workflow-blueprint-panel rounded-2xl border border-accent/30 bg-surface p-6 space-y-4"
            >
              <div class="workflow-panel-heading">
                <span class="workflow-section-icon"><.icon name="hero-sparkles" class="w-5 h-5" /></span>
                <div>
                  <h2>Start with an objective</h2>
                  <p>Autonomous Blueprint Synthesizer</p>
                </div>
              </div>

              <.form
                for={to_form(%{"prompt" => @blueprint_prompt})}
                id="blueprint-prompt-form"
                phx-submit="synthesize_blueprint"
                class="space-y-3"
              >
                <div class="relative">
                  <.input
                    type="textarea"
                    id="blueprint-prompt-input"
                    name="prompt"
                    label="What should this workflow accomplish?"
                    value={@blueprint_prompt}
                    rows="6"
                    placeholder="e.g. Build user authentication with bcrypt, rate limiting, live tests, security audits, and git commits..."
                    class="w-full p-3.5 rounded-xl bg-inset border border-line text-xs font-mono text-content placeholder:text-subtle focus:border-accent focus:ring-1 focus:ring-accent outline-none"
                  />
                </div>

                <div class="flex justify-end">
                  <button
                    type="submit"
                    id="btn-synthesize-blueprint"
                    phx-disable-with="Synthesizing pipeline…"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-accent bg-accent text-accent-ink font-mono text-xs font-bold hover:bg-accent-strong shadow-[var(--ui-shadow-control)] transition-colors"
                  >
                    <.icon name="hero-sparkles" class="w-4 h-4" />
                    <span>Synthesize 5-Step Pipeline</span>
                  </button>
                </div>
              </.form>
              <div class="workflow-blueprint-guide">
                <.icon name="hero-arrow-path-rounded-square" class="w-5 h-5" />
                <p>
                  The generated steps appear in the configuration. Review the sequence and dependencies before saving.
                </p>
              </div>
            </section>

            <%!-- Workflow Definition Form --%>
            <section
              id="workflow-configuration"
              class="workflow-config-panel rounded-2xl border border-line bg-surface p-6 space-y-6"
            >
              <div class="workflow-panel-heading">
                <span class="workflow-section-icon"><.icon
                  name="hero-adjustments-horizontal"
                  class="w-5 h-5"
                /></span>
                <div>
                  <h2>Workflow configuration</h2>
                  <p>Define the identity and review each step.</p>
                </div>
              </div>

              <.form
                for={@workflow_form}
                id="workflow-config-form"
                phx-change="validate_workflow"
                phx-submit="save_workflow"
                class="space-y-4"
              >
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <.input
                    field={@workflow_form[:name]}
                    label="Workflow Name"
                    placeholder="e.g. Feature Implementation Pipeline"
                    required
                  />
                  <.input
                    field={@workflow_form[:slug]}
                    label="URL Slug"
                    placeholder="e.g. feature-pipeline"
                  />
                </div>

                <.input
                  field={@workflow_form[:description]}
                  type="textarea"
                  label="Description"
                  placeholder="Explain what this workflow accomplishes..."
                  rows="2"
                />

                <div class="workflow-configured-steps pt-4 border-t border-line">
                  <div class="workflow-section-heading">
                    <h3>Configured DAG steps</h3>
                    <span>{length(@workflow_form[:steps].value || [])} steps</span>
                  </div>
                  <div class="workflow-step-sequence space-y-2">
                    <% steps = @workflow_form[:steps].value || [] %>
                    <%= if steps == [] do %>
                      <div id="workflow-steps-empty" class="workflow-steps-empty">
                        <.icon name="hero-square-3-stack-3d" class="w-6 h-6" />
                        <p>Your pipeline will appear here.</p>
                        <span>Synthesize an objective to populate its steps.</span>
                      </div>
                    <% end %>
                    <%= for {step, idx} <- Enum.with_index(steps) do %>
                      <div
                        id={"workflow-configured-step-#{idx}"}
                        class="workflow-configured-step p-3 rounded-xl bg-raised border border-line flex items-center justify-between text-xs font-mono"
                      >
                        <div class="workflow-step-label flex items-center gap-2">
                          <span class="workflow-step-number w-5 h-5 rounded-full bg-accent/15 text-accent flex items-center justify-center text-[10px] font-bold">
                            {idx + 1}
                          </span>
                          <div class="min-w-0">
                            <span class="text-content font-bold block">{Map.get(step, "title") ||
                              Map.get(step, :title)}</span>
                            <span class="text-subtle text-[10px]">{Map.get(step, "kind") ||
                              Map.get(step, :kind)}</span>
                          </div>
                        </div>
                        <span class="text-[10px] text-muted">
                          deps: {inspect(Map.get(step, "depends_on") || [])}
                        </span>
                      </div>
                    <% end %>
                  </div>
                </div>

                <div class="flex items-center justify-end gap-3 pt-6 border-t border-line">
                  <.link
                    navigate={IexCodeWeb.WorkflowsLive.workflows_index_path(@context_session)}
                    class="px-4 py-2 rounded-xl text-xs font-mono text-muted hover:text-content"
                  >
                    Cancel
                  </.link>

                  <button
                    type="submit"
                    id="btn-save-workflow"
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-accent bg-accent text-accent-ink font-mono text-xs font-bold hover:bg-accent-strong shadow-[var(--ui-shadow-control)] transition-colors"
                  >
                    <.icon name="hero-check" class="w-4 h-4" />
                    <span>Save Workflow</span>
                  </button>
                </div>
              </.form>
            </section>
          </div>
        </div>
      <% end %>

      <%!-- =================================================================== --%>
      <%!-- 3. WORKFLOW DETAILS (:show, :session_show)                           --%>
      <%!-- =================================================================== --%>
      <%= if @live_action in [:show, :session_show] && @workflow do %>
        <div id="workflows-details" class="space-y-6">
          <.page_header
            id="workflows-detail-header"
            class="page-header--flush"
            title={@workflow.name}
            heading_tag="h1"
            description={@workflow.description}
            icon="hero-rectangle-stack"
          >
            <:meta>
              <span class="text-xs text-subtle">Version {@workflow.version} · {@workflow.slug}</span>
            </:meta>
            <:actions>
              <button
                type="button"
                id="btn-launch-details"
                phx-click="launch_workflow"
                phx-value-id={@workflow.id}
                class="header-control header-control--primary"
              >
                <.icon name="hero-play" class="w-4 h-4" />
                <span>Launch Workflow</span>
              </button>
            </:actions>
          </.page_header>

          <%!-- Static Preview of DAG Canvas --%>
          <div class="workflow-detail-layout">
            <section class="workflow-map-panel space-y-3">
              <div class="workflow-section-heading">
                <h2>Directed graph architecture</h2>
                <span>{length(@workflow.steps || [])} steps</span>
              </div>
              <.workflow_canvas
                id="details-preview-canvas"
                workflow={@workflow}
                run={
                  %WorkflowRun{
                    status: "pending",
                    progress: 0,
                    resolved_steps: @workflow.steps,
                    step_states: %{}
                  }
                }
                zoom_level={0.9}
              />
            </section>
            <aside id="workflow-launch-checklist" class="workflow-launch-checklist">
              <div class="workflow-panel-heading">
                <span class="workflow-section-icon"><.icon
                  name="hero-list-bullet"
                  class="w-5 h-5"
                /></span>
                <div>
                  <h2>Pipeline overview</h2>
                  <p>Execution steps and launch inputs.</p>
                </div>
              </div>
              <ol class="workflow-detail-steps">
                <%= for {step, index} <- Enum.with_index(@workflow.steps || []) do %>
                  <li>
                    <span class="workflow-step-number">{index + 1}</span>
                    <div>
                      <strong>{Map.get(step, "title") || Map.get(step, :title)}</strong>
                      <span>{Map.get(step, "kind") || Map.get(step, :kind)}</span>
                    </div>
                  </li>
                <% end %>
              </ol>
              <div class="workflow-launch-inputs">
                <h3>Launch inputs <span>{length(@workflow.variables || [])}</span></h3>
                <%= if (@workflow.variables || []) == [] do %>
                  <p>This workflow needs no additional inputs.</p>
                <% else %>
                  <div class="workflow-variable-list">
                    <%= for variable <- @workflow.variables do %>
                      <span>{Map.get(variable, "name") || Map.get(variable, :name)}</span>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </aside>
          </div>
        </div>
      <% end %>

      <%!-- =================================================================== --%>
      <%!-- 4. REAL-TIME EXECUTION COCKPIT (:run, :session_run)                  --%>
      <%!-- =================================================================== --%>
      <%= if @live_action in [:run, :session_run] && @run && @workflow do %>
        <div id="workflows-cockpit" class="space-y-6">
          <%!-- Execution Toolbar --%>
          <.execution_toolbar
            run={@run}
            workflow={@workflow}
            on_pause="pause_run"
            on_resume="resume_run"
            on_cancel="cancel_run"
            on_launch="launch_workflow"
          />

          <%!-- Interactive SVG DAG Canvas --%>
          <section class="workflow-map-panel workflow-map-panel--live space-y-3">
            <div class="workflow-section-heading">
              <div>
                <h2>Execution map</h2>
                <p>Select a step to inspect its output, metrics, and artifacts.</p>
              </div>
              <span>{Enum.count(@run.step_states || %{}, fn {_key, state} ->
                Map.get(state, "status") == "completed"
              end)} / {length(@run.resolved_steps || @workflow.steps || [])} steps complete</span>
            </div>
            <div
              class="workflow-run-progress"
              role="progressbar"
              aria-label="Workflow completion"
              aria-valuenow={@run.progress}
              aria-valuemin="0"
              aria-valuemax="100"
            >
              <span style={"width: #{@run.progress}%"}></span>
            </div>
            <.workflow_canvas
              id="cockpit-canvas"
              workflow={@workflow}
              run={@run}
              selected_step_key={@selected_step_key}
              zoom_level={@zoom_level}
              pan_offset={@pan_offset}
              on_select_step="inspect_step"
              on_pan="canvas_pan"
              on_zoom="canvas_zoom"
            />
          </section>

          <%!-- Slide-over Live Step Inspector Drawer --%>
          <%= if @selected_step do %>
            <.step_inspector
              step={@selected_step}
              run={@run}
              active_tab={@inspector_tab}
              on_close="close_step_inspector"
              on_set_tab="set_inspector_tab"
              on_retry="retry_workflow_step"
            />
          <% end %>
        </div>
      <% end %>

      <%!-- =================================================================== --%>
      <%!-- 5. LAUNCH MODAL WITH VARIABLE PROMPTS                                --%>
      <%!-- =================================================================== --%>
      <%= if @show_launch_modal && @launching_workflow do %>
        <div
          id="launch-workflow-modal-backdrop"
          class="fixed inset-0 z-50 ui-scrim backdrop-blur-md flex items-center justify-center p-4"
        >
          <div
            id="launch-workflow-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="launch-workflow-title"
            class="ui-dialog w-full max-w-lg border border-line bg-surface p-6 space-y-5 text-content"
          >
            <div class="flex items-center justify-between border-b border-line pb-4">
              <div>
                <h3 id="launch-workflow-title" class="text-base font-bold text-content">
                  Launch {@launching_workflow.name}
                </h3>
                <p class="text-xs font-mono text-muted mt-0.5">Provide execution inputs</p>
              </div>
              <button
                type="button"
                id="btn-close-launch-modal"
                aria-label="Close launch dialog"
                phx-click="close_launch_modal"
                class="p-2 text-muted hover:text-content rounded-lg hover:bg-accent/10"
              >
                <.icon name="hero-x-mark" class="w-5 h-5" />
              </button>
            </div>

            <.form
              for={@launch_form}
              id="launch-workflow-form"
              phx-submit="submit_launch"
              class="space-y-4"
            >
              <% vars = @launching_workflow.variables || [] %>
              <%= for var <- vars do %>
                <% var_name = Map.get(var, "name") || Map.get(var, :name) %>
                <.input
                  field={@launch_form[to_string(var_name)]}
                  name={"inputs[#{var_name}]"}
                  label={var_name}
                  value={Map.get(var, "default") || Map.get(var, :default)}
                  required={Map.get(var, "required") == true}
                  placeholder={Map.get(var, "description") || "Enter #{var_name}..."}
                />
              <% end %>

              <div class="flex items-center justify-end gap-3 pt-4 border-t border-line">
                <button
                  type="button"
                  phx-click="close_launch_modal"
                  class="px-4 py-2 rounded-xl text-xs font-mono text-muted hover:text-content"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  id="btn-confirm-launch"
                  class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-accent bg-accent text-accent-ink font-mono text-xs font-bold hover:bg-accent-strong shadow-[var(--ui-shadow-control)] transition-colors"
                >
                  <.icon name="hero-play" class="w-4 h-4" />
                  <span>Start Execution</span>
                </button>
              </div>
            </.form>
          </div>
        </div>
      <% end %>
    </main>
  </div>
</Layouts.app>
